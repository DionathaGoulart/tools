#!/usr/bin/env python3
"""goodmon — monitor de sistema portátil para terminal."""

from __future__ import annotations

import argparse
import io
import json
import math
import os
import re
import signal
import socket
import sys
import time
from collections import deque
from contextlib import contextmanager, redirect_stdout
from dataclasses import dataclass
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from retro import Retro, TerminalParser, largura  # noqa: E402

MAX_TOP = 50
DISPLAY_TOP = 5
SLICE_COLORS = (36, 35, 33, 32, 34)
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f\x1b]")


def clean(value: object, limit: int = 40) -> str:
    text = CONTROL.sub("?", str(value or "N/D")).replace("\n", " ")
    return text[:limit]


def human(value: float | int | None) -> str:
    if value is None:
        return "N/D"
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    n = float(value)
    for unit in units:
        if abs(n) < 1024 or unit == units[-1]:
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return "N/D"


def pct(value: float | None) -> str:
    return "N/D" if value is None else f"{value:.1f}%"


def positive_float(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("use um número") from error
    if not math.isfinite(parsed) or parsed < 0.1:
        raise argparse.ArgumentTypeError("deve ser finito e >= 0.1")
    return parsed


def top_count(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("use um inteiro") from error
    if parsed < 0 or parsed > MAX_TOP:
        raise argparse.ArgumentTypeError(f"deve estar entre 0 e {MAX_TOP}")
    return parsed


def load_psutil() -> Any:
    try:
        import psutil

        return psutil
    except ImportError:
        return None


def maybe_reexec_venv() -> None:
    """Use the tool-local venv when it exists, without touching user Python."""
    if os.environ.get("GOODMON_VENV_REEXEC"):
        return
    folder = Path(__file__).resolve().parent / ".venv"
    candidate = folder / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    if not candidate.is_file():
        return
    try:
        if folder.resolve() == Path(sys.prefix).resolve():
            return
    except OSError:
        return
    env = os.environ.copy()
    env["GOODMON_VENV_REEXEC"] = "1"
    os.execve(
        str(candidate),
        [str(candidate), str(Path(__file__).resolve()), *sys.argv[1:]],
        env,
    )


@dataclass
class Monitor:
    psutil: Any
    disk: str
    previous_network: Any = None
    previous_time: float | None = None
    warmed: bool = False

    def warmup(self) -> None:
        self.psutil.cpu_percent(None)
        self.psutil.cpu_percent(None, percpu=True)
        self._network(time.monotonic())
        for process in self.psutil.process_iter():
            try:
                process.cpu_percent(None)
            except (self.psutil.Error, OSError):
                pass
        self.warmed = True

    def _network(self, now: float) -> dict[str, float | None]:
        try:
            current = self.psutil.net_io_counters()
        except (self.psutil.Error, OSError):
            return {"sent_per_sec": None, "recv_per_sec": None}
        if current is None:
            return {"sent_per_sec": None, "recv_per_sec": None}
        if self.previous_network is None or self.previous_time is None:
            result = {"sent_per_sec": 0.0, "recv_per_sec": 0.0}
        else:
            elapsed = max(now - self.previous_time, 0.001)
            result = {
                "sent_per_sec": max(
                    0, current.bytes_sent - self.previous_network.bytes_sent
                )
                / elapsed,
                "recv_per_sec": max(
                    0, current.bytes_recv - self.previous_network.bytes_recv
                )
                / elapsed,
            }
        self.previous_network, self.previous_time = current, now
        return result

    def _processes(self) -> list[dict[str, Any]]:
        rows = []
        for process in self.psutil.process_iter(["pid", "name", "memory_info"]):
            try:
                info = process.info
                if info.get("memory_info") is None:
                    continue
                rows.append(
                    {
                        "pid": info["pid"],
                        "name": clean(info.get("name")),
                        "cpu": float(process.cpu_percent(None)),
                        "rss": int(info["memory_info"].rss),
                    }
                )
            except (self.psutil.Error, OSError, KeyError, TypeError):
                continue
        return rows

    def snapshot(self) -> dict[str, Any]:
        now = time.monotonic()
        cpu = self.psutil.cpu_percent(None)
        cores = self.psutil.cpu_percent(None, percpu=True)
        memory = self.psutil.virtual_memory()
        try:
            swap = self.psutil.swap_memory()
        except (self.psutil.Error, OSError):
            swap = None
        try:
            disk = self.psutil.disk_usage(self.disk)
        except (self.psutil.Error, OSError):
            disk = None
        try:
            boot = self.psutil.boot_time()
        except (self.psutil.Error, OSError):
            boot = None
        return {
            "hostname": clean(socket.gethostname()),
            "cpu": {
                "percent": cpu,
                "cores": cores,
                "count": self.psutil.cpu_count() or 0,
            },
            "memory": {
                "total": memory.total,
                "available": memory.available,
                "used": memory.total - memory.available,
                "percent": memory.percent,
            },
            "swap": None
            if swap is None
            else {"total": swap.total, "used": swap.used, "percent": swap.percent},
            "disk": None
            if disk is None
            else {
                "path": self.disk,
                "total": disk.total,
                "used": disk.used,
                "free": disk.free,
                "percent": disk.percent,
            },
            "network": self._network(now),
            "uptime_seconds": None if boot is None else max(0, time.time() - boot),
            "processes": self._processes(),
        }


def root_disk() -> str:
    return Path.cwd().anchor or os.path.abspath(os.sep)


def selected_processes(
    data: dict[str, Any], top: int, order: str
) -> list[dict[str, Any]]:
    return sorted(
        data["processes"],
        key=lambda p: p["cpu"] if order == "cpu" else p["rss"],
        reverse=True,
    )[:top]


def sparkline(values: list[float], width: int) -> str:
    """Compact 0--100 history graph, readable with and without colour."""
    if width <= 0:
        return ""
    if not values:
        return " " * width
    values = values[-width:]
    prefix = " " * (width - len(values))
    glyphs = "▁▂▃▄▅▆▇█"
    return prefix + "".join(glyphs[min(7, max(0, round(value * 7 / 100)))] for value in values)


def area_graph(values: list[float], width: int, height: int = 4) -> list[str]:
    """Fixed 0--100 area plot; missing history stays blank."""
    if width <= 0 or height <= 0:
        return []
    values = values[-width:]
    values = [None] * (width - len(values)) + values
    rows = []
    for row in range(height):
        line = ""
        for value in values:
            if value is None:
                line += " "
                continue
            level = max(0, min(100, value)) * height / 100
            fill = max(0, min(1, level - (height - row - 1)))
            line += " ▁▂▃▄▅▆▇█"[math.ceil(fill * 8)] if fill else "·" if row == height - 1 else " "
        rows.append(line)
    return rows


def pie(processes: list[dict[str, Any]], order: str, colour: bool, width: int = 13, height: int = 6) -> list[str]:
    """Small terminal pie; slices are proportions within the five shown rows."""
    key = "cpu" if order == "cpu" else "rss"
    values = [max(0.0, float(process[key])) for process in processes]
    total = sum(values)
    cuts, running = [], 0.0
    for value in values:
        running += value / total if total else 0
        cuts.append(running)
    out = []
    for row in range(height):
        line = ""
        y = (row + 0.5 - height / 2) / (height / 2)
        for column in range(width):
            x = (column + 0.5 - width / 2) / (width / 2)
            if x * x + y * y > 1:
                line += " "
                continue
            if not total:
                line += "·"
                continue
            angle = (math.atan2(y, x) + math.pi) / (2 * math.pi)
            index = next((i for i, cut in enumerate(cuts) if angle < cut), len(cuts) - 1)
            line += f"\033[{SLICE_COLORS[index]}m█\033[0m" if colour else str(index + 1)
        out.append(line)
    return out


def _fit(text: str, width: int) -> str:
    """Clip terminal cells without splitting escape sequences or wide glyphs."""
    if width <= 0:
        return ""
    if largura(text) <= width:
        return text
    pieces = []
    used = 0
    for token in re.findall(r"\x1b\[[0-9;]*m|.", text):
        size = largura(token)
        if used + size > width - 1:
            break
        pieces.append(token)
        used += size
    return "".join(pieces) + "…" + ("\x1b[0m" if "\x1b[" in text else "")


def render(
    ui: Retro, data: dict[str, Any], top: int, order: str, history: dict[str, deque[float]], live: bool = False
) -> int:
    ui.atualizar_tamanho()
    footer = "Q sair" if live and sys.stdin.isatty() else "CTRL-C SAI" if live else ""
    if live and ui.rows < 20:
        ui.permitir_caixa = False
        ui.atualizar_tamanho()
    memory, cpu = data["memory"], data["cpu"]
    width = ui.cf if ui.caixa else max(1, ui.cols - (2 if ui.cols >= 3 else 0))
    reserve = (7 if footer else 5) if ui.caixa else 0
    limit = max(1, ui.rows - reserve - 1) if live else 100
    flat_footer = bool(footer and not ui.caixa and limit >= 10)
    body_limit = limit - int(flat_footer)
    large = width >= 60 and body_limit >= 14
    rows = []
    if large:
        panel_width = (width - 3) // 2
        cpu_graph = area_graph(list(history["cpu"]), panel_width - 6)
        ram_graph = area_graph(list(history["ram"]), panel_width - 6)
        cpu_title = f"CPU {pct(cpu['percent'])}"
        ram_title = _fit(f"RAM {pct(memory['percent'])}  {human(memory['used'])}/{human(memory['total'])}", panel_width)
        rows.append(f"{cpu_title:<{panel_width}}   {ram_title}")
        for index in range(4):
            axis = "100%" if index == 0 else "  0%" if index == 3 else "    "
            left = f"\033[36m{cpu_graph[index]}\033[0m" if ui.cor else cpu_graph[index]
            right = f"\033[35m{ram_graph[index]}\033[0m" if ui.cor else ram_graph[index]
            rows.append(f"{axis} │{left}   {axis} │{right}")
        rows.append("")
    else:
        compact_width = max(1, width - 11)
        rows += [
            f"CPU {pct(cpu['percent']):>6} {sparkline(list(history['cpu']), compact_width)}",
            f"RAM {pct(memory['percent']):>6} {sparkline(list(history['ram']), compact_width)}",
        ]
    processes = selected_processes(data, min(DISPLAY_TOP, top), order)
    metric = "CPU" if order == "cpu" else "RAM"
    control_index = len(rows)
    prefix = f"TOP {min(DISPLAY_TOP, top)} · {metric}  "
    ram_label, cpu_label = "[M RAM]", "[C CPU]"
    ram_button = f"{ui.INV if order == 'ram' else ui.ACC30}{ram_label}{ui.RESET}"
    cpu_button = f"{ui.INV if order == 'cpu' else ui.ACC30}{cpu_label}{ui.RESET}"
    ui.button_bounds = {}
    if top:
        caption = f"  · fatias do top {min(DISPLAY_TOP, top)}" if width >= 60 else ""
        rows.append(f"{prefix}{ram_button} {cpu_button}{caption}")
    if top and width >= 34:
        chart_width, chart_height = (15, 7) if large else (11, 5)
        chart = pie(processes, order, ui.cor, chart_width, chart_height)
        labels = []
        values = [pct(process["cpu"]) if order == "cpu" else human(process["rss"]) for process in processes]
        value_width = max((len(value) for value in values), default=0)
        name_width = max(1, width - chart_width - value_width - 5)
        for index, (process, value) in enumerate(zip(processes, values)):
            swatch = f"\033[{SLICE_COLORS[index]}m■\033[0m" if ui.cor else str(index + 1)
            name = _fit(clean(process["name"]), name_width)
            labels.append(f"{swatch} {name}{' ' * (name_width - largura(name))} {value:>{value_width}}")
        if not processes:
            labels = ["Nenhum processo disponível"]
        elif not any(process["cpu" if order == "cpu" else "rss"] > 0 for process in processes) and large:
            labels.append("Sem uso nesta amostra")
        count = max(len(chart), len(labels))
        chart += [" " * chart_width] * (count - len(chart))
        labels += [""] * (count - len(labels))
        rows += [f"{chart[i]}  {labels[i]}" for i in range(count)]
    elif top and processes:
        rows += [
            f"{index + 1}. {clean(process['name'], max(8, width - 16))} "
            + (f"{process['cpu']:.1f}%" if order == "cpu" else human(process["rss"]))
            for index, process in enumerate(processes)
        ]
    elif top:
        rows.append("Nenhum processo disponível")
    if live:
        if ui.rows < 5:
            rows = [f"CPU {pct(cpu['percent'])} RAM {pct(memory['percent'])}"]
        rows = rows[:body_limit]
    # Mouse coordinates follow the visible body, including the frame/prefix.
    if top and control_index < len(rows) and ui.rows >= 5:
        body_x = 3 if ui.cols >= 3 else 1
        body_y = control_index + (4 if ui.caixa else 1)
        offset = largura(prefix)
        for key, label in (("ram", ram_label), ("cpu", cpu_label)):
            if offset + len(label) <= width:
                ui.button_bounds[key] = (body_x + offset, body_x + offset + len(label) - 1, body_y)
            offset += len(label) + 1
    if flat_footer:
        rows.append(footer)
    if ui.tty:
        rows = [_fit(row, width) for row in rows]
    ui.janela(
        "goodmon", rows, _fit(clean(data["hostname"]), max(1, ui.cf - 16)), footer
    )
    return len(rows) + reserve


def parser() -> argparse.ArgumentParser:
    p = TerminalParser(
        prog="goodmon", description="Monitor de CPU, RAM, disco, rede e processos."
    )
    p.add_argument("--once", action="store_true", help="mostra uma amostra e sai")
    p.add_argument("--json", action="store_true", help="emite uma amostra JSON e sai")
    p.add_argument(
        "--interval",
        type=positive_float,
        default=1.0,
        help="segundos entre amostras (>= 0.1)",
    )
    p.add_argument(
        "--sort", choices=("cpu", "ram"), default="ram", help="ordem dos processos"
    )
    p.add_argument(
        "--top", type=top_count, default=5, help=f"máximo de processos (0-{MAX_TOP})"
    )
    p.add_argument("--disk", default=root_disk(), help="caminho do disco a medir")
    p.add_argument("--no-color", action="store_true", help="desativa cores")
    return p


def help_text() -> str:
    return """Sem opção, atualiza no terminal. Em pipe, mostra uma amostra. Use Ctrl-C para sair.
Dependência: psutil (`python -m pip install -r goodmon/requirements.txt`).
Temas: GOODMON_TEMA=<tema> ou RETRO_TEMA=<tema>; `goodmon temas`.
"""


def wait_key(seconds: float, size: tuple[int, int] | None = None) -> str | None:
    """Wait for one terminal key, without changing terminal mode."""
    if size is not None:
        until = time.monotonic() + seconds
        while time.monotonic() < until:
            key = wait_key(min(0.1, max(0, until - time.monotonic())))
            if key:
                return key
            try:
                if tuple(os.get_terminal_size(sys.stdout.fileno())) != size:
                    return None
            except (AttributeError, OSError, ValueError):
                pass
        return None
    if not sys.stdin.isatty():
        time.sleep(seconds)
        return None
    if os.name == "nt":
        import msvcrt

        until = time.monotonic() + seconds
        while time.monotonic() < until:
            if msvcrt.kbhit():
                return msvcrt.getwch().lower()
            time.sleep(min(0.05, max(0, until - time.monotonic())))
        return None
    try:
        import select

        ready, _, _ = select.select([sys.stdin], [], [], seconds)
        if not ready:
            return None
        key = os.read(sys.stdin.fileno(), 1).decode("ascii", errors="ignore").lower()
        if key != "\x1b":
            return key
        # XTerm SGR mouse press: ESC [ < button ; column ; row M.
        sequence = key
        until = time.monotonic() + 0.03
        while time.monotonic() < until and len(sequence) < 64:
            ready, _, _ = select.select([sys.stdin], [], [], max(0, until - time.monotonic()))
            if not ready:
                break
            sequence += os.read(sys.stdin.fileno(), 1).decode("ascii", errors="ignore")
            if len(sequence) > 2 and "@" <= sequence[-1:] <= "~":
                match = re.fullmatch(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])", sequence)
                if match and match.group(4) == "M" and int(match.group(1)) == 0:
                    return f"mouse:{match.group(2)}:{match.group(3)}"
                break
        return None
    except (OSError, ValueError):
        time.sleep(seconds)
        return None


@contextmanager
def terminal_session(enabled: bool):
    """Restore cursor, POSIX input mode and signal handlers on every exit."""
    saved = None
    handlers = {}
    try:
        if enabled:
            if os.name != "nt" and sys.stdin.isatty():
                import termios
                import tty

                fd = sys.stdin.fileno()
                saved = (fd, termios.tcgetattr(fd))
                tty.setcbreak(fd)

            def stop(signum, _frame):
                raise SystemExit(128 + signum)

            for name in ("SIGTERM", "SIGHUP"):
                sig = getattr(signal, name, None)
                if sig is not None:
                    handlers[sig] = signal.signal(sig, stop)
            print("\033[?1049h\033[?25l", end="", flush=True)
            if os.name != "nt" and sys.stdin.isatty():
                print("\033[?1000h\033[?1006h", end="", flush=True)
        yield
    finally:
        try:
            if saved is not None:
                import termios

                termios.tcsetattr(saved[0], termios.TCSADRAIN, saved[1])
        finally:
            for sig, previous in handlers.items():
                signal.signal(sig, previous)
            if enabled:
                print("\033[?1000l\033[?1006l\033[0m\033[?25h\033[?1049l", end="", flush=True)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("help", "-h", "--help"):
        parser().print_help()
        Retro(env_prefix="GOODMON").texto(help_text())
        return 0
    if argv and argv[0] in ("temas", "themes"):
        if "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb":
            os.environ["NO_COLOR"] = "1"
        Retro(env_prefix="GOODMON").catalogo_temas()
        return 0
    args = parser().parse_args(argv)
    plain = (
        args.no_color or "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb"
    )
    if plain:
        os.environ["NO_COLOR"] = "1"
    psutil = load_psutil()
    if psutil is None:
        try:
            maybe_reexec_venv()
        except OSError as error:
            print(
                f"goodmon: não foi possível iniciar o ambiente Python: {error}",
                file=sys.stderr,
            )
            return 2
        psutil = load_psutil()
    if psutil is None:
        print(
            f"goodmon: falta psutil. Instalação: {Path(__file__).resolve().parent / 'README.md'}",
            file=sys.stderr,
        )
        return 2
    monitor = Monitor(psutil, args.disk)
    live = (
        not (args.once or args.json or plain or os.environ.get("GOODMON_SEM_ANIM"))
        and sys.stdout.isatty()
    )
    history: dict[str, deque[float]] = {"cpu": deque(maxlen=48), "ram": deque(maxlen=48)}
    data: dict[str, Any] | None = None
    next_sample = 0.0
    try:
        with terminal_session(live):
            monitor.warmup()
            time.sleep(args.interval if not live else 0.1)
            while True:
                if data is None or time.monotonic() >= next_sample:
                    data = monitor.snapshot()
                    history["cpu"].append(float(data["cpu"]["percent"]))
                    history["ram"].append(float(data["memory"]["percent"]))
                    next_sample = time.monotonic() + args.interval
                if args.json:
                    data["processes"] = selected_processes(data, args.top, args.sort)
                    print(json.dumps(data, ensure_ascii=False))
                    return 0
                ui = Retro(env_prefix="GOODMON", largura_caixa=100)
                if plain:
                    ui.permitir_caixa = False
                    ui.atualizar_tamanho()
                captured = io.StringIO()
                with redirect_stdout(captured):
                    render(ui, data, args.top, args.sort, history, live)
                frame = captured.getvalue().splitlines()
                if live:
                    # A fixed origin keeps click targets correct after resizes.
                    print("\033[H", end="")
                    for line in frame:
                        print(f"\r\033[K{line}")
                    print("\033[J", end="")
                else:
                    print(captured.getvalue(), end="")
                sys.stdout.flush()
                if not live:
                    return 0
                key = wait_key(max(0, next_sample - time.monotonic()), (ui.cols, ui.rows))
                if key == "q":
                    return 0
                if key == "c":
                    args.sort = "cpu"
                if key == "m":
                    args.sort = "ram"
                if key and key.startswith("mouse:"):
                    _, column, row = key.split(":")
                    column, row = int(column), int(row)
                    for metric, (left, right, button_row) in getattr(ui, "button_bounds", {}).items():
                        if row == button_row and left <= column <= right:
                            args.sort = metric
                            break
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
