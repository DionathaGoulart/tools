#!/usr/bin/env python3
"""goodmon — monitor de sistema portátil para terminal."""

from __future__ import annotations

import argparse
import io
import json
import math
import os
import re
import signal
import socket
import sys
import time
from contextlib import contextmanager, redirect_stdout
from dataclasses import dataclass
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
from retro import Retro, TerminalParser, largura  # noqa: E402

MAX_TOP = 50
CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f\x1b]")


def clean(value: object, limit: int = 40) -> str:
    text = CONTROL.sub("?", str(value or "N/D")).replace("\n", " ")
    return text[:limit]


def human(value: float | int | None) -> str:
    if value is None:
        return "N/D"
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    n = float(value)
    for unit in units:
        if abs(n) < 1024 or unit == units[-1]:
            return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
        n /= 1024
    return "N/D"


def pct(value: float | None) -> str:
    return "N/D" if value is None else f"{value:.1f}%"


def positive_float(value: str) -> float:
    try:
        parsed = float(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("use um número") from error
    if not math.isfinite(parsed) or parsed < 0.1:
        raise argparse.ArgumentTypeError("deve ser finito e >= 0.1")
    return parsed


def top_count(value: str) -> int:
    try:
        parsed = int(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("use um inteiro") from error
    if parsed < 0 or parsed > MAX_TOP:
        raise argparse.ArgumentTypeError(f"deve estar entre 0 e {MAX_TOP}")
    return parsed


def load_psutil() -> Any:
    try:
        import psutil

        return psutil
    except ImportError:
        return None


def maybe_reexec_venv() -> None:
    """Use the tool-local venv when it exists, without touching user Python."""
    if os.environ.get("GOODMON_VENV_REEXEC"):
        return
    folder = Path(__file__).resolve().parent / ".venv"
    candidate = folder / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    if not candidate.is_file():
        return
    try:
        if folder.resolve() == Path(sys.prefix).resolve():
            return
    except OSError:
        return
    env = os.environ.copy()
    env["GOODMON_VENV_REEXEC"] = "1"
    os.execve(
        str(candidate),
        [str(candidate), str(Path(__file__).resolve()), *sys.argv[1:]],
        env,
    )


@dataclass
class Monitor:
    psutil: Any
    disk: str
    previous_network: Any = None
    previous_time: float | None = None
    warmed: bool = False

    def warmup(self) -> None:
        self.psutil.cpu_percent(None)
        self.psutil.cpu_percent(None, percpu=True)
        self._network(time.monotonic())
        for process in self.psutil.process_iter():
            try:
                process.cpu_percent(None)
            except (self.psutil.Error, OSError):
                pass
        self.warmed = True

    def _network(self, now: float) -> dict[str, float | None]:
        try:
            current = self.psutil.net_io_counters()
        except (self.psutil.Error, OSError):
            return {"sent_per_sec": None, "recv_per_sec": None}
        if current is None:
            return {"sent_per_sec": None, "recv_per_sec": None}
        if self.previous_network is None or self.previous_time is None:
            result = {"sent_per_sec": 0.0, "recv_per_sec": 0.0}
        else:
            elapsed = max(now - self.previous_time, 0.001)
            result = {
                "sent_per_sec": max(
                    0, current.bytes_sent - self.previous_network.bytes_sent
                )
                / elapsed,
                "recv_per_sec": max(
                    0, current.bytes_recv - self.previous_network.bytes_recv
                )
                / elapsed,
            }
        self.previous_network, self.previous_time = current, now
        return result

    def _processes(self) -> list[dict[str, Any]]:
        rows = []
        for process in self.psutil.process_iter(["pid", "name", "memory_info"]):
            try:
                info = process.info
                if info.get("memory_info") is None:
                    continue
                rows.append(
                    {
                        "pid": info["pid"],
                        "name": clean(info.get("name")),
                        "cpu": float(process.cpu_percent(None)),
                        "rss": int(info["memory_info"].rss),
                    }
                )
            except (self.psutil.Error, OSError, KeyError, TypeError):
                continue
        return rows

    def snapshot(self) -> dict[str, Any]:
        now = time.monotonic()
        cpu = self.psutil.cpu_percent(None)
        cores = self.psutil.cpu_percent(None, percpu=True)
        memory = self.psutil.virtual_memory()
        try:
            swap = self.psutil.swap_memory()
        except (self.psutil.Error, OSError):
            swap = None
        try:
            disk = self.psutil.disk_usage(self.disk)
        except (self.psutil.Error, OSError):
            disk = None
        try:
            boot = self.psutil.boot_time()
        except (self.psutil.Error, OSError):
            boot = None
        return {
            "hostname": clean(socket.gethostname()),
            "cpu": {
                "percent": cpu,
                "cores": cores,
                "count": self.psutil.cpu_count() or 0,
            },
            "memory": {
                "total": memory.total,
                "available": memory.available,
                "used": memory.total - memory.available,
                "percent": memory.percent,
            },
            "swap": None
            if swap is None
            else {"total": swap.total, "used": swap.used, "percent": swap.percent},
            "disk": None
            if disk is None
            else {
                "path": self.disk,
                "total": disk.total,
                "used": disk.used,
                "free": disk.free,
                "percent": disk.percent,
            },
            "network": self._network(now),
            "uptime_seconds": None if boot is None else max(0, time.time() - boot),
            "processes": self._processes(),
        }


def root_disk() -> str:
    return Path.cwd().anchor or os.path.abspath(os.sep)


def selected_processes(
    data: dict[str, Any], top: int, order: str
) -> list[dict[str, Any]]:
    return sorted(
        data["processes"],
        key=lambda p: p["cpu"] if order == "cpu" else p["rss"],
        reverse=True,
    )[:top]


def _fit(text: str, width: int) -> str:
    """Clip terminal cells without splitting escape sequences or wide glyphs."""
    if width <= 0:
        return ""
    if largura(text) <= width:
        return text
    pieces = []
    used = 0
    for token in re.findall(r"\x1b\[[0-9;]*m|.", text):
        size = largura(token)
        if used + size > width - 1:
            break
        pieces.append(token)
        used += size
    return "".join(pieces) + "…" + ("\x1b[0m" if "\x1b[" in text else "")


def render(
    ui: Retro, data: dict[str, Any], top: int, order: str, live: bool = False
) -> int:
    ui.atualizar_tamanho()
    footer = "Q SAIR · C CPU · M RAM" if live and sys.stdin.isatty() else "CTRL-C SAI" if live else ""
    if live and ui.rows < 13:
        ui.permitir_caixa = False
        ui.atualizar_tamanho()
    memory, cpu, disk, network = (
        data["memory"],
        data["cpu"],
        data["disk"],
        data["network"],
    )
    width = ui.cf if ui.caixa else max(1, ui.cols - (2 if ui.cols >= 3 else 0))
    bar_width = max(4, min(16, width - 43))
    rows = ["[ MODULE: SYSTEM_MONITOR ]"]
    if width >= 56:
        rows += [
            f"CPU {ui.barra(round(cpu['percent']), 100, bar_width)}  {cpu['count']} CPUs",
            f"RAM {ui.barra(round(memory['percent']), 100, bar_width)}  {human(memory['used'])}/{human(memory['total'])}",
        ]
    else:
        rows += [
            f"CPU {pct(cpu['percent'])}  ({cpu['count']} CPUs)",
            f"RAM {pct(memory['percent'])}  {human(memory['used'])}/{human(memory['total'])}",
        ]
    if data["swap"]:
        rows.append(
            f"SWAP {human(data['swap']['used'])}/{human(data['swap']['total'])}  {pct(data['swap']['percent'])}"
        )
    else:
        rows.append("SWAP N/D")
    if disk:
        rows.append(
            f"DISCO {pct(disk['percent'])} {human(disk['used'])}/{human(disk['total'])} {clean(disk['path'])}"
        )
    else:
        rows.append("DISCO N/D")
    rows.append(
        f"REDE ↓ {human(network['recv_per_sec'])}/s  ↑ {human(network['sent_per_sec'])}/s"
    )
    if data["uptime_seconds"] is not None:
        rows.append(
            f"UPTIME {int(data['uptime_seconds'] // 3600)}h {int(data['uptime_seconds'] % 3600 // 60)}m"
        )
    else:
        rows.append("UPTIME N/D")
    rows.append("NÚCLEOS " + (" ".join(f"{x:.0f}%" for x in cpu["cores"]) or "N/D"))
    processes = selected_processes(data, top, order)
    if top:
        rows.append(f"TOP PROCESSOS · {order.upper()} · CPU pode superar 100%")
        rows.append(f"{'PID':>6} {'CPU':>7} {'RAM':>10} NOME")
    rows += [
        f"{p['pid']:>6} {p['cpu']:6.1f}% {human(p['rss']):>10} {clean(p['name'])}"
        for p in processes
    ]
    height = ui.rows
    reserve = (7 if footer else 5) if ui.caixa else 0
    if live:
        if height < 5:
            rows = [f"CPU {pct(cpu['percent'])} RAM {pct(memory['percent'])}"]
        elif not ui.caixa:
            rows = rows[1:]
        rows = rows[: max(1, height - reserve - 1)]
    if ui.tty:
        rows = [_fit(row, width) for row in rows]
    ui.janela(
        "goodmon", rows, _fit(clean(data["hostname"]), max(1, ui.cf - 16)), footer
    )
    return len(rows) + reserve


def parser() -> argparse.ArgumentParser:
    p = TerminalParser(
        prog="goodmon", description="Monitor de CPU, RAM, disco, rede e processos."
    )
    p.add_argument("--once", action="store_true", help="mostra uma amostra e sai")
    p.add_argument("--json", action="store_true", help="emite uma amostra JSON e sai")
    p.add_argument(
        "--interval",
        type=positive_float,
        default=1.0,
        help="segundos entre amostras (>= 0.1)",
    )
    p.add_argument(
        "--sort", choices=("cpu", "ram"), default="cpu", help="ordem dos processos"
    )
    p.add_argument(
        "--top", type=top_count, default=8, help=f"máximo de processos (0-{MAX_TOP})"
    )
    p.add_argument("--disk", default=root_disk(), help="caminho do disco a medir")
    p.add_argument("--no-color", action="store_true", help="desativa cores")
    return p


def help_text() -> str:
    return """Sem opção, atualiza no terminal. Em pipe, mostra uma amostra. Use Ctrl-C para sair.
Dependência: psutil (`python -m pip install -r goodmon/requirements.txt`).
Temas: GOODMON_TEMA=<tema> ou RETRO_TEMA=<tema>; `goodmon temas`.
"""


def wait_key(seconds: float, size: tuple[int, int] | None = None) -> str | None:
    """Wait for one terminal key, without changing terminal mode."""
    if size is not None:
        until = time.monotonic() + seconds
        while time.monotonic() < until:
            key = wait_key(min(0.1, max(0, until - time.monotonic())))
            if key:
                return key
            try:
                if tuple(os.get_terminal_size(sys.stdout.fileno())) != size:
                    return None
            except (AttributeError, OSError, ValueError):
                pass
        return None
    if not sys.stdin.isatty():
        time.sleep(seconds)
        return None
    if os.name == "nt":
        import msvcrt

        until = time.monotonic() + seconds
        while time.monotonic() < until:
            if msvcrt.kbhit():
                return msvcrt.getwch().lower()
            time.sleep(min(0.05, max(0, until - time.monotonic())))
        return None
    try:
        import select

        ready, _, _ = select.select([sys.stdin], [], [], seconds)
        return (
            os.read(sys.stdin.fileno(), 1).decode("ascii", errors="ignore").lower()
            if ready
            else None
        )
    except (OSError, ValueError):
        time.sleep(seconds)
        return None


@contextmanager
def terminal_session(enabled: bool):
    """Restore cursor, POSIX input mode and signal handlers on every exit."""
    saved = None
    handlers = {}
    try:
        if enabled:
            if os.name != "nt" and sys.stdin.isatty():
                import termios
                import tty

                fd = sys.stdin.fileno()
                saved = (fd, termios.tcgetattr(fd))
                tty.setcbreak(fd)

            def stop(signum, _frame):
                raise SystemExit(128 + signum)

            for name in ("SIGTERM", "SIGHUP"):
                sig = getattr(signal, name, None)
                if sig is not None:
                    handlers[sig] = signal.signal(sig, stop)
            print("\033[?25l", end="", flush=True)
        yield
    finally:
        if saved is not None:
            import termios

            termios.tcsetattr(saved[0], termios.TCSADRAIN, saved[1])
        for sig, previous in handlers.items():
            signal.signal(sig, previous)
        if enabled:
            print("\033[0m\033[?25h", end="", flush=True)


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in ("help", "-h", "--help"):
        parser().print_help()
        Retro(env_prefix="GOODMON").texto(help_text())
        return 0
    if argv and argv[0] in ("temas", "themes"):
        if "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb":
            os.environ["NO_COLOR"] = "1"
        Retro(env_prefix="GOODMON").catalogo_temas()
        return 0
    args = parser().parse_args(argv)
    plain = (
        args.no_color or "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb"
    )
    if plain:
        os.environ["NO_COLOR"] = "1"
    psutil = load_psutil()
    if psutil is None:
        try:
            maybe_reexec_venv()
        except OSError as error:
            print(
                f"goodmon: não foi possível iniciar o ambiente Python: {error}",
                file=sys.stderr,
            )
            return 2
        psutil = load_psutil()
    if psutil is None:
        print(
            f"goodmon: falta psutil. Instalação: {Path(__file__).resolve().parent / 'README.md'}",
            file=sys.stderr,
        )
        return 2
    monitor = Monitor(psutil, args.disk)
    live = (
        not (args.once or args.json or plain or os.environ.get("GOODMON_SEM_ANIM"))
        and sys.stdout.isatty()
    )
    lines = 0
    try:
        with terminal_session(live):
            monitor.warmup()
            time.sleep(args.interval if not live else 0.1)
            while True:
                data = monitor.snapshot()
                if args.json:
                    data["processes"] = selected_processes(data, args.top, args.sort)
                    print(json.dumps(data, ensure_ascii=False))
                    return 0
                ui = Retro(env_prefix="GOODMON", largura_caixa=100)
                if plain:
                    ui.permitir_caixa = False
                    ui.atualizar_tamanho()
                captured = io.StringIO()
                with redirect_stdout(captured):
                    render(ui, data, args.top, args.sort, live)
                frame = captured.getvalue().splitlines()
                if live:
                    height = ui.rows
                    if lines:
                        print(f"\033[{min(lines, max(1, height - 1))}A", end="")
                    for line in frame:
                        print(f"\r\033[K{line}")
                    # Clear trailing rows when the process list shrinks.
                    extra = min(
                        max(0, lines - len(frame)), max(0, height - len(frame) - 1)
                    )
                    for _ in range(extra):
                        print("\r\033[K")
                    if extra:
                        print(f"\033[{extra}A", end="")
                    lines = len(frame)
                else:
                    print(captured.getvalue(), end="")
                sys.stdout.flush()
                if not live:
                    return 0
                key = wait_key(args.interval, (ui.cols, ui.rows))
                if key == "q":
                    return 0
                if key == "c":
                    args.sort = "cpu"
                if key == "m":
                    args.sort = "ram"
    except KeyboardInterrupt:
        return 130
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
