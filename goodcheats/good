#!/usr/bin/env bash
# good — system info at a glance, with the good logo (macOS / Linux)
#
# usage: good            show logo + system info
#        good temas      list the available retro palettes
#        good --refresh  rebuild the hardware cache (model, GPU, resolution)
#        good <sub> …    run a family command (good cheat → goodcheat, good harness → goodharness)
#        good -h | --help

set -u

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/good"
CACHE_FILE="$CACHE_DIR/hardware"

# family dispatcher: `good <sub> …` roda o irmão `good<sub>` se ele existir
# ex: `good harness list` → goodharness list · `good cheat tar` → goodcheat tar
if [ "$#" -gt 0 ]; then
  case "$1" in
    -*) ;;
    *)
      SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
      if [ -x "$SELF_DIR/good$1" ]; then
        SUB="$SELF_DIR/good$1"
        shift
        exec "$SUB" "$@"
      fi
      ;;
  esac
fi

# ---------- tema retro (lib compartilhada) ----------
TEMA="${GOOD_TEMA:-${RETRO_TEMA:-vault-gold}}"
RETRO_LIB="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/../lib" 2>/dev/null && pwd)/retro.sh"
if [ -f "$RETRO_LIB" ]; then
  . "$RETRO_LIB"
  retro_init 52
else
  # degradação: sem a lib, tudo sai em texto puro
  RESET="" BOLD="" DIM="" ACC="" ACC70="" ACC50="" ACC30="" ACC15=""
  FG="" FG70="" FG40="" INV="" OK="" ALERTA=""
  TRUECOLOR=0 USE_COLOR=0 DESENHA=0 COLS=80 HEX_ACC="fbee23"
  [ -t 1 ] && DESENHA=1
  retro_upper()   { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }
  retro_repetir() { local n=$2 s=""; while [ "$n" -gt 0 ]; do s="$s$1"; n=$((n - 1)); done; printf '%s' "$s"; }
  retro_modulo()  { printf '\n  [ MODULE: %s ]%s\n\n' "$(retro_upper "$1")" "${2:+  $(retro_upper "$2")}"; }
  retro_secao()   { printf '  # %s\n' "$(retro_upper "$1")"; }
  retro_kv()      { printf '  %-26s %s\n' "$1" "$2"; }
  retro_ok()      { printf '  [ OK ] %s\n' "$(retro_upper "$1")"; }
  retro_erro()    { printf '  [ ERRO ] %s\n' "$1"; }
  retro_aviso()   { printf '  [ %s ] %s\n' "$(retro_upper "$1")" "${2:-}"; }
  retro_proximo() { printf '  > %s  %s\n' "${2:-proximo passo:}" "$1"; }
  retro_catalogo_temas() { printf '\n  [ MODULE: THEME_CATALOG ]\n\n  lib/retro.sh nao encontrada.\n\n'; }
fi

uso() {
  retro_modulo "good_help"
  retro_kv "good" "LOGO + INFOS"
  retro_kv "good <sub> …" "COMANDO DA FAMILIA"
  retro_kv "good temas" "PALETAS"
  retro_kv "good --refresh" "REFAZ CACHE DE HARDWARE"
  retro_kv "good -c HEX[,HEX]" "COR DO LOGO"
  echo
  retro_secao "familia"
  retro_kv "good cheat <topico>" "GOODCHEAT"
  retro_kv "good harness list" "GOODHARNESS"
  echo
  retro_secao "env"
  retro_kv "GOOD_COLOR" "HEX OU HEX,HEX (GRADIENTE)"
  retro_kv "GOOD_TEMA" "$(retro_upper "$TEMA")"
  retro_kv "NO_COLOR" "DESLIGA AS CORES"
  echo
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) uso; exit 0 ;;
    temas|tema) retro_catalogo_temas GOOD_TEMA; exit 0 ;;
    --refresh) rm -f "$CACHE_FILE" ;;
    -c|--color)
      [ "$#" -ge 2 ] || { retro_erro "$1 requer um valor hex (ex: -c fbee23)" >&2; exit 2; }
      GOOD_COLOR="$2"
      shift
      ;;
    --color=*) GOOD_COLOR="${1#*=}" ;;
    *)
      retro_erro "opcao desconhecida '$1' (veja good -h)" >&2
      exit 2
      ;;
  esac
  shift
done

# ---------- cores do logo ----------
# tokens (ACC, FG40, …) vêm da lib; aqui só a cor do logo, que tem flag própria.
USE_TRUECOLOR="${TRUECOLOR:-0}"

# padrão: o accent do tema atual — override com GOOD_COLOR=rrggbb (sólido)
# ou rrggbb,rrggbb (gradiente), ou -c/--color
HEX_ACC="${HEX_ACC:-fbee23}"
R1=$((16#${HEX_ACC:0:2})); G1=$((16#${HEX_ACC:2:2})); B1=$((16#${HEX_ACC:4:2}))
R2=$R1; G2=$G1; B2=$B1

parse_hex() { # rrggbb -> PR PG PB; returns 1 if invalid
  case "$1" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
      PR=$((16#${1:0:2})); PG=$((16#${1:2:2})); PB=$((16#${1:4:2}))
      return 0
      ;;
  esac
  return 1
}

rgb256() { # r g b -> nearest xterm-256 color-cube index
  echo $((16 + 36 * (($1 * 5 + 127) / 255) + 6 * (($2 * 5 + 127) / 255) + (($3 * 5 + 127) / 255)))
}

if [ -n "${GOOD_COLOR:-}" ]; then
  c1="${GOOD_COLOR%%,*}"; c1="${c1#\#}"
  c2="${GOOD_COLOR#*,}";  c2="${c2#\#}"
  if parse_hex "$c1"; then
    R1=$PR; G1=$PG; B1=$PB
    if [ "$c2" != "$c1" ] && parse_hex "$c2"; then
      R2=$PR; G2=$PG; B2=$PB
    else
      [ "$c2" != "$c1" ] && retro_erro "segunda cor invalida ('$c2') — usando cor solida" >&2
      R2=$R1; G2=$G1; B2=$B1
    fi
  else
    retro_erro "cor invalida ('$GOOD_COLOR') — use 6 digitos hex, ex: fbee23 ou fbee23,ff5500" >&2
  fi
fi

# ---------- logo (each line exactly 36 chars) ----------
LOGO=(
'      ▄████████      ████████▄      '
'      █████████      █████████      '
'      █████████      █████████      '
'▄▄▄▄▄▄████████████████████████▄▄▄▄▄▄'
'████████▀  ▀████████████▀  ▀████████'
'████████    ████████████    ████████'
'████████    ████████████    ████████'
'▀██████████████████████████████████▀'
'      ████████████████████████      '
'      █████████▀▀▀▀▀▀█████████      '
'  ▄▄▄▄█████████▄▄▄▄▄▄█████████▄▄▄▄  '
'█████████▀▀▀▀██████████▀▀▀▀█████████'
'████████      ████████      ████████'
'████████      ████████      ████████'
'████████      ▀███████      ████████'
)
LOGO_W=36
GAP='   '

# ---------- helpers ----------
# as linhas viram key-value rows do style guide (chave dim, dot leader, valor accent-bold).
# a coleta é em duas etapas: primeiro chave/valor, depois a renderização com o leader medido.
KEYS=()
VALS=()
INFO=()      # linhas já coloridas
INFO_W=()    # largura visível de cada linha (pra medir o layout lado a lado)

add() { # add "Label" "value"
  KEYS+=("$(retro_upper "$1")")
  VALS+=("$2")
}

push() { # push "colored line" "visible width"
  INFO+=("$1")
  INFO_W+=("$2")
}

kv_row() { # $1 chave  $2 valor  $3 largura do leader
  local k=$1 v=$2 pontos n
  n=$(($3 - ${#k} - ${#v}))
  [ "$n" -lt 2 ] && n=2
  pontos="$(retro_repetir '·' "$n")"
  push "$(printf '%s%s%s %s%s%s %s%s%s%s' \
            "$FG40" "$k" "$RESET" "$ACC15" "$pontos" "$RESET" \
            "$ACC" "$BOLD" "$v" "$RESET")" \
       $((${#k} + 1 + n + 1 + ${#v}))
}

fmt_uptime() { # $1 = seconds
  local s=$1 d h m out=""
  d=$((s / 86400)); h=$((s % 86400 / 3600)); m=$((s % 3600 / 60))
  [ "$d" -gt 0 ] && out="${d}d "
  [ "$h" -gt 0 ] && out="${out}${h}h "
  out="${out}${m}m"
  echo "$out"
}

shell_info() {
  local name ver=""
  name=$(basename "${SHELL:-sh}")
  ver=$("$name" --version 2>/dev/null | head -1 | grep -Eo '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
  echo "$name${ver:+ $ver}"
}

# ---------- collect ----------
OS_KERNEL="$(uname -s)"

USER_NAME="${USER:-$(whoami)}"
HOST_NAME="$(hostname -s 2>/dev/null || hostname)"
TITLE_PLAIN="${USER_NAME}@${HOST_NAME}"

if [ "$OS_KERNEL" = "Darwin" ]; then
  # hardware cache: system_profiler is slow, run it once
  if [ ! -f "$CACHE_FILE" ]; then
    mkdir -p "$CACHE_DIR"
    sp=$(system_profiler SPHardwareDataType SPDisplaysDataType 2>/dev/null)
    {
      printf 'HW_MODEL="%s"\n' "$(echo "$sp" | awk -F': +' '/Model Name/{print $2; exit}')"
      printf 'HW_GPU="%s"\n'   "$(echo "$sp" | awk -F': +' '/Chipset Model/{print $2}' | paste -sd ', ' -)"
      printf 'HW_RES="%s"\n'   "$(echo "$sp" | awk -F': +' '/Resolution/{print $2}' | paste -sd ', ' -)"
    } > "$CACHE_FILE"
  fi
  HW_MODEL="" HW_GPU="" HW_RES=""
  . "$CACHE_FILE"

  add OS "$(sw_vers -productName) $(sw_vers -productVersion) $(uname -m)"
  add Host "${HW_MODEL:-Mac} ($(sysctl -n hw.model))"
  add Kernel "$OS_KERNEL $(uname -r)"

  boot=$(sysctl -n kern.boottime | sed 's/.*sec = \([0-9]*\), usec.*/\1/')
  add Uptime "$(fmt_uptime $(( $(date +%s) - boot )))"

  add Shell "$(shell_info)"
  [ -n "${HW_RES:-}" ] && add Display "$HW_RES"
  add Term "${TERM_PROGRAM:-$TERM}${TERM_PROGRAM_VERSION:+ $TERM_PROGRAM_VERSION}"
  add CPU "$(sysctl -n machdep.cpu.brand_string)"
  [ -n "${HW_GPU:-}" ] && add GPU "$HW_GPU"

  total=$(sysctl -n hw.memsize)
  page=$(sysctl -n hw.pagesize)
  used=$(vm_stat | awk -v page="$page" '
    /Pages active/                {a=$NF}
    /Pages wired down/            {w=$NF}
    /Pages occupied by compressor/{c=$NF}
    END {gsub(/\./,"",a); gsub(/\./,"",w); gsub(/\./,"",c); print (a+w+c)*page}')
  add Memory "$(awk -v u="$used" -v t="$total" 'BEGIN{printf "%.1f GiB / %.1f GiB (%d%%)", u/2^30, t/2^30, u*100/t}')"

  disk_target=/System/Volumes/Data
  [ -d "$disk_target" ] || disk_target=/
  add Disk "$(df -H "$disk_target" | awk 'NR==2{printf "%s / %s (%s)", $3, $2, $5}')"

  brews=0 casks=0
  for cellar in /opt/homebrew/Cellar /usr/local/Cellar; do
    [ -d "$cellar" ] && brews=$((brews + $(ls -1 "$cellar" | wc -l)))
  done
  for caskroom in /opt/homebrew/Caskroom /usr/local/Caskroom; do
    [ -d "$caskroom" ] && casks=$((casks + $(ls -1 "$caskroom" | wc -l)))
  done
  [ "$((brews + casks))" -gt 0 ] && add Pkgs "$(echo "$brews (brew), $casks (cask)" | tr -s ' ')"

  batt=$(pmset -g batt 2>/dev/null | grep -Eo '[0-9]+%' | head -1)
  if [ -n "$batt" ]; then
    state=$(pmset -g batt | grep -Eo 'charging|discharging|charged|finishing charge' | head -1)
    add Battery "$batt${state:+ ($state)}"
  fi
else
  # Linux / Windows (Git Bash — o MSYS2 expõe /proc, então o resto funciona igual)
  os_pretty="Linux"
  case "$OS_KERNEL" in
    MINGW*|MSYS*|CYGWIN*)
      os_pretty="$(reg.exe query 'HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion' /v ProductName 2>/dev/null \
        | tr -d '\r' | sed -n 's/.*REG_SZ[[:space:]]*//p' | head -1)"
      os_pretty="${os_pretty:-Windows}"
      ;;
    *) [ -f /etc/os-release ] && os_pretty="$(. /etc/os-release && echo "$PRETTY_NAME")" ;;
  esac
  add OS "$os_pretty $(uname -m)"

  if [ -r /sys/devices/virtual/dmi/id/product_name ]; then
    add Host "$(cat /sys/devices/virtual/dmi/id/product_name)"
  fi
  add Kernel "$OS_KERNEL $(uname -r)"

  up=$(cut -d. -f1 /proc/uptime 2>/dev/null || echo 0)
  add Uptime "$(fmt_uptime "$up")"

  add Shell "$(shell_info)"
  add Term "${TERM_PROGRAM:-$TERM}"
  add CPU "$(awk -F': +' '/model name/{print $2; exit}' /proc/cpuinfo)"

  gpu=$(lspci 2>/dev/null | grep -iE 'vga|3d controller' | head -1 | sed 's/.*: //')
  [ -n "$gpu" ] && add GPU "$gpu"

  if [ -r /proc/meminfo ]; then
    add Memory "$(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{u=t-a; printf "%.1f GiB / %.1f GiB (%d%%)", u/1048576, t/1048576, u*100/t}' /proc/meminfo)"
  fi
  add Disk "$(df -H / | awk 'NR==2{printf "%s / %s (%s)", $3, $2, $5}')"

  pkgs=""
  if command -v dpkg >/dev/null 2>&1; then pkgs="$(dpkg -l 2>/dev/null | grep -c '^ii') (dpkg)"
  elif command -v pacman >/dev/null 2>&1; then pkgs="$(pacman -Q 2>/dev/null | wc -l | tr -d ' ') (pacman)"
  elif command -v rpm >/dev/null 2>&1; then pkgs="$(rpm -qa 2>/dev/null | wc -l | tr -d ' ') (rpm)"
  fi
  [ -n "$pkgs" ] && add Pkgs "$pkgs"

  for bat in /sys/class/power_supply/BAT*/capacity; do
    [ -r "$bat" ] && add Battery "$(cat "$bat")%" && break
  done
fi

# ---------- render das linhas ----------
# leader: o suficiente pra todas as linhas alinharem o valor à direita
LEAD=0
i=0
while [ "$i" -lt "${#KEYS[@]}" ]; do
  n=$(( ${#KEYS[$i]} + ${#VALS[$i]} ))
  [ "$n" -gt "$LEAD" ] && LEAD=$n
  i=$((i + 1))
done
LEAD=$((LEAD + 3))

i=0
while [ "$i" -lt "${#KEYS[@]}" ]; do
  kv_row "${KEYS[$i]}" "${VALS[$i]}" "$LEAD"
  i=$((i + 1))
done

# faixa de accent (rampa 15 → 100%), sem cores novas
if [ "${USE_COLOR:-0}" -eq 1 ]; then
  bloco="$(retro_repetir '█' 4)"
  push "" 0
  push "$(printf '%s%s%s%s%s%s%s%s%s%s%s' \
            "$ACC15" "$bloco" "$ACC30" "$bloco" "$ACC50" "$bloco" \
            "$ACC70" "$bloco" "$ACC" "$bloco" "$RESET")" 20
fi

# ---------- print ----------
TERM_W="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"

NLOGO=${#LOGO[@]}
NINFO=${#INFO[@]}

INFO_MAX=0
for w in "${INFO_W[@]}"; do
  [ "$w" -gt "$INFO_MAX" ] && INFO_MAX=$w
done

logo_line() { # $1 = row index; prints the colored logo row, no newline
  local i=$1 line="${LOGO[$1]}" n r g b
  if [ "$USE_COLOR" -eq 1 ]; then
    n=$((NLOGO - 1))
    r=$((R1 + (R2 - R1) * i / n))
    g=$((G1 + (G2 - G1) * i / n))
    b=$((B1 + (B2 - B1) * i / n))
    if [ "$USE_TRUECOLOR" -eq 1 ]; then
      printf '\033[38;2;%d;%d;%dm%s%s' "$r" "$g" "$b" "$line" "$RESET"
    else
      printf '\033[38;5;%dm%s%s' "$(rgb256 "$r" "$g" "$b")" "$line" "$RESET"
    fi
  else
    printf '%s' "$line"
  fi
}

retro_modulo "system_info" "$TITLE_PLAIN"
if [ "$TERM_W" -ge $((LOGO_W + ${#GAP} + INFO_MAX)) ]; then
  # wide: logo and info side by side
  ROWS=$NLOGO
  [ "$NINFO" -gt "$ROWS" ] && ROWS=$NINFO
  i=0
  while [ "$i" -lt "$ROWS" ]; do
    if [ "$i" -lt "$NLOGO" ]; then
      logo_line "$i"
    else
      printf '%*s' "$LOGO_W" ''
    fi
    printf '%s%s\n' "$GAP" "${INFO[$i]:-}"
    i=$((i + 1))
  done
else
  # narrow: centered logo on top (if it fits), info below
  if [ "$TERM_W" -ge "$LOGO_W" ]; then
    pad=$(((TERM_W - LOGO_W) / 2))
    i=0
    while [ "$i" -lt "$NLOGO" ]; do
      [ "$pad" -gt 0 ] && printf '%*s' "$pad" ''
      logo_line "$i"
      printf '\n'
      i=$((i + 1))
    done
    echo
  fi
  i=0
  while [ "$i" -lt "$NINFO" ]; do
    printf '  %s\n' "${INFO[$i]}"
    i=$((i + 1))
  done
fi
echo
