#!/usr/bin/env bash
# goodharness — biblioteca de styleguides pré-definidos para instalar em projetos
# (também acessível como `good harness …` via dispatcher do good)
#
# usage: goodharness copy <nome> [origem]      salva styleguide de um projeto como predefinição
#        goodharness install <nome> [destino]  instala predefinição em um projeto (.harness/styleguide.md)
#        goodharness list                      lista predefinições salvas
#        goodharness show <nome>               mostra o conteúdo de uma predefinição
#        goodharness rm <nome>                 remove uma predefinição
#        goodharness -h | --help
#
# origem:  arquivo .md OU diretório de projeto (procura .harness/styleguide.md, styleguide.md)
#          padrão: diretório atual
# destino: diretório do projeto — padrão: diretório atual
#
# predefinições ficam em styleguides/ ao lado deste script (versionadas no repo tools)

set -u

TOOL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
GUIDES_DIR="${GOODHARNESS_DIR:-$TOOL_DIR/styleguides}"

# ---------- tema retro (lib compartilhada) ----------
TEMA="${GOOD_TEMA:-${RETRO_TEMA:-vault-gold}}"
RETRO_LIB="$(cd "$TOOL_DIR/../lib" 2>/dev/null && pwd)/retro.sh"
if [ -f "$RETRO_LIB" ]; then
  . "$RETRO_LIB"
  retro_init 52
else
  # degradação: sem a lib, tudo sai em texto puro
  RESET="" BOLD="" DIM="" ACC="" ACC70="" ACC50="" ACC30="" ACC15=""
  FG="" FG70="" FG40="" INV="" OK="" ALERTA=""
  TRUECOLOR=0 USE_COLOR=0 COLS=80
  retro_upper()   { printf '%s' "$1" | tr '[:lower:]' '[:upper:]'; }
  retro_repetir() { local n=$2 s=""; while [ "$n" -gt 0 ]; do s="$s$1"; n=$((n - 1)); done; printf '%s' "$s"; }
  retro_modulo()  { printf '\n  [ MODULE: %s ]%s\n\n' "$(retro_upper "$1")" "${2:+  $(retro_upper "$2")}"; }
  retro_secao()   { printf '  # %s\n' "$(retro_upper "$1")"; }
  retro_kv()      { printf '  %-26s %s\n' "$1" "$2"; }
  retro_ok()      { printf '  [ OK ] %s\n' "$(retro_upper "$1")"; }
  retro_erro()    { printf '  [ ERRO ] %s\n' "$1"; }
  retro_aviso()   { printf '  [ %s ] %s\n' "$(retro_upper "$1")" "${2:-}"; }
  retro_proximo() { printf '  > %s  %s\n' "${2:-proximo passo:}" "$1"; }
fi

# ---------- helpers ----------
uso() {
  retro_modulo "goodharness_help"
  retro_secao "comandos"
  retro_kv "copy <nome> [origem]" "SALVAR PREDEFINICAO"
  retro_kv "install <nome> [dest]" "INSTALAR NO PROJETO"
  retro_kv "list" "LISTAR PREDEFINICOES"
  retro_kv "show <nome>" "IMPRIMIR CONTEUDO"
  retro_kv "rm <nome>" "REMOVER PREDEFINICAO"
  echo
  retro_secao "notas"
  retro_kv "ORIGEM" ".MD OU DIR DE PROJETO"
  retro_kv "DESTINO" ".HARNESS/STYLEGUIDE.MD"
  retro_kv "--FORCE" "SOBRESCREVE EXISTENTE"
  retro_kv "ALIAS" "GOOD HARNESS <CMD>"
  echo
  retro_secao "env"
  retro_kv "GOODHARNESS_DIR" "DIR DAS PREDEFINICOES"
  retro_kv "GOOD_TEMA" "$(retro_upper "$TEMA")"
  echo
  printf '  %sPRESETS: %s%s\n\n' "$ACC15" "${GUIDES_DIR/#$HOME/~}" "$RESET"
}

die() { retro_erro "$*" >&2; exit 2; }

valida_nome() {
  case "$1" in
    *[!a-zA-Z0-9._-]*|"") die "nome invalido: \"$1\" (use letras, numeros, ponto, hifen, underscore)" ;;
  esac
}

guide_path() { echo "$GUIDES_DIR/$1.md"; }

# acha o styleguide dentro de uma origem (arquivo ou diretório de projeto)
resolve_origem() { # $1 = caminho
  local o="$1"
  if [ -f "$o" ]; then
    echo "$o"; return 0
  fi
  if [ -d "$o" ]; then
    local c
    for c in "$o/.harness/styleguide.md" "$o/styleguide.md" "$o/.harness/styleguide"*.md; do
      if [ -f "$c" ]; then echo "$c"; return 0; fi
    done
  fi
  return 1
}

tem_predefinicoes() {
  [ -d "$GUIDES_DIR" ] || return 1
  local f
  for f in "$GUIDES_DIR"/*.md; do
    [ -f "$f" ] && return 0
  done
  return 1
}

# ---------- comandos ----------
cmd_copy() {
  local force=0 args=()
  local a
  for a in "$@"; do
    case "$a" in
      --force|-f) force=1 ;;
      *) args+=("$a") ;;
    esac
  done
  [ "${#args[@]}" -ge 1 ] || die "faltou o nome. uso: goodharness copy <nome> [origem]"
  local nome="${args[0]}"
  local origem="${args[1]:-.}"
  valida_nome "$nome"

  local src
  src="$(resolve_origem "$origem")" || die "styleguide nao encontrado em \"$origem\" (procurei .harness/styleguide.md e styleguide.md)"

  local dest
  dest="$(guide_path "$nome")"
  if [ -f "$dest" ] && [ "$force" -eq 0 ]; then
    die "predefinicao \"$nome\" ja existe — use --force para sobrescrever"
  fi

  mkdir -p "$GUIDES_DIR"
  cp "$src" "$dest"

  retro_modulo "harness_copy" "preset: $nome"
  retro_ok "predefinicao salva"
  echo
  retro_kv "PREDEFINICAO" "$(retro_upper "$nome")"
  retro_kv "ORIGEM" "${src/#$HOME/~}"
  retro_kv "DESTINO" "${dest/#$HOME/~}"
  echo
  retro_proximo "goodharness install $nome <projeto>"
  echo
}

cmd_install() {
  local force=0 args=()
  local a
  for a in "$@"; do
    case "$a" in
      --force|-f) force=1 ;;
      *) args+=("$a") ;;
    esac
  done
  [ "${#args[@]}" -ge 1 ] || die "faltou o nome. uso: goodharness install <nome> [destino]"
  local nome="${args[0]}"
  local destino="${args[1]:-.}"

  local src
  src="$(guide_path "$nome")"
  if [ ! -f "$src" ]; then
    {
      retro_modulo "harness_install" "preset: $nome"
      retro_erro "predefinicao \"$nome\" nao existe."
      echo
      cmd_list
    } >&2
    exit 2
  fi

  [ -d "$destino" ] || die "destino nao e um diretorio: $destino"

  local harness_dir="$destino/.harness"
  local dest="$harness_dir/styleguide.md"
  if [ -f "$dest" ] && [ "$force" -eq 0 ]; then
    die "ja existe styleguide em ${dest/#$HOME/~} — use --force para sobrescrever"
  fi

  mkdir -p "$harness_dir"
  cp "$src" "$dest"

  retro_modulo "harness_install" "preset: $nome"
  retro_ok "styleguide instalado"
  echo
  retro_kv "PREDEFINICAO" "$(retro_upper "$nome")"
  retro_kv "DESTINO" "${dest/#$HOME/~}"
  echo
  retro_proximo "cat ${dest/#$HOME/~}" "confira:"
  echo
}

cmd_list() {
  if ! tem_predefinicoes; then
    retro_modulo "harness_presets"
    retro_aviso "vazio" "nenhuma predefinicao salva ainda."
    retro_proximo "goodharness copy <nome> <origem>" "crie a primeira:"
    echo
    return 0
  fi

  local f nomes=() linhas=() larg=0 n
  for f in "$GUIDES_DIR"/*.md; do
    [ -f "$f" ] || continue
    n="$(basename "$f" .md)"
    nomes+=("$n")
    linhas+=("$(wc -l < "$f" | tr -d ' ')")
    [ "${#n}" -gt "$larg" ] && larg=${#n}
  done

  retro_modulo "harness_presets" "${#nomes[@]} predefinicao(oes)"
  local i=0
  while [ "$i" -lt "${#nomes[@]}" ]; do
    printf '  %s·%s %s%s%-*s%s  %s%s LINHA(S)%s\n' \
      "$ACC" "$RESET" "$ACC" "$BOLD" "$larg" "$(retro_upper "${nomes[$i]}")" "$RESET" \
      "$FG40" "${linhas[$i]}" "$RESET"
    i=$((i + 1))
  done
  echo
  retro_proximo "goodharness install <nome> <projeto>"
  printf '\n  %sPRESETS: %s%s\n\n' "$ACC15" "${GUIDES_DIR/#$HOME/~}" "$RESET"
}

cmd_show() {
  [ $# -ge 1 ] || die "faltou o nome. uso: goodharness show <nome>"
  local src
  src="$(guide_path "$1")"
  [ -f "$src" ] || die "predefinicao \"$1\" nao existe"
  # cabeçalho só quando é um terminal — mantém `show` redirecionável
  [ "${DESENHA:-0}" -eq 1 ] && retro_modulo "harness_preset" "src: $1.md"
  cat "$src"
}

cmd_rm() {
  [ $# -ge 1 ] || die "faltou o nome. uso: goodharness rm <nome>"
  local src
  src="$(guide_path "$1")"
  [ -f "$src" ] || die "predefinicao \"$1\" nao existe"
  retro_modulo "harness_remove" "preset: $1"
  printf '  %s>%s remover predefinicao %s%s%s%s? [s/N] ' \
    "$ACC30" "$RESET" "$ACC" "$BOLD" "$(retro_upper "$1")" "$RESET"
  local resp
  read -r resp
  echo
  case "$resp" in
    s|S|sim)
      rm "$src"
      retro_ok "predefinicao removida"
      echo
      ;;
    *)
      retro_aviso "abortado" "nada foi removido."
      echo
      ;;
  esac
}

# ---------- main ----------
case "${1:-}" in
  copy)     shift; cmd_copy "$@" ;;
  install)  shift; cmd_install "$@" ;;
  list|ls)  cmd_list ;;
  show|cat) shift; cmd_show "$@" ;;
  rm|remove) shift; cmd_rm "$@" ;;
  -h|--help|help|"") uso ;;
  *) die "comando desconhecido: $1 (veja goodharness --help)" ;;
esac
