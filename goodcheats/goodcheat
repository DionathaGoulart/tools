#!/usr/bin/env bash
# goodcheat — quick reference sheets (macOS / Linux / Windows via Git Bash)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SHEET_DIR="$SCRIPT_DIR/sheets"

usage() {
  echo "usage: goodcheat <topic>     — view sheet"
  echo "       goodcheat -e <topic>  — edit/create sheet"
  echo "       goodcheat -l          — list sheets"
  echo "       goodcheat -s <term>   — search inside all sheets"
}

valid_topic() {
  case "$1" in
    */*|.*|'') echo "invalid topic name: '$1' (no slashes, no leading dot)"; return 1 ;;
  esac
}

pick_editor() {
  if [ -n "${EDITOR:-}" ]; then
    echo "$EDITOR"
  elif command -v nano >/dev/null 2>&1; then
    echo "nano"
  else
    echo "vi"
  fi
}

list() {
  if [ ! -d "$SHEET_DIR" ] || [ -z "$(ls -A "$SHEET_DIR" 2>/dev/null)" ]; then
    echo "(no sheets yet — create one with: goodcheat -e <topic>)"
    return
  fi
  for f in "$SHEET_DIR"/*; do
    [ -f "$f" ] || continue
    desc="$(head -1 "$f")"
    case "$desc" in
      '#'*) desc="$(echo "$desc" | sed 's/^# *//')" ;;
      *)    desc="" ;;
    esac
    printf "%-18s %s\n" "$(basename "$f")" "$desc"
  done
}

search() {
  if [ -z "${1:-}" ]; then
    echo "usage: goodcheat -s <term>"
    return 1
  fi
  matches="$(grep -RIni -- "$1" "$SHEET_DIR" 2>/dev/null)"
  if [ -z "$matches" ]; then
    echo "no matches for '$1'"
    return 1
  fi
  echo "$matches" | sed "s|^$SHEET_DIR/||"
}

show() {
  valid_topic "$1" || return 1
  if [ -f "$SHEET_DIR/$1" ]; then
    if command -v bat >/dev/null 2>&1; then
      bat --style=plain --paging=never "$SHEET_DIR/$1"
    else
      cat "$SHEET_DIR/$1"
    fi
  else
    echo "cheat sheet '$1' not found"
    matches="$(ls "$SHEET_DIR" 2>/dev/null | grep -i -- "$1")"
    if [ -n "$matches" ]; then
      echo "did you mean:"
      echo "$matches" | sed 's/^/  /'
    else
      echo "available:"
      list | sed 's/^/  /'
    fi
    return 1
  fi
}

edit() {
  if [ -z "${1:-}" ]; then
    echo "usage: goodcheat -e <topic>"
    return 1
  fi
  valid_topic "$1" || return 1
  mkdir -p "$SHEET_DIR"
  "$(pick_editor)" "$SHEET_DIR/$1"
}

case "${1:-}" in
  "")                    usage ;;
  -h|--help|help)        usage ;;
  -l|--list|list)        list ;;
  -e|--edit|edit)        shift; edit "${1:-}" ;;
  -s|--search|search)    shift; search "${1:-}" ;;
  *)                     show "$1" ;;
esac
