git log --oneline -5          # últimos 5 commits
git log --graph --oneline     # visualização em árvore
git commit --amend -m "msg"   # alterar último commit
git stash push -m "wip"       # stash nomeado
git stash pop                 # restaurar stash
git rebase -i HEAD~3          # squash/reword últimos 3
git reset --soft HEAD~1       # desfaz commit mantendo arquivos
git diff --stat               # arquivos alterados vs linhas
git branch -d nome            # deletar branch local (seguro)
git push origin --delete nome # deletar branch remota
