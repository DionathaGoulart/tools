        prog="goodjob",
        description="Copiloto de busca de emprego: radar de vagas ao vivo (Gupy, "
                    "LinkedIn, Remotive, RemoteOK) + aderência, carta, CV e prep.",
        epilog='exemplos:  goodjob   ·   goodjob buscar "dev python" --remoto   ·   '
               'goodjob match 3   ·   goodjob carta 3   ·   goodjob tracker',
        add_help=False,
    )
    ap.add_argument("comando", nargs="?", default="radar",
                    choices=["radar", "buscar", "vagas", "perfil", "match", "carta",
                             "cv", "prep", "tracker", "temas"],
                    help="radar (padrão): vagas do seu perfil · buscar: busca avulsa · "
                         "vagas: reexibe o radar · perfil: seu perfil · match/carta/cv/"
                         "prep <N>: geração sobre a vaga N · tracker: funil · temas: paletas")
    ap.add_argument("resto", nargs="*", help="argumento do comando (N, termo, sub…)")
    ap.add_argument("-f", "--fresh", action="store_true",
                    help="ignora o cache de 6h e recoleta agora")
    ap.add_argument("--remoto", action="store_true", help="só vagas remotas")
    ap.add_argument("--local", default="", help="local da busca (LinkedIn)")
    ap.add_argument("-m", "--modelos", action="store_true",
                    help="lista modelos :free disponíveis")
    ap.add_argument("--json", action="store_true", dest="como_json",
                    help="saída JSON crua (coleta e leitura) — pro skill /goodjob")
    ap.add_argument("-h", "--help", action="store_true", help="mostra esta ajuda")
    args = ap.parse_args()

    if args.help:
        uso()
        return

    if args.como_json and args.comando in ("match", "carta", "cv", "prep"):
        die("--json é só pra coleta/leitura (radar, buscar, vagas, perfil, tracker). "
            "Geração com o Claude: skill /goodjob no Claude Code.")

