def envolver(texto, cor=""):
    larg = max(20, ui.cf)
    return [f"{cor}{p}{ui.RESET}" if cor else p
            for p in (textwrap.wrap(texto, larg) or [""])]


def carregar_json(caminho, padrao):
    if caminho.exists():
        try:
            return json.loads(caminho.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
