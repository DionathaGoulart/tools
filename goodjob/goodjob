# ---------------------------------------------------------------- http

def http_get(url, headers=None, timeout=15):
    req = urllib.request.Request(url, headers=headers or {"User-Agent": UA_BROWSER})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read()


def http_json(url, headers=None, timeout=15):
    return json.loads(http_get(url, headers, timeout).decode("utf-8"))


# ---------------------------------------------------------------- perfil

def carregar_perfil():
    """Perfil do candidato: arquivo perfil.json com fallback pras envs. `query`
    é o único obrigatório pro radar (o que você busca)."""
    p = carregar_json(PERFIL_FILE, {}) or {}
    p.setdefault("query", os.environ.get("GOODJOB_QUERY", "").strip())
    p.setdefault("local", os.environ.get("GOODJOB_LOCAL", "Brasil").strip())
    p.setdefault("stack", [])
    p.setdefault("senioridade", "")
    p.setdefault("remoto", False)
    p.setdefault("salario_alvo", "")
    p.setdefault("evitar", [])
    return p


def caminho_cv():
    env = os.environ.get("GOODJOB_CV", "").strip()
    return Path(env).expanduser() if env else CV_PADRAO


def carregar_cv():
    caminho = caminho_cv()
    if caminho.exists():
        try:
            return caminho.read_text(encoding="utf-8").strip()
        except OSError:
            return ""
    return ""


def termos_perfil(perfil):
    """Palavras que definem aderência: a query + a stack."""
    bruto = " ".join([perfil.get("query", "")] + list(perfil.get("stack", [])))
    termos = re.findall(r"[a-zà-ÿ0-9+#.]{2,}", bruto.lower())
    stop = {"de", "da", "do", "para", "com", "sr", "jr", "pl", "e"}
    return [t for t in dict.fromkeys(termos) if t not in stop]


# ---------------------------------------------------------------- coleta de vagas

def _vaga(fonte, sid, titulo, empresa, local, remoto, url, publicado,
          salario="", tags=None, descricao=""):
    return {
        "fonte": fonte,
        "sid": str(sid),
        "titulo": (titulo or "").strip(),
        "empresa": (empresa or "").strip(),
        "local": (local or "").strip(),
        "remoto": bool(remoto),
        "url": (url or "").strip(),
        "publicado": publicado or "",
        "salario": (salario or "").strip(),
        "tags": tags or [],
        "descricao": resumir(limpar_html(descricao), 1400),
    }


def fetch_gupy(termo, limite=POR_FONTE):
    q = urllib.parse.urlencode({"jobName": termo, "offset": 0, "limit": limite})
    dados = http_json(f"{GUPY_URL}?{q}", timeout=20)
    total = (dados.get("pagination") or {}).get("total")
    out = []
    for j in dados.get("data", []):
        cidade = ", ".join(x for x in (j.get("city"), j.get("state")) if x)
        out.append(_vaga(
            "gupy", j.get("id"), j.get("name"), j.get("careerPageName"),
            cidade or j.get("country") or "Brasil",
            j.get("isRemoteWork") or j.get("workplaceType") == "remote",
            j.get("jobUrl"), j.get("publishedDate"),
            tags=[j.get("workplaceType")] if j.get("workplaceType") else [],
            descricao=j.get("description", ""),
        ))
    return out, total


def fetch_linkedin(termo, local="Brasil", limite=POR_FONTE):
    q = urllib.parse.urlencode({"keywords": termo, "location": local, "start": 0})
    hdr = {"User-Agent": UA_BROWSER, "Accept": "text/html"}
    corpo = http_get(f"{LINKEDIN_URL}?{q}", hdr, timeout=15).decode("utf-8", "ignore")
    cartoes = re.findall(r'<li>.*?</li>', corpo, re.S)
    out = []
    for c in cartoes[:limite]:
        mid = re.search(r'urn:li:jobPosting:(\d+)', c)
        tit = re.search(r'base-search-card__title">\s*(.*?)\s*</h3>', c, re.S)
        emp = re.search(r'base-search-card__subtitle">\s*<a[^>]*>\s*(.*?)\s*</a>', c, re.S)
        loc = re.search(r'job-search-card__location">\s*(.*?)\s*</span>', c, re.S)
        url = re.search(r'href="(https://[a-z]{0,3}\.?linkedin\.com/jobs/view/[^"?]+)', c)
        data = re.search(r'datetime="([0-9-]+)"', c)
        if not (mid and tit):
            continue
        localv = html.unescape((loc.group(1) if loc else "").strip())
        out.append(_vaga(
            "linkedin", mid.group(1), html.unescape(tit.group(1).strip()),
            html.unescape(emp.group(1).strip()) if emp else "",
            localv, "remot" in localv.lower(),
            url.group(1) if url else f"https://www.linkedin.com/jobs/view/{mid.group(1)}",
            (data.group(1) if data else ""),
        ))
    return out


def fetch_linkedin_jd(sid):
    """Descrição completa de uma vaga do LinkedIn (o card da busca não traz)."""
    try:
        corpo = http_get(LINKEDIN_JD_URL.format(sid),
                         {"User-Agent": UA_BROWSER}, timeout=15).decode("utf-8", "ignore")
    except (urllib.error.URLError, OSError):
        return ""
    m = re.search(r'(?s)description__text.*?<span[^>]*>(.*?)</span>\s*</div>', corpo)
    m = m or re.search(r'(?s)<div class="[^"]*show-more-less-html__markup[^"]*">(.*?)</div>', corpo)
    return limpar_html(m.group(1)) if m else ""


def fetch_remotive(termo, limite=POR_FONTE):
    q = urllib.parse.urlencode({"search": termo, "limit": limite})
    dados = http_json(f"{REMOTIVE_URL}?{q}", timeout=20)
    out = []
    for j in dados.get("jobs", [])[:limite]:
        out.append(_vaga(
            "remotive", j.get("id"), j.get("title"), j.get("company_name"),
            j.get("candidate_required_location") or "Remoto", True,
            j.get("url"), j.get("publication_date"),
            salario=j.get("salary", ""), tags=j.get("tags", []),
            descricao=j.get("description", ""),
        ))
    return out


def fetch_remoteok(termo, limite=POR_FONTE):
    # As tags do RemoteOK são palavras únicas em inglês ("python", "react") — um
    # termo composto ("desenvolvedor python") como tag não casa. Então puxamos o
    # feed geral e filtramos localmente por qualquer token do termo (position +
    # tags), o que faz a fonte contribuir sempre que houver um tech em inglês.
    tokens = [t for t in re.findall(r"[a-z0-9+#]{2,}", termo.lower())
              if t not in ("desenvolvedor", "desenvolvedora", "pessoa", "vaga",
                            "developer", "engineer", "programador", "sr", "jr", "pl")]
    dados = http_json(REMOTEOK_URL, {"User-Agent": UA_BROWSER}, timeout=20)
    out = []
    for j in dados:
        if not isinstance(j, dict) or not j.get("position"):
            continue  # 1º item é aviso legal
        pos = j.get("position", "")
        if re.search(r"(?i)don'?t see an open position|see an open", pos):
            continue  # posting-coringa do RemoteOK (taggeado com tudo)
        palheiro = (pos + " " + " ".join(j.get("tags", []))).lower()
        if tokens and not any(t in palheiro for t in tokens):
            continue
        smin, smax = j.get("salary_min") or 0, j.get("salary_max") or 0
        sal = f"${smin // 1000}k–${smax // 1000}k" if smin and smax else ""
        out.append(_vaga(
            "remoteok", j.get("id"), j.get("position"), j.get("company"),
            j.get("location") or "Remoto", True,
            j.get("url") or j.get("apply_url"), j.get("date"),
            salario=sal, tags=j.get("tags", []), descricao=j.get("description", ""),
        ))
        if len(out) >= limite:
            break
    return out


def pontuar(v, termos, perfil):
    """Score de aderência: keyword no título/descrição + frescor + remoto."""
    tit, desc = v["titulo"].lower(), v["descricao"].lower()
    score = sum(3 for t in termos if t in tit) + sum(1 for t in termos if t in desc)
    d = dias_desde(v["publicado"])
    score += 4 if d <= 7 else 2 if d <= 14 else 1 if d <= 30 else 0
    if perfil.get("remoto") and v["remoto"]:
        score += 2
    for e in perfil.get("evitar", []):
        if e and e.lower() in tit:
            score -= 6
    return score


def coletar(termo, remoto=False, local="Brasil", force=False, perfil=None):
    """Coleta paralela das 4 fontes, dedup, rankeia pelo perfil e cacheia 6h."""
    perfil = perfil or {}
    cache = carregar_json(RADAR_FILE, None)
    chave = {"termo": termo, "remoto": remoto, "local": local}
    if cache and not force and cache.get("filtros") == chave:
        ts = parse_iso(cache.get("ts", ""))
        if ts and (agora_utc() - ts).total_seconds() < CACHE_RADAR_HORAS * 3600:
            return cache

    nota(f"coletando vagas: “{termo}” — gupy, linkedin, remotive, remoteok…")
    snapshot = {"ts": agora_utc().isoformat(), "termo": termo,
                "filtros": chave, "falhas": [], "totais": {}}
    with ThreadPoolExecutor(max_workers=4) as ex:
        jobs = {
            "gupy": ex.submit(fetch_gupy, termo),
            "linkedin": ex.submit(fetch_linkedin, termo, local),
            "remotive": ex.submit(fetch_remotive, termo),
            "remoteok": ex.submit(fetch_remoteok, termo),
        }
        vagas, totais = [], {}
        for nome, fut in jobs.items():
            try:
                res = fut.result()
                lote, total = res if isinstance(res, tuple) else (res, None)
                vagas += lote
                totais[nome] = total if total is not None else len(lote)
            except Exception as e:
                snapshot["falhas"].append(f"{nome}: {type(e).__name__}")
    snapshot["totais"] = totais

    if remoto:
        vagas = [v for v in vagas if v["remoto"]]

    # dedup por (título, empresa) mantendo a 1ª ocorrência
    vistos, unicas = set(), []
    for v in vagas:
        k = (normalizar(v["titulo"])[:60], normalizar(v["empresa"]))
        if k in vistos:
            continue
        vistos.add(k)
        unicas.append(v)

    termos = termos_perfil(perfil) or termos_perfil({"query": termo})
    for v in unicas:
        v["score"] = pontuar(v, termos, perfil)
    # score desc; empate → mais recente primeiro (menos dias desde a publicação)
    unicas.sort(key=lambda v: (-v["score"], dias_desde(v["publicado"])))
    for i, v in enumerate(unicas, 1):
        v["n"] = i
    snapshot["vagas"] = unicas

    if not unicas and not snapshot["falhas"]:
        snapshot["falhas"].append("nenhuma vaga casou com o termo")
    salvar_json(RADAR_FILE, snapshot)
    marcar_radar()
    return snapshot


