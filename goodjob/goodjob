def vaga_por_n(alvo):
    """Resolve 'match 3' → vaga #3 do último radar. Aceita também um número puro."""
    snap = carregar_json(RADAR_FILE, None)
    if not snap or not snap.get("vagas"):
        die("nenhum radar salvo. Rode `goodjob radar` ou `goodjob buscar \"termo\"` antes.")
    alvo = (alvo or "").strip()
    if not alvo.isdigit():
        die("informe o número da vaga. Ex.: `goodjob match 3` (veja `goodjob vagas`).")
    n = int(alvo)
    for v in snap["vagas"]:
        if v.get("n") == n:
            return v
    die(f"vaga {n} não existe no radar atual ({len(snap['vagas'])} vagas). "
        "Rode `goodjob vagas`.")


def gerar_sobre_vaga(alvo, mod, system, exigir_cv=False, temperatura=0.7):
    v = vaga_por_n(alvo)
    perfil, cv = carregar_perfil(), carregar_cv()
    user = (bloco_candidato(perfil, cv, exigir_cv=exigir_cv)
            + "\n\n=== VAGA ===\n" + bloco_vaga(v))
    nota(f"gerando ({mod}) pra vaga #{v['n']}: {resumir(v['titulo'], 40)}…")
    texto, model = chamar_llm(
        [{"role": "system", "content": system},
         {"role": "user", "content": user}],
        max_tokens=2400, temperature=temperatura)
    _saida_texto(mod, f"model: {model}", v["titulo"], texto)
    ui.proximo(f"goodjob tracker add {v['n']}", "salvar no funil:")
    print()


# ---------------------------------------------------------------- tracker

def carregar_tracker():
    return carregar_json(TRACKER_FILE, {"itens": []}) or {"itens": []}


def tracker_add(alvo):
    v = vaga_por_n(alvo)
    t = carregar_tracker()
    for it in t["itens"]:
        if it["sid"] == v["sid"] and it["fonte"] == v["fonte"]:
            ui.aviso("já existe", f"{v['titulo']} já está no funil ({it['estagio']}).")
            return
    t["itens"].append({
        "fonte": v["fonte"], "sid": v["sid"], "titulo": v["titulo"],
        "empresa": v["empresa"], "url": v["url"], "estagio": "salvo",
        "desde": agora_utc().isoformat(), "nota": "",
    })
    salvar_json(TRACKER_FILE, t)
    ui.modulo("tracker", "add")
    ui.ok(f"salvo no funil: {v['titulo']} — {v['empresa']}")
    ui.proximo("goodjob tracker", "ver funil:")
    print()


def _achar_item(t, ref):
    ref = normalizar(ref)
    for it in t["itens"]:
        if it["sid"] == ref or ref in normalizar(it["empresa"]) or ref in normalizar(it["titulo"]):
            return it
    return None


def tracker_mv(ref, estagio):
    estagio = normalizar(estagio)
    if estagio not in ESTAGIOS:
        die(f"estágio inválido. Use um de: {', '.join(ESTAGIOS)}")
    t = carregar_tracker()
    it = _achar_item(t, ref)
    if not it:
        die(f"não achei '{ref}' no funil. Veja `goodjob tracker`.")
    it["estagio"] = estagio
    it["desde"] = agora_utc().isoformat()
    salvar_json(TRACKER_FILE, t)
    ui.modulo("tracker", "mv")
    ui.ok(f"{it['titulo']} → {estagio.upper()}")
    print()


def tracker_nota(ref, texto):
    t = carregar_tracker()
    it = _achar_item(t, ref)
    if not it:
        die(f"não achei '{ref}' no funil. Veja `goodjob tracker`.")
    it["nota"] = texto.strip()
    salvar_json(TRACKER_FILE, t)
    ui.modulo("tracker", "nota")
    ui.ok(f"nota salva em {it['titulo']}")
    print()


def tracker_ls(como_json=False):
    t = carregar_tracker()
    if como_json:
        print(json.dumps(t, ensure_ascii=False, indent=2))
        return
    ui.modulo("tracker", f"itens: {len(t['itens'])}")
    if not t["itens"]:
        ui.aviso("vazio", "nenhuma candidatura no funil.")
        ui.proximo("goodjob tracker add <N>", "adicione do radar:")
        print()
        return
    for est in ESTAGIOS:
        grupo = [it for it in t["itens"] if it["estagio"] == est]
        if not grupo:
            continue
        ui.secao(est)
        for it in grupo:
            idade = idade_humana(it["desde"])
            alerta = ""
            if it["estagio"] in ("aplicado", "entrevista") and dias_desde(it["desde"]) >= 7:
                alerta = f"  {ui.ALERTA}⏰ follow-up{ui.RESET}"
            meta = f"— {it['empresa']} · há {idade}{alerta}"
            ui.item("·", it["titulo"], meta)
            if it.get("nota"):
                print(f"      {ui.FG40}“{resumir(it['nota'], 70)}”{ui.RESET}")
    print()


def cmd_tracker(resto, como_json=False):
    if not resto:
        tracker_ls(como_json)
        return
    sub, args = resto[0], resto[1:]
    if sub == "add":
        tracker_add(" ".join(args))
    elif sub in ("mv", "mover"):
        if len(args) < 2:
            die('uso: goodjob tracker mv <empresa|sid> <estagio>  '
                f"({', '.join(ESTAGIOS)})")
        tracker_mv(args[0], args[-1])
    elif sub in ("nota", "note"):
        if len(args) < 2:
            die('uso: goodjob tracker nota <empresa|sid> "texto"')
        tracker_nota(args[0], " ".join(args[1:]))
    elif sub in ("ls", "lista"):
        tracker_ls(como_json)
    else:
        die(f"subcomando '{sub}' desconhecido. Use: add, mv, nota, ls.")


