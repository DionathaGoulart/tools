FONTE_CHIP = {"gupy": "GUPY", "linkedin": "LKDIN", "remotive": "RMTV", "remoteok": "RMOK"}


def _render_lista(snapshot, titulo_mod):
    vagas = snapshot.get("vagas", [])
    termo = snapshot.get("termo", "")
    ui.modulo(titulo_mod, f"termo: {resumir(termo, 28)}")
    if not vagas:
        ui.aviso("vazio", "nenhuma vaga encontrada pra esse termo/filtro.")
        for f in snapshot.get("falhas", []):
            ui.item("!", f)
        ui.proximo('goodjob buscar "outro termo"', "tente:")
        print()
        return
    remotas = sum(1 for v in vagas if v["remoto"])
    ui.kv("VAGAS", f"{len(vagas)} (APOS DEDUP)")
    ui.kv("REMOTAS", str(remotas))
    tot = snapshot.get("totais", {})
    ui.kv("POR FONTE", " · ".join(f"{FONTE_CHIP.get(k, k.upper())} {tot[k]}"
                                  for k in ("gupy", "linkedin", "remotive", "remoteok")
                                  if k in tot))
    print()
    ui.secao("vagas")
    for v in vagas:
        flag = f"{ui.OK}🌐{ui.RESET} " if v["remoto"] else ""
        chip = ui.chip(FONTE_CHIP.get(v["fonte"], v["fonte"].upper()))
        idade = idade_humana(v["publicado"])
        meta = " · ".join(x for x in (
            v["empresa"], v["local"], f"há {idade}" if idade else "",
            v["salario"]) if x)
        ui.item(str(v["n"]), f"{flag}{v['titulo']}  {chip}", f"— {meta}")
    print()
    for f in snapshot.get("falhas", []):
        ui.item("!", f)
    if snapshot.get("falhas"):
        print()
    ui.proximo("goodjob match <N>", "aderência CV × vaga:")
    ui.proximo("goodjob carta <N>", "carta/mensagem:")
    print()


# ---------------------------------------------------------------- LLM (standalone)

_llm = LLM("goodjob", DEFAULT_MODELS)


def chamar_llm(messages, max_tokens=2200, temperature=0.7):
    try:
        return _llm.chat(messages, max_tokens=max_tokens, temperature=temperature)
    except LLMError as e:
        if e.kind == "no_key":
            die("OPENROUTER_API_KEY não definida (necessária só pros comandos de "
                "geração no CLI).\n"
                "  1. Crie uma chave grátis em https://openrouter.ai/keys\n"
                '  2. export OPENROUTER_API_KEY="sk-or-..."\n'
                "  Ou use o skill /goodjob no Claude Code (geração sem chave).")
        if e.kind == "auth":
            die("OPENROUTER_API_KEY inválida (HTTP 401).")
        die("Todos os modelos falharam:\n  " + "\n  ".join(e.errors))


def listar_modelos_free():
    try:
        livres = _llm.free_models()
    except LLMError as e:
        die(e.message)
    ui.modulo("free_models", "src: openrouter")
    ui.kv("DISPONIVEIS", f"{len(livres)} MODELO(S)")
    print()
    ui.secao("modelos")
    for m in livres:
        ui.item("·", m)
    print()
    ui.proximo('export OPENROUTER_MODEL="modelo1,modelo2"', "pra trocar:")
    print()


def bloco_vaga(v):
    linhas = [
        f"Título: {v['titulo']}",
        f"Empresa: {v['empresa']}",
        f"Local: {v['local']} ({'remoto' if v['remoto'] else 'presencial/híbrido'})",
        f"Fonte: {v['fonte']}  ·  Link: {v['url']}",
    ]
    if v.get("salario"):
        linhas.append(f"Salário: {v['salario']}")
    desc = v.get("descricao") or ""
    if not desc and v["fonte"] == "linkedin":
        desc = fetch_linkedin_jd(v["sid"])
    linhas.append("Descrição da vaga:\n" + (desc or "(sem descrição disponível)"))
    return "\n".join(linhas)


def bloco_candidato(perfil, cv, exigir_cv=False):
    partes = []
    if perfil.get("senioridade") or perfil.get("stack"):
        partes.append("Perfil: "
                       + " · ".join(x for x in (
                           perfil.get("senioridade", ""),
                           ", ".join(perfil.get("stack", [])),
                           f"alvo salarial {perfil['salario_alvo']}"
                           if perfil.get("salario_alvo") else "") if x))
    if cv:
        partes.append("CV do candidato:\n" + cv)
    elif exigir_cv:
        die("nenhum CV encontrado.\n"
            f"  Crie {caminho_cv()} (texto/markdown) ou aponte GOODJOB_CV pro seu CV.\n"
            "  match e cv precisam do CV; carta e prep funcionam sem, mas ficam melhores com.")
    ctx = os.environ.get("GOODJOB_CONTEXTO", "").strip()
    if ctx:
        partes.append("Contexto extra do candidato: " + ctx)
    return "\n\n".join(partes) or "(candidato não forneceu perfil nem CV)"


def _saida_texto(mod, meta, titulo_vaga, texto):
