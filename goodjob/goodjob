    caminho.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")


def agora_utc():
    return datetime.now(timezone.utc)


def parse_iso(s):
    if not s:
        return None
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except (ValueError, TypeError):
        return None


def idade_humana(iso):
    dt = parse_iso(iso)
    if not dt:
        return ""
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    seg = (agora_utc() - dt).total_seconds()
    if seg < 0:
        return "agora"
    if seg < 3600:
        return f"{int(seg // 60)}min"
    if seg < 86400:
        return f"{int(seg // 3600)}h"
    dias = int(seg // 86400)
    return f"{dias}d" if dias < 30 else f"{dias // 30}mes"


def dias_desde(iso):
    dt = parse_iso(iso)
    if not dt:
        return 9999
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return max(0, int((agora_utc() - dt).total_seconds() // 86400))


def limpar_html(txt):
    """HTML/entidades → texto puro (as descrições da Gupy/RemoteOK vêm em HTML)."""
    if not txt:
        return ""
    txt = re.sub(r"(?i)<br\s*/?>", "\n", txt)
    txt = re.sub(r"(?i)</(p|li|div|h[1-6])>", "\n", txt)
    txt = re.sub(r"<[^>]+>", " ", txt)
    txt = html.unescape(txt).replace("\xa0", " ")
    txt = re.sub(r"[ \t]+", " ", txt)
    txt = re.sub(r"\n\s*\n\s*\n+", "\n\n", txt)
    return txt.strip()


def resumir(txt, n):
    txt = re.sub(r"\s+", " ", (txt or "").strip())
    return txt if len(txt) <= n else txt[: n - 1].rstrip() + "…"


def normalizar(s):
    return re.sub(r"\s+", " ", (s or "").strip().lower())


