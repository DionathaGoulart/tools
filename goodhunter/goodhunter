# ---------------------------------------------------------------------------
# OS helpers
# ---------------------------------------------------------------------------

def is_windows():
    return sys.platform == "win32" or sys.platform == "cygwin"


def powershell_raw(args: list[str], input_data: str = "") -> str:
    try:
        result = subprocess.run(
            ["powershell.exe", "-NoProfile"] + args,
            capture_output=True, text=True, timeout=30,
            input=input_data,
        )
        return result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return ""


def powershell(script: str) -> str:
    return powershell_raw(["-Command", script])


def powershell_encoded(script: str) -> str:
    encoded = base64.b64encode(script.encode("utf-16le")).decode()
    return powershell_raw(["-EncodedCommand", encoded])


def has_powershell() -> bool:
    try:
        subprocess.run(["powershell.exe", "-NoProfile", "-Command", "1"],
                       capture_output=True, timeout=5)
        return True
    except FileNotFoundError:
        return False


# ---------------------------------------------------------------------------
# Stealth detection — targeted .NET calls, no broad enumeration
# ---------------------------------------------------------------------------

def _ps_script(items: list[str], template: str) -> str:
    parts = []
    for item in items:
        parts.append(template.replace("__ITEM__", item).replace("__ITEM2__", item))
    return "$r=@();" + ";".join(parts) + ';if($r.Count){$r -join","}else{""}'


def dotnet_check_processes(names: list[str]) -> set[str]:
    script = _ps_script(names,
        'if([System.Diagnostics.Process]::GetProcessesByName("__ITEM__",".").Count){$r+="__ITEM2__"}'
    )
    out = powershell_encoded(script)
    return {p.strip().lower() for p in out.split(",") if p.strip()}


def dotnet_check_services(names: list[str]) -> set[str]:
    script = _ps_script(names,
        'try{$s=Get-Service "__ITEM__" -ErrorAction Stop;if($s.Status -eq"Running"){$r+="__ITEM2__"}}catch{}'
    )
    out = powershell_encoded(script)
    return {s.strip().lower() for s in out.split(",") if s.strip()}


def dotnet_check_registry(keys: list[str]) -> set[str]:
    parts = []
    for k in keys:
        parts.append(f'if(Test-Path "HKLM:\\{k}"){{$r+="HKLM:{k}"}}')
        parts.append(f'if(Test-Path "HKCU:\\{k}"){{$r+="HKCU:{k}"}}')
    script = "$r=@();" + ";".join(parts) + ';if($r.Count){$r -join","}else{""}'
    out = powershell_encoded(script)
    return {p.strip() for p in out.split(",") if p.strip()}


def dotnet_check_dirs(dirs: list[str]) -> set[str]:
    script = _ps_script(dirs,
        'if(Test-Path "__ITEM__"){$r+="__ITEM2__"}'
    )
    out = powershell_encoded(script)
