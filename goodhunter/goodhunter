ScanResult = dict[str, list[dict]]


def scan(stealth: bool = False, neutralize: bool = False) -> ScanResult:
    found: ScanResult = {"detected": [], "suspicious": [], "info": []}

    if not is_windows():
        ui.aviso("platform", f"{sys.platform} — no live detection available (Windows only)")
        print()
        ui.proximo("goodhunter list", "view the database:")
        print()
        return found

    if not has_powershell():
        ui.aviso("powershell", "PowerShell not found — cannot scan")
        return found

    if stealth:
        ui.modulo("goodhunter_stealth", "targeted .NET checks · no broad enumeration")
        procs = dotnet_check_processes(ALL_PROCESS_NAMES)
        svcs = dotnet_check_services(ALL_SERVICE_NAMES)
        reg = dotnet_check_registry(ALL_REGISTRY_KEYS)
        dirs_found = dotnet_check_dirs(list({d for t in DATABASE for d in t.install_dirs}))
        installed = set()
        startup = set()
    else:
        ui.modulo("goodhunter_scan", "broad enumeration · powershell")
        procs = normal_processes()
        svcs = normal_services()
        reg = normal_registry()
        installed = normal_installed()
        startup = normal_startup()
        dirs_found = normal_dirs()

    for tool in DATABASE:
        hits = []
        details = []

        for p in tool.processes:
            if p.lower() in procs:
                hits.append(f"process running: {p}")
                details.append({"type": "process", "value": p})

        for s in tool.services:
            if s.lower() in svcs:
                hits.append(f"service: {s}")
                details.append({"type": "service", "value": s})

        for alias in [tool.name] + tool.aliases:
            if alias.lower() in installed:
                hits.append(f"installed: {alias}")
                details.append({"type": "installed", "value": alias})
                break

        for rk in tool.registry:
            if rk in reg or f"HKCU:\\{rk}" in reg:
                hits.append(f"registry: {rk}")
                details.append({"type": "registry", "value": rk})

        for e in tool.startup_entries:
            if e.lower() in startup:
                hits.append(f"startup: {e}")
                details.append({"type": "startup", "value": e})

        for d in tool.install_dirs:
            if d in dirs_found:
                hits.append(f"directory: {d}")
                details.append({"type": "directory", "value": d})

        if not hits:
            continue

        entry = {
            "name": tool.name,
            "category": tool.category,
            "risk": tool.risk,
            "description": tool.description,
            "hits": hits,
            "details": details,
            "urls": tool.urls,
            "notes": tool.notes,
        }

        if tool.risk == "critical" or tool.category == "stalkerware":
            found["detected"].append(entry)
        elif tool.risk in ("high", "medium"):
            found["suspicious"].append(entry)
        else:
            found["info"].append(entry)

    if stealth:
        stealth_cleanup()

    has_anything = len(found["detected"]) + len(found["suspicious"]) + len(found["info"]) > 0
    if neutralize and has_anything:
        ui.ALERTA
        print()
        ui.modulo("neutralize_warning", "read carefully")
        print(f"  {ui.ALERTA}{'!' * (ui.cf - 4)}{ui.RESET}")
        print(f"  {ui.ALERTA}  WARNING{ui.RESET}")
        print(f"  {ui.FG40}  Killing/blocking corporate monitoring software WILL:{ui.RESET}")
        print(f"  {ui.FG40}  - Trigger an alert in the IT/SIEM dashboard{ui.RESET}")
        print(f"  {ui.FG40}  - Notify your employer that the agent died{ui.RESET}")
        print(f"  {ui.FG40}  - Log your action in Windows Security events{ui.RESET}")
        print(f"  {ui.FG40}  - Potentially result in termination{ui.RESET}")
        print(f"  {ui.ALERTA}{'!' * (ui.cf - 4)}{ui.RESET}")
        print()
        print(f"  {ui.ACC}Only proceed if:{ui.RESET}")
        print(f"  {ui.FG40}  1. This is your personal machine{ui.RESET}")
        print(f"  {ui.FG40}  2. You have explicit authorization{ui.RESET}")
        print(f"  {ui.FG40}  3. You understand the consequences{ui.RESET}")
        print()
        try:
            confirm = input(f"  {ui.ALERTA}> Type 'i understand' to continue: {ui.RESET}")
        except (EOFError, KeyboardInterrupt):
            confirm = ""
        print()
        if confirm.strip().lower() != "i understand":
            ui.aviso("aborted", "neutralize cancelled")
            return found
        for section in ("detected", "suspicious"):
            if found[section]:
                print()
                ui.secao("NEUTRALIZING")
                print()
                neutralize_all(found[section])

    if not stealth:
        report = {
            "timestamp": datetime.now().isoformat(),
            "platform": sys.platform,
            "hostname": os.uname().nodename,
            "found": found,
            "stats": {
                "total_database": len(DATABASE),
                "detected": len(found["detected"]),
                "suspicious": len(found["suspicious"]),
                "info": len(found["info"]),
            }
        }
        REPORT_FILE.parent.mkdir(parents=True, exist_ok=True)
        REPORT_FILE.write_text(json.dumps(report, ensure_ascii=False, indent=2))

    return found


