def print_scan_results(found: ScanResult, json_output: bool = False):
    if json_output:
        print(json.dumps(found, ensure_ascii=False, indent=2))
        return

    detected = found["detected"]
    suspicious = found["suspicious"]
    info = found["info"]
    total = len(detected) + len(suspicious) + len(info)

    print()
    if total == 0:
        ui.ok("nothing detected — no known monitoring software found")
        print()
        ui.proximo("goodhunter list", "view the database:")
        print()
        return

    if detected:
        ui.secao(f"DETECTED ({len(detected)}) — stalkerware / critical risk")
        print()
        for item in detected:
            _, color = RISK_COLORS.get(item["risk"], ("", ui.FG70))
            print(f"  {color}[!]{ui.RESET} {ui.ACC}{item['name']}{ui.RESET}")
            print(f"  {ui.FG40}{item['description']}{ui.RESET}")
            if item["notes"]:
                print(f"  {ui.FG40}  {item['notes']}{ui.RESET}")
            for h in item["hits"]:
                print(f"  {ui.ALERTA}>{ui.RESET} {ui.FG70}{h}{ui.RESET}")
            print()
    if suspicious:
        ui.secao(f"SUSPICIOUS ({len(suspicious)}) — corporate / high-medium risk")
        print()
        for item in suspicious:
            _, color = RISK_COLORS.get(item["risk"], ("", ui.FG70))
            print(f"  {color}[?]{ui.RESET} {ui.ACC}{item['name']}{ui.RESET}")
            for h in item["hits"]:
                print(f"  {ui.ALERTA}>{ui.RESET} {ui.FG70}{h}{ui.RESET}")
            print()
    if info:
        ui.secao(f"INFO ({len(info)}) — low risk / utility")
        print()
        for item in info:
            print(f"  {ui.FG70}{item['name']}{ui.RESET}")
            for h in item["hits"]:
                print(f"  {ui.FG40}>{ui.RESET} {ui.FG40}{h}{ui.RESET}")
            print()


def print_list(json_output: bool = False):
    if json_output:
        print(json.dumps([asdict(t) for t in DATABASE], ensure_ascii=False, indent=2))
        return
    by_cat: dict[str, list[ToolSignature]] = defaultdict(list)
    for t in DATABASE:
        by_cat[t.category].append(t)
    cat_labels = {
        "corporate": "Corporate Employee Monitoring", "stalkerware": "Stalkerware / Covert Spyware",
        "parental": "Parental Control", "os": "Operating System Telemetry",
        "security": "Security / EDR", "remote": "Remote Access",
        "utility": "Screen Recording / Utility",
    }
    ui.modulo("goodhunter_database", f"{len(DATABASE)} tools")
    print()
    for cat_key, label in cat_labels.items():
        tools = by_cat.get(cat_key, [])
        if not tools:
            continue
        icon = CATEGORY_ICONS.get(cat_key, "")
        ui.secao(f"{icon} {label} ({len(tools)})")
        for t in tools:
            badge, color = RISK_COLORS.get(t.risk, ("", ui.FG70))
            risk_str = f"[{badge.upper()}]" if badge else ""
            print(f"  {color}{risk_str}{ui.RESET} {ui.ACC}{t.name}{ui.RESET}")
            print(f"  {ui.FG40}{t.description}{ui.RESET}")
        print()


def print_category(name: str, json_output: bool = False):
    name_lower = name.lower().replace("-", "").replace("_", "")
    for t in DATABASE:
        if t.name.lower().replace("-", "").replace(" ", "") == name_lower:
            if json_output:
                print(json.dumps(asdict(t), ensure_ascii=False, indent=2))
                return
            badge, color = RISK_COLORS.get(t.risk, ("", ui.FG70))
            print()
            ui.modulo("goodhunter_tool", t.category)
            print(f"  {color}[{badge.upper()}]{ui.RESET} {ui.ACC}{t.name}{ui.RESET}")
            print(f"  {ui.FG40}{t.description}{ui.RESET}")
            print()
            if t.aliases:
                ui.kv("ALIASES", ", ".join(t.aliases))
            ui.kv("CATEGORY", t.category.upper())
            ui.kv("RISK", t.risk.upper())
            print()
            if t.processes:
                ui.secao("processes")
                for p in t.processes:
                    print(f"  {ui.FG70}{p}{ui.RESET}")
                print()
            if t.services:
                ui.secao("services")
                for s in t.services:
                    print(f"  {ui.FG70}{s}{ui.RESET}")
                print()
            if t.registry:
                ui.secao("registry")
                for r in t.registry:
                    print(f"  {ui.FG70}{r}{ui.RESET}")
                print()
            if t.install_dirs:
                ui.secao("install directories")
                for d in t.install_dirs:
                    print(f"  {ui.FG70}{d}{ui.RESET}")
                print()
            if t.startup_entries:
                ui.secao("startup entries")
                for e in t.startup_entries:
                    print(f"  {ui.FG70}{e}{ui.RESET}")
                print()
            if t.urls:
                ui.secao("urls / domains")
                for u in t.urls:
                    print(f"  {ui.FG70}{u}{ui.RESET}")
                print()
            if t.notes:
                ui.kv("NOTES", t.notes)
            print()
            return
    ui.aviso("404", f"tool '{name}' not found in database")
    ui.proximo("goodhunter list", "list all:")
    print()


def print_report(json_output: bool = False):
    if not REPORT_FILE.exists():
        ui.aviso("vazio", "no previous scan found. run 'goodhunter' first")
        print()
        return
    data = json.loads(REPORT_FILE.read_text())
    if json_output:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return
    ui.modulo("goodhunter_report", f"from: {data['timestamp']}")
    ui.kv("PLATFORM", data["platform"])
    ui.kv("HOSTNAME", data.get("hostname", "?"))
    ui.kv("DETECTED", str(data["stats"]["detected"]))
    ui.kv("SUSPICIOUS", str(data["stats"]["suspicious"]))
    ui.kv("INFO", str(data["stats"]["info"]))
    print()
    print_scan_results(data["found"])


def print_analyze(found: ScanResult, json_output: bool = False):
    all_items = found["detected"] + found["suspicious"] + found["info"]
    if not all_items:
        ui.aviso("vazio", "nothing to analyze")
        print()
        return
    if json_output:
        caps = {}
        for item in all_items:
            name = item["name"]
            for t in DATABASE:
                if t.name == name:
                    cap = {k: getattr(t, k) for k in dir(t)
                           if k.startswith("captures_") or k in ("has_watchdog", "detectable_kill")}
                    caps[name] = {k: v for k, v in cap.items() if v}
                    break
        print(json.dumps(caps, ensure_ascii=False, indent=2))
        return
    ui.modulo("goodhunter_analyze", "what each tool can see about you")
    print()
    for item in all_items:
        name = item["name"]
        tool = next((t for t in DATABASE if t.name == name), None)
        if not tool:
            continue
        _, color = RISK_COLORS.get(item["risk"], ("", ui.FG70))
        print(f"  {color}[{item['risk'].upper()}]{ui.RESET} {ui.ACC}{name}{ui.RESET}")
        caps = []
        if tool.captures_screen:
            caps.append(("screen", tool.captures_screen))
        if tool.captures_keystrokes:
            caps.append(("keystrokes", tool.captures_keystrokes))
        if tool.captures_audio:
            caps.append(("audio", tool.captures_audio))
        if tool.captures_webcam:
            caps.append(("webcam", tool.captures_webcam))
        if tool.captures_apps:
            caps.append(("apps", tool.captures_apps))
        if tool.captures_web:
            caps.append(("browsing", tool.captures_web))
        if tool.captures_email:
            caps.append(("email", tool.captures_email))
        if tool.captures_chat:
            caps.append(("chat", tool.captures_chat))
        if tool.captures_clipboard:
            caps.append(("clipboard", tool.captures_clipboard))
        if tool.captures_files:
            caps.append(("files", tool.captures_files))
        if tool.captures_gps:
            caps.append(("GPS", tool.captures_gps))
        print(f"  {ui.FG40}{'─' * 30}{ui.RESET}")
        for label, detail in caps:
            print(f"  {ui.ALERTA}◼{ui.RESET} {ui.FG70}{label:<12}{ui.RESET} {ui.FG40}{detail}{ui.RESET}")
        if not caps:
            print(f"  {ui.FG40}  (no specific capability data){ui.RESET}")
        print(f"  {ui.FG40}  watchdog: {'YES' if tool.has_watchdog else 'no'}  ·  kill alert: {'YES' if tool.detectable_kill else 'no'}{ui.RESET}")
        print()
    print()
    ui.secao("what this means")
    print(f"  {ui.FG40}If a tool captures keystrokes, everything you type is visible{ui.RESET}")
    print(f"  {ui.FG40}If a tool captures screen, anything on your monitor is recorded{ui.RESET}")
    print(f"  {ui.FG40}Killing these processes{' WILL ' if any(t.detectable_kill for t in DATABASE if t.name in [i['name'] for i in all_items]) else ' MAY '}trigger an alert{ui.RESET}")
    print()


