# Main
# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(prog="goodhunter", add_help=False)
    ap.add_argument("command", nargs="?", help="scan | list | report | cat | help")
    ap.add_argument("param", nargs="?", help="tool name for cat")
    ap.add_argument("--stealth", action="store_true", help="stealth mode — targeted .NET calls")
    ap.add_argument("--neutralize", action="store_true", help="kill/stop/block detected software")
    ap.add_argument("--portable", nargs="?", const=".", help="generate standalone .ps1 to DIR")
    ap.add_argument("--json", action="store_true", help="JSON output")
    ap.add_argument("-h", "--help", action="store_true", help="show help")
    args = ap.parse_args()

    if args.help or (args.command or "").lower() in ("help", "ajuda"):
        uso()
        return

    json_output = args.json or os.environ.get("GOODHUNTER_JSON") == "1"
    cmd = (args.command or "").lower()

    if args.portable:
        path = generate_portable(args.portable)
        print()
        ui.modulo("goodhunter_portable", "standalone .ps1 generated")
        ui.kv("FILE", path)
        ui.kv("USAGE", "copy to USB > run on target Windows machine > double-click")
        print()
        ui.proximo(f"cp '{path}' /Volumes/USB/", "copy to USB:")
        print()
        return

    if cmd == "list":
        print_list(json_output)
        return
    if cmd == "report":
        print_report(json_output)
        return
    if cmd in ("cat", "tool", "info"):
        if args.param:
            print_category(args.param, json_output)
        else:
            ui.aviso("param", "specify a tool name:  goodhunter cat <name>")
        return
    if cmd == "analyze":
        if not REPORT_FILE.exists():
            ui.aviso("vazio", "no scan data. run 'goodhunter' first")
            return
        data = json.loads(REPORT_FILE.read_text())
        print_analyze(data["found"], json_output)
        return
    if cmd == "block":
        if not REPORT_FILE.exists():
            ui.aviso("vazio", "no scan data. run 'goodhunter' first")
            return
        data = json.loads(REPORT_FILE.read_text())
        all_items = data["found"]["detected"] + data["found"]["suspicious"]
        if not all_items:
            ui.aviso("vazio", "nothing to block")
            return
        print()
        ui.secao("BLOCKING C2 DOMAINS")
        print(f"  {ui.FG40}Adding entries to hosts file. This prevents data exfiltration{ui.RESET}")
        print(f"  {ui.FG40}without killing the process (no heartbeat alert).{ui.RESET}")
        print()
        block_domains(all_items)
        return
    if cmd == "evade":
        script = generate_evade_script()
        path = str(Path.cwd() / "GoodHunter_Evade.ps1")
        Path(path).write_text(script, encoding="utf-8")
        print()
        ui.modulo("goodhunter_evade", "fake activity generator")
        ui.kv("FILE", path)
        print()
        print(f"  {ui.FG40}On your Windows machine, run in a HIDDEN window:{ui.RESET}")
        print(f"  {ui.ACC}  powershell -WindowStyle Hidden -File \"{path}\"{ui.RESET}")
        print()
        print(f"  {ui.FG40}What it does:{ui.RESET}")
        print(f"  {ui.FG40}  - Moves the mouse randomly every 15-90s{ui.RESET}")
        print(f"  {ui.FG40}  - Types work-related words in a hidden Notepad{ui.RESET}")
        print(f"  {ui.FG40}  - Opens/closes Outlook, Excel, Chrome periodically{ui.RESET}")
        print(f"  {ui.FG40}  - Keeps your status 'active' in productivity reports{ui.RESET}")
        print()
        return
    if cmd == "firewall":
        script = generate_firewall_script()
        path = str(Path.cwd() / "GoodHunter_Firewall.ps1")
        Path(path).write_text(script, encoding="utf-8")
        print()
        ui.modulo("goodhunter_firewall", "block monitoring processes from internet")
        ui.kv("FILE", path)
        print()
        print(f"  {ui.FG40}On your Windows machine, run AS ADMIN:{ui.RESET}")
        print(f"  {ui.ACC}  powershell -File \"{path}\"{ui.RESET}")
        print()
        print(f"  {ui.FG40}What it does:{ui.RESET}")
        print(f"  {ui.FG40}  - Creates Windows Firewall OUTBOUND rules for each detected tool{ui.RESET}")
        print(f"  {ui.FG40}  - The process still runs (no heartbeat alert = safe){ui.RESET}")
        print(f"  {ui.FG40}  - Data is captured locally but CANNOT be sent to the server{ui.RESET}")
        print()
        return
    if cmd == "shield":
        script = generate_shield_script()
        path = str(Path.cwd() / "GoodHunter_Shield.ps1")
        Path(path).write_text(script, encoding="utf-8")
        print()
        ui.modulo("goodhunter_shield", "transparent overlay blocks screenshots")
        ui.kv("FILE", path)
        print()
        print(f"  {ui.FG40}On your Windows machine, run:{ui.RESET}")
        print(f"  {ui.ACC}  powershell -File \"{path}\"{ui.RESET}")
        print()
        print(f"  {ui.FG40}How it works:{ui.RESET}")
        print(f"  {ui.FG40}  - Opens a transparent fullscreen window on TOP of everything{ui.RESET}")
        print(f"  {ui.FG40}  - Press Alt+Shift+S to toggle shield ON (solid white){ui.RESET}")
        print(f"  {ui.FG40}  - Press Alt+Shift+S to toggle shield OFF (transparent){ui.RESET}")
        print(f"  {ui.FG40}  - Does NOT block mouse/keyboard — you work normally underneath{ui.RESET}")
        print(f"  {ui.FG40}  - Screenshots capture ONLY the shield color, not your work{ui.RESET}")
        print()
        return
    if cmd == "watch":
        script = generate_watch_script()
        path = str(Path.cwd() / "GoodHunter_Watch.ps1")
        Path(path).write_text(script, encoding="utf-8")
        print()
        ui.modulo("goodhunter_watch", "real-time surveillance monitor")
        ui.kv("FILE", path)
        print()
        print(f"  {ui.FG40}On your Windows machine, run:{ui.RESET}")
        print(f"  {ui.ACC}  powershell -File \"{path}\"{ui.RESET}")
        print()
        print(f"  {ui.FG40}Monitors in real-time:{ui.RESET}")
        print(f"  {ui.FG40}  - Known monitoring processes starting{ui.RESET}")
        print(f"  {ui.FG40}  - Webcam activation{ui.RESET}")
        print(f"  {ui.FG40}  - Network connections to C2 servers{ui.RESET}")
        print(f"  {ui.FG40}  - Press Q to quit{ui.RESET}")
        print()
        return

    if cmd and cmd not in ("scan", ""):
        print(f"goodhunter: unknown command '{cmd}' (see goodhunter --help)", file=sys.stderr)
        sys.exit(1)

    found = scan(stealth=args.stealth, neutralize=args.neutralize)
    print_scan_results(found, json_output)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        ui.aviso("interrupted")
        sys.exit(130)
