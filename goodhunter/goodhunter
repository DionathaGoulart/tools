# Normal detection — broad enumeration
# ---------------------------------------------------------------------------

def normal_processes() -> set[str]:
    out = powershell("Get-Process | Select-Object -ExpandProperty Name")
    running = set()
    for line in out.splitlines():
        name = line.strip().lower()
        if name:
            running.add(name.replace(".exe", "") + ".exe")
    return running


def normal_services() -> set[str]:
    out = powershell("Get-Service | Select-Object -ExpandProperty Name")
    return {line.strip().lower() for line in out.splitlines() if line.strip()}


def normal_installed() -> set[str]:
    names = set()
    out = powershell(
        "Get-ItemProperty HKLM:\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | "
        "Select-Object -ExpandProperty DisplayName -ErrorAction SilentlyContinue"
    )
    for line in out.splitlines():
        n = line.strip().lower()
        if n:
            names.add(n)
    out64 = powershell(
        "Get-ItemProperty HKLM:\\Software\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\* | "
        "Select-Object -ExpandProperty DisplayName -ErrorAction SilentlyContinue"
    )
    for line in out64.splitlines():
        n = line.strip().lower()
        if n:
            names.add(n)
    return names


def normal_registry() -> set[str]:
    keys = set()
    for k in ALL_REGISTRY_KEYS:
        out = powershell(f"Test-Path 'HKLM:\\{k}'")
        if "True" in out:
            keys.add(k)
        out2 = powershell(f"Test-Path 'HKCU:\\{k}'")
        if "True" in out2:
            keys.add(f"HKCU:\\{k}")
    return keys


def normal_startup() -> set[str]:
    out = powershell(
        "Get-CimInstance Win32_StartupCommand | Select-Object -ExpandProperty Name -ErrorAction SilentlyContinue"
    )
    return {line.strip().lower() for line in out.splitlines() if line.strip()}


def normal_dirs() -> set[str]:
    found = set()
    for d in list({d for t in DATABASE for d in t.install_dirs}):
        out = powershell(f"Test-Path '{d}'")
        if "True" in out:
            found.add(d)
    return found


# ---------------------------------------------------------------------------
# Neutralize — kill/stop/block
# ---------------------------------------------------------------------------

def neutralize_process(name: str) -> str:
    out = powershell(
        f"Stop-Process -Name '{name.replace('.exe','')}' -Force -ErrorAction SilentlyContinue; "
        f"if($?){{'OK'}}else{{'FAIL'}}"
    )
    return "OK" if "OK" in out else "FAIL"


def neutralize_service(name: str) -> str:
    out = powershell(
        f"Stop-Service '{name}' -Force -ErrorAction SilentlyContinue; "
        f"Set-Service '{name}' -StartupType Disabled -ErrorAction SilentlyContinue; "
        f"if($?){{'OK'}}else{{'FAIL'}}"
    )
    return "OK" if "OK" in out else "FAIL"


def neutralize_domain(domain: str) -> str:
    hosts = os.environ.get("SystemRoot", r"C:\Windows") + r"\System32\drivers\etc\hosts"
    entry = f"0.0.0.0 {domain}"
    try:
        with open(hosts, "r") as f:
            content = f.read()
        if domain in content:
            return "ALREADY_BLOCKED"
        with open(hosts, "a") as f:
            f.write(f"\n# blocked by goodhunter\n{entry}\n")
        return "OK"
    except PermissionError:
        return "NO_ADMIN"
    except Exception as e:
        return f"FAIL:{e}"


def block_domains(items: list[dict]) -> dict:
    results = {}
    for item in items:
        name = item["name"]
        for domain in item.get("urls", []):
            r = neutralize_domain(domain)
            results[domain] = r
            if r == "OK":
                ui.ok(f"blocked {domain} via hosts ({name})")
            elif r == "ALREADY_BLOCKED":
                ui.ok(f"{domain} already blocked ({name})")
            elif r == "NO_ADMIN":
                ui.aviso("admin", f"need admin to block {domain}")
    return results


