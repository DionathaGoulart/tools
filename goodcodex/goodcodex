#!/usr/bin/env python3
"""Entrypoint for the goodcodex CLI."""

import argparse
import json
from pathlib import Path
import subprocess
import sys

from core.scanner import discover
from core.context import project_for, resolve
from core.doctor import diagnose
from core.render import render
from core.install import change, status
from core.recommend import recommend, command as launch_command
from core.evaluation import add as add_evaluation, report as evaluation_report
from core.store import StateError, config_dir, data_dir, load, save, selected


def _output(value, as_json):
    if as_json:
        print(json.dumps(value, ensure_ascii=False, indent=2))
    elif isinstance(value, dict) and "projects" in value:
        for project in value["projects"]:
            stacks = sorted({stack for package in project["packages"] for stack in package["stack"]})
            print(f'{project["id"]}  {project["group"]}  {project["realm"]}  {project["root"]}  {", ".join(stacks) or "sem stack detectada"}')
        for issue in value.get("issues", []):
            print(f'Aviso: {issue["reason"]}: {issue["path"]}', file=sys.stderr)
    else:
        print(f'{value["id"]}  {value["root"]}')
        print(f'Grupo: {value["group"]}; ambiente: {value["realm"]}; branch: {value.get("branch") or "desconhecida"}')
        for package in value["packages"]:
            print(f'Pacote {package["path"]}: {", ".join(package["stack"])}; comandos: {", ".join(package["commands"])}')
        for source in value["contextSources"]:
            print(f'Contexto {source["kind"]}: {source["path"]}')
        for issue in value.get("issues", []):
            print(f'Aviso {issue["reason"]}: {issue["path"]}')
        if value.get("override"):
            print(f'Override: {json.dumps(value["override"], ensure_ascii=False)}')


def main(argv=None):
    if sys.version_info < (3, 11):
        print("goodcodex requer Python 3.11 ou superior.", file=sys.stderr)
        return 2
    parser = argparse.ArgumentParser(
        prog="goodcodex",
        description="Descobre projetos e contexto local para o Codex.",
        epilog="scan lê projetos sem alterá-los; o registro é salvo no diretório XDG de dados.",
    )
    parser.add_argument("--version", action="version", version="goodcodex 0.2.0-dev")
    parser.add_argument("--json", action="store_true", help="saída JSON")
    commands = parser.add_subparsers(dest="command", metavar="comando")
    commands.add_parser("help", help="mostra esta ajuda")
    commands.add_parser("temas", help="mostra as paletas compartilhadas da família tools")
    evaluation = commands.add_parser("evaluate", help="registra medição opcional e resume resultados locais")
    evaluation.add_argument("action", choices=["add", "report"], help="add recebe arquivo JSON; report lê registros locais")
    evaluation.add_argument("file", nargs="?", help="arquivo JSON de medição para add")
    evaluation.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    scan = commands.add_parser("scan", help="descobre projetos e atualiza o registro local")
    scan.add_argument("--root", action="append", default=[], metavar="PATH", help="raiz para varredura; repetível")
    scan.add_argument("--realm", choices=["personal", "work"], default="personal", help="ambiente das raízes passadas por --root")
    scan.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    projects = commands.add_parser("projects", help="lista projetos registrados")
    projects.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    inspect = commands.add_parser("inspect", help="mostra evidências do projeto registrado")
    inspect.add_argument("path", nargs="?", default=".", help="caminho ou id de projeto")
    inspect.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    context = commands.add_parser("context", help="resolve fontes aplicáveis ao caminho/pacote")
    context.add_argument("path", nargs="?", default=".", help="caminho ou id de projeto")
    context.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    doctor = commands.add_parser("doctor", help="diagnostica CLI, configurações e contexto")
    doctor.add_argument("path", nargs="?", help="caminho ou id de projeto; sem argumento, somente CLI")
    doctor.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    plan = commands.add_parser("plan", help="mostra arquivos Codex propostos, diff e política de modelos sem gravar")
    plan.add_argument("path", nargs="?", help="caminho ou id de projeto; sem argumento, somente configuração global")
    plan.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
    for name, description in (("recommend", "recomenda modelo e esforço para uma tarefa"), ("explain", "explica a escolha e a configuração efetiva"), ("run", "inicia sessão Codex com a escolha exibida")):
        candidate = commands.add_parser(name, help=description)
        if name == "explain":
            candidate.add_argument("path", nargs="?", default=".", help="caminho ou id de projeto registrado")
            candidate.add_argument("--task", help="tarefa opcional para classificação específica")
        else:
            candidate.add_argument("task", help="texto literal da tarefa")
            candidate.add_argument("--path", default=".", help="caminho ou id de projeto registrado")
        candidate.add_argument("--model", help="ID exato do modelo para esta sessão")
        candidate.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
        if name == "run":
            candidate.add_argument("--dry-run", action="store_true", help="mostra argv sem iniciar Codex")
    for name, description in (("apply", "instala arquivos nativos gerenciados"), ("update", "atualiza arquivos gerenciados"), ("rollback", "restaura arquivos anteriores"), ("status", "mostra estado da instalação")):
        command = commands.add_parser(name, help=description)
        command.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="saída JSON")
        if name == "apply":
            command.add_argument("--replace", action="store_true", help="substitui arquivos existentes após backup")
    args = parser.parse_args(argv)
    if args.command is None or args.command == "help":
        parser.print_help()
        return 0
    if args.command == "temas":
        return subprocess.call(["bash", str(Path(__file__).resolve().parents[1] / "goodhelp" / "goodhelp"), "temas"])
    try:
        registry_path = data_dir() / "registry.json"
        if args.command == "evaluate":
            if (args.action == "add") != (args.file is not None):
                parser.error("evaluate add exige arquivo JSON; evaluate report não aceita arquivo")
            result = add_evaluation(Path(args.file)) if args.action == "add" else evaluation_report()
            if args.json:
                _output(result, True)
            elif args.action == "add":
                print(f'Registro local: {result["id"]}; caso {result["caseId"]}; variante {result["variant"]}')
            else:
                for variant, summary in result["groups"].items():
                    print(f'{variant}: {summary["runs"]} execuções; {summary["passed"]} pass declarados; '
                          f'tempo={summary["elapsedSeconds"] if summary["elapsedSeconds"] is not None else "não medido"}; '
                          f'tokens de entrada={summary["inputTokens"] if summary["inputTokens"] is not None else "não medido"}; '
                          f'tokens de saída={summary["outputTokens"] if summary["outputTokens"] is not None else "não medido"}')
                print(f'Casos pareados: {len(result["pairedCases"])}')
        elif args.command == "scan":
            preferences = load(config_dir() / "preferences.json", {"schemaVersion": 1, "roots": []})
            roots = ([{"path": root, "realm": args.realm} for root in args.root]
                     if args.root else preferences.get("roots") or [{"path": str(Path.cwd()), "realm": "personal"}])
            load(registry_path, {"schemaVersion": 1, "projects": []})
            result = discover(roots)
            save(registry_path, result)
            _output(result, args.json)
        elif args.command == "doctor" and args.path is None:
            result = diagnose()
            if args.json:
                _output(result, True)
            else:
                _diagnostic_output(result)
        elif args.command == "plan" and args.path is None:
            result = render()
            _plan_output(result, args.json)
        elif args.command in ("apply", "update", "rollback", "status"):
            result = status() if args.command == "status" else change(args.command, replace=getattr(args, "replace", False))
            if args.json:
                _output(result, True)
            elif args.command == "status":
                print("Instalação gerenciada: " + ("sim" if result["installed"] else "não"))
                if result["interrupted"]:
                    print("Aviso: operação anterior interrompida; próximo comando de escrita tentará recuperá-la.")
                for item in result["files"]:
                    print(f'{item["state"]}: {item["path"]}')
            else:
                print(result["message"])
                for path in result["changed"]:
                    print(path)
        else:
            registry = load(registry_path, {"schemaVersion": 1, "projects": []})
            overrides = load(config_dir() / "overrides.json", {"schemaVersion": 1, "projects": []})
            if args.command == "projects":
                _output({"schemaVersion": 1, "projects": [selected(project, overrides) for project in registry["projects"]], "issues": registry.get("issues", [])}, args.json)
            else:
                match, target = project_for(registry, args.path)
                match = selected(match, overrides)
                if args.command == "inspect":
                    _output(match, args.json)
                elif args.command == "context":
                    result = resolve(match, target)
                    if args.json:
                        _output(result, True)
                    else:
                        print(f'Projeto: {result["root"]} ({result["realm"]}); alvo: {result["target"]}')
                        print(f'Pacote: {result["package"]["path"] if result["package"] else "não detectado"}')
                        for source in result["sources"]:
                            print(f'{source["kind"]} [{source["role"]}]: {source["path"]} -> {source["canonicalTarget"]}')
                        for issue in result["issues"]:
                            print(f'Aviso: {issue["reason"]}: {issue["path"]}. {issue["action"]}')
                elif args.command == "plan":
                    _plan_output(render(match, target), args.json)
                elif args.command in ("recommend", "explain", "run"):
                    preferences = load(config_dir() / "preferences.json", {"schemaVersion": 1, "mode": "balanced", "roots": []})
                    result = recommend(args.task if args.command != "explain" else args.task or "tarefa não especificada", match, target, preferences, model=args.model)
                    if args.command == "run":
                        result["argv"] = launch_command(result)
                    if args.json:
                        _output(result, True)
                    else:
                        print(f'Projeto: {result["projectId"]}; alvo: {result["target"]}')
                        print(f'Modelo: {result["effective"]["model"]}; esforço: {result["effective"]["effort"]}; origem: CLI override')
                        print("Motivo: " + "; ".join(result["recommendation"]["reasons"]))
                        print("Disponibilidade: " + result["availability"])
                        if args.command in ("explain", "run"):
                            for layer in result["configuration"]:
                                print(f'Camada {layer["scope"]}: {layer["path"]}; modelo={layer["model"]}; esforço={layer["effort"]}')
                            for issue in result["issues"]:
                                print(f'Aviso: {issue}')
                        if args.command == "run":
                            print("argv: " + json.dumps(result["argv"], ensure_ascii=False))
                    if args.command == "run" and not args.dry_run:
                        return subprocess.call(result["argv"])
                else:
                    result = diagnose(match, target)
                    if args.json:
                        _output(result, True)
                    else:
                        _diagnostic_output(result)
    except (StateError, OSError, KeyError) as exc:
        print(f"goodcodex: {exc}", file=sys.stderr)
        return 1
    return 0


def _diagnostic_output(result):
    codex = result["codex"]
    print(f'Codex: {codex["version"] or "não detectado"}')
    print("Capacidades: " + (", ".join(f'{name}={"sim" if enabled else "não"}' for name, enabled in codex["capabilities"].items()) or "não verificadas"))
    for config in result["configuration"]:
        print(f'Configuração {config["scope"]}: {config["path"]}; modelo={config["model"] or "não definido"}; esforço={config["effort"] or "não definido"}')
    if result["context"]:
        print(f'Contexto: {result["context"]["root"]}; {len(result["context"]["sources"])} fontes aplicáveis')
    for issue in result["issues"]:
        print(f'Aviso: {issue["reason"]}: {issue.get("path", "CLI")}. {issue["action"]}')
    for uncertainty in codex["uncertainties"]:
        print(f'Incerteza: {uncertainty}')
    for surface, details in result["surfaces"].items():
        print(f'Superfície {surface}: {details["status"]}. {details["detail"]}')


def _plan_output(result, as_json):
    if as_json:
        _output(result, True)
        return
    print("Preview somente leitura; nenhum arquivo foi alterado.")
    if result["projectId"]:
        print(f'Projeto: {result["projectId"]}; alvo: {result["target"]}')
        print("Presets: " + (", ".join(result["presets"]) or "nenhum"))
        for name, content in result["presetInstructions"].items():
            print(f'\nPreset {name}:\n{content}', end="" if content.endswith("\n") else "\n")
    for file in result["files"]:
        print(f'\n{file["status"]} [{file["applyAction"]}]: {file["path"]}')
        if file["diff"]:
            print(file["diff"], end="")
    print("\nPolítica de modelos (sem flags CLI):")
    for name, values in result["modelPolicy"].items():
        model = values["model"]
        effort = values["model_reasoning_effort"]
        print(f'{name}: {model["value"]} [{model["source"]}], {effort["value"]} [{effort["source"]}]')
    for issue in result["issues"]:
        print(f'Aviso: {issue if isinstance(issue, str) else issue["reason"]}')
    print(f'Fluxo de subagentes: até {result["delegation"]["suggestedConcurrentSubagents"]} simultâneos ao selecionar um perfil gc; principal integra os resultados.')


if __name__ == "__main__":
    sys.exit(main())
