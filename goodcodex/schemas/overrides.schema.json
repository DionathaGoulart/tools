{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodcodex.local/schemas/overrides.schema.json",
  "title": "goodcodex manual overrides v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId"],
        "properties": {
          "projectId": {"type": "string", "minLength": 1},
          "sensitivity": {"enum": ["normal", "private", "restricted"]},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "relatedProjects": {"type": "array", "items": {"type": "string"}},
          "enabledRoles": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
