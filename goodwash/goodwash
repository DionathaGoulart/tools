def main():
    ap = argparse.ArgumentParser(
        prog="goodwash",
        description="Reescreve texto pra soar humano e destruir a assinatura "
                    "estatística da watermark de IA (lista verde/vermelha).",
        epilog="exemplos:  echo \"<texto>\" | goodwash   ·   goodwash arquivo.txt   ·   "
               "goodwash profunda \"seu texto\"   ·   goodwash checar \"texto\"",
        add_help=False,
    )
    ap.add_argument("comando", nargs="?", default="lavar",
                    help="lavar (padrão): reescreve · checar: tells de IA (offline) · "
                         "temas: paletas · ou texto/arquivo direto pra reescrever")
    ap.add_argument("resto", nargs="*", help="intensidade (leve|media|profunda) e/ou texto")
    ap.add_argument("-o", "--saida", default="", help="salva a reescrita em arquivo")
    ap.add_argument("--arquivo", default="", help="lê o texto de um arquivo")
    ap.add_argument("-m", "--modelos", action="store_true",
                    help="lista modelos :free disponíveis")
    ap.add_argument("-h", "--help", action="store_true", help="mostra esta ajuda")
    args = ap.parse_args()

    if args.help or args.comando == "help":
        uso()
        return

    if args.modelos:
        listar_modelos_free()
        return

    if args.comando == "temas":
        ui.catalogo_temas()
        return

    # comando que não é verbo reservado já é parte do texto de lavar (ex.:
    # `goodwash "seu texto"`, `goodwash profunda "texto"`, `goodwash arquivo.txt`).
    if args.comando in VERBOS:
        comando, resto = args.comando, args.resto
    else:
        comando, resto = "lavar", [args.comando, *args.resto]

    if comando == "checar":
        _, texto = ler_entrada(args, resto)
        cmd_checar(texto)
        return

    intensidade, texto = ler_entrada(args, resto)
    cmd_lavar(intensidade, texto, args.saida)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        ui.aviso("interrompido")
        print()
        sys.exit(130)
