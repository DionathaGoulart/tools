def ler_entrada(args, resto):
    """Texto de: argumento → --arquivo → stdin. `leve|media|profunda` como 1º
    argumento vira intensidade.

    `--arquivo` vem ANTES do stdin de propósito: fora de um terminal (cron, CI,
    plugin de editor, `xargs`) o stdin nunca é tty, então checar o stdin antes
    engolia a flag e o comando morria com "não recebi texto".
    """
    intensidade = "media"
    partes = list(resto)
    if partes and partes[0] in INTENSIDADES:
        intensidade = partes.pop(0)
    if not partes:
        if args.arquivo:
            caminho = Path(args.arquivo).expanduser()
            if caminho.exists():
                return intensidade, caminho.read_text(encoding="utf-8").strip()
            die(f"arquivo não encontrado: {args.arquivo}")
        if not sys.stdin.isatty():
            return intensidade, sys.stdin.read().strip()
        return intensidade, ""
    if len(partes) == 1:
        caminho = Path(partes[0]).expanduser()
        if caminho.exists():
            return intensidade, caminho.read_text(encoding="utf-8").strip()
    return intensidade, " ".join(partes).strip()


def sem_acento(texto):
    """Dobra acento pra base ASCII: 'além' → 'alem'. Sem isso, texto digitado
    sem acento ('alem disso') escapava inteiro da heurística."""
    return "".join(c for c in unicodedata.normalize("NFD", texto)
                   if not unicodedata.combining(c))


def normalizar(texto):
    """Devolve ``(norm, offsets)``.

    ``norm`` é ``" palavra palavra … "``: minúsculo, sem acento, com pontuação e
    QUALQUER espaçamento (inclusive quebra de linha e espaço duplo) reduzidos a
    um espaço único. ``offsets[i]`` é o índice em ``texto`` onde começa a
    palavra que contém ``norm[i]``, pra recortar o contexto original.

    É isso que permite achar uma fórmula que no original está quebrada entre
    duas linhas ("além\\ndisso") ou colada numa vírgula.
    """
    norm, offsets = [" "], [0]
    for m in re.finditer(r"\w+", texto):
        for ch in sem_acento(m.group(0).lower()):
            norm.append(ch)
            offsets.append(m.start())
        norm.append(" ")
        offsets.append(m.end())
    return "".join(norm), offsets


def normalizar_leve(texto):
    """Minúsculo, sem acento, espaçamento colapsado — mas COM a pontuação. As
    regex estruturais (tríade, correlativo, voz passiva) precisam da vírgula,
    que o `normalizar` apaga."""
    return re.sub(r"\s+", " ", sem_acento(texto.lower()))


def normalizar_termo(termo):
    """Passa uma entrada das listas pelo mesmo moedor que o texto, pra que
    'game-changer' e "it's important to note" (que viravam entradas mortas
    quando a pontuação sumia só de um lado) voltem a casar."""
    return " ".join(re.findall(r"\w+", sem_acento(termo.lower())))


def _flexao(palavra):
    """Regex da palavra tolerando o plural/advérbio em PT — sem isso
    'fundamentais', 'cruciais' e 'ecossistemas' passavam batido."""
    if palavra.endswith("l"):
        return re.escape(palavra[:-1]) + "(?:l|is|lmente)"
    if palavra.endswith("ao"):                       # 'ão' depois do fold
        return re.escape(palavra[:-2]) + "(?:ao|oes|aos|aes)"
    if palavra.endswith("m"):
        return re.escape(palavra[:-1]) + "(?:m|ns)"
    if palavra.endswith(("r", "s", "z")):
        return re.escape(palavra) + "(?:es)?"
    return re.escape(palavra) + "s?"


def _re_buzz(termo):
    """Regex de um termo batido: palavras exatas, com flexão só na última."""
    palavras = normalizar_termo(termo).split()
    corpo = " ".join([re.escape(p) for p in palavras[:-1]] + [_flexao(palavras[-1])])
    return re.compile(r"(?<= )" + corpo + r"(?= )")


