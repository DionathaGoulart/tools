ESCALADA = {"leve": "media", "media": "profunda", "profunda": "profunda"}


def _reescrever(intensidade, texto):
    """Uma passada de reescrita. Devolve ``(texto_limpo, model, truncado)``."""
    # ~2.6 tokens por palavra em PT-BR com folga pra reescrita mais longa que o
    # original. Antes era um teto fixo de 3200, que cortava texto grande no meio
    # e ainda assim imprimia (e gravava com -o) como se tivesse dado certo.
    teto = min(16000, max(1200, int(len(texto.split()) * 2.6) + 400))
    result, model = chamar_llm(
        [{"role": "system", "content": sys_lavar(intensidade)},
         {"role": "user", "content": texto}],
        max_tokens=teto, temperature=0.8)
    return limpar_saida(result), model, _llm.last_finish_reason == "length"


def cmd_lavar(intensidade, texto, saida, ate=None, tentativas=1):
    if not texto:
        die("não recebi texto. Use:  goodwash \"seu texto\"  |  goodwash arquivo.txt  |"
            "  echo \"texto\" | goodwash")
    palavras = len(texto.split())
    antes = avaliar_texto(texto)

    # loop de auto-avaliação: reescreve, mede o próprio resultado e insiste com a
    # intensidade escalada enquanto não bater a meta. Fica na melhor tentativa.
    atual, alvo = intensidade, (ate if ate is not None else 0)
    melhor = melhor_aval = melhor_model = None
    truncado = False
    for volta in range(1, max(1, tentativas) + 1):
        nota(f"reescrevendo ({atual}, ~{palavras} palavras"
             + (f", tentativa {volta}/{tentativas}" if tentativas > 1 else "") + ")…")
        result, model, cortou = _reescrever(atual, texto)
        aval = avaliar_texto(result)
        if melhor is None or aval["score_autoria"] < melhor_aval["score_autoria"]:
            melhor, melhor_aval, melhor_model, truncado = result, aval, model, cortou
        if melhor_aval["score_autoria"] <= alvo:
            break
        if volta < tentativas:
            nota(f"score {aval['score_autoria']} acima da meta {alvo} — "
                 f"subindo pra {ESCALADA[atual]}")
            atual = ESCALADA[atual]
    result, depois, model = melhor, melhor_aval, melhor_model

    ui.modulo("goodwash", f"lavado · model: {model} · intensidade: {atual}")
    ui.kv("ENTRADA", f"{palavras} PALAVRAS")
    ui.kv("SAIDA", f"{len(result.split())} PALAVRAS")
    print()
    ui.secao("auto-avaliação: antes -> depois")
    _delta("CARA DE IA (0-100)", antes["score_autoria"], depois["score_autoria"])
    _delta("FORMULAS/100 PALAVRAS", antes["dens_formulas"], depois["dens_formulas"], 1)
    _delta("PALAVRAS BATIDAS", len(antes["buzz"]), len(depois["buzz"]))
    _delta("PARALELISMO/TRIADE", antes["paralelismos"], depois["paralelismos"])
    _delta("VOZ PASSIVA", antes["passivas"], depois["passivas"])
    _delta("MARCAS HUMANAS", antes["marcas_humanas"], depois["marcas_humanas"],
           menor_melhor=False)
    if antes["cv"] is not None and depois["cv"] is not None:
        _delta("VARIACAO DE RITMO (CV)", antes["cv"], depois["cv"], 2, menor_melhor=False)
    ui.kv("VEREDITO", f"{antes['veredito_autoria']} -> {depois['veredito_autoria']}")
    print()
    # honestidade: o delta é Goodhart por construção — a reescrita ataca
    # exatamente os eixos que o score mede. Cair é o esperado, não uma prova.
    nota("o delta mede os mesmos eixos que a reescrita ataca — cair é esperado e "
         "não vale como aprovação em detector externo (GPTZero, Turnitin).")
    for bloco in result.split("\n"):
        print(f"  {bloco}" if bloco.strip() else "")
    print()
    if truncado:
        ui.aviso("truncado", "o modelo bateu o teto de tokens e a reescrita foi "
                             "cortada. Divida o texto em partes menores.")
        print()
    if ate is not None and depois["score_autoria"] > ate:
        ui.aviso("meta não batida", f"parei em {depois['score_autoria']} depois de "
                                    f"{tentativas} tentativa(s); a meta era {ate}. "
                                    "Aumente --tentativas ou edite na mão.")
        print()
    elif depois["score_autoria"] >= antes["score_autoria"]:
        ui.aviso("sem ganho", "a reescrita não reduziu os tells de estilo. Tente "
                              "`goodwash profunda` ou `--ate 30 --tentativas 3`.")
        print()
    if saida:
        caminho = Path(saida).expanduser()
        caminho.parent.mkdir(parents=True, exist_ok=True)
        caminho.write_text(result.strip() + "\n", encoding="utf-8")
