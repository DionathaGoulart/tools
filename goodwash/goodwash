#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
goodwash — reescreve texto pra soar humano e sair da marca d'água estatística da IA.

A watermark "lista verde / lista vermelha" (Kirchenbauer et al.) não carimba
caracteres — ela enviesa a ESCOLHA DE TOKENS na geração: a partir de um hash do
contexto + chave secreta, parte do vocabulário vira "verde" (preferida) e o
resto "vermelha". O detector, com a mesma chave, mede se o texto usa tokens
verdes acima do acaso. A consequência direta disso (documentada nos próprios
papers de watermarking): reescrita genuína destrói o sinal, porque muda as
escolhas de tokens e a estrutura do texto. O goodwash faz exatamente isso —
reescrever de verdade, não trocar sinônimo por sinônimo.

O modelo reescreve em intensidades (leve|media|profunda). `checar` roda offline
(0 LLM) e aponta os "tells" de texto de IA — serve de guia pro que a reescrita
precisa atacar; não é detecção da watermark real, que exige a chave secreta.

O CLI gera via OpenRouter `:free`. No Claude Code, `/goodwash` reescreve com o
Claude da sessão (sem chave).

args: [leve|media|profunda] [texto|arquivo] [-o saida] · checar [texto] ·
      temas · -m · help

Requer: Python 3. OPENROUTER_API_KEY só pros comandos de geração (lavar).
"""

import argparse
import os
import re
import sys
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from retro import Retro  # noqa: E402
from llm import LLM, LLMError  # noqa: E402

ui = Retro(env_prefix="GOODWASH")


def carregar_dotenv():
    """Carrega KEY=VALOR de um .env ao lado do script. Não sobrescreve o que já
    está exportado no shell (env real tem prioridade)."""
    env_path = Path(__file__).resolve().parent / ".env"
    if not env_path.exists():
        return
    try:
        linhas = env_path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    for linha in linhas:
        linha = linha.strip()
        if not linha or linha.startswith("#") or "=" not in linha:
            continue
        chave, _, valor = linha.partition("=")
        os.environ.setdefault(chave.strip(), valor.strip().strip('"').strip("'"))


carregar_dotenv()

