def _frases_pontuadas(texto):
    """Divide em frases sem quebrar em abreviação ('Dr. Silva'), decimal ('3.5')
    ou inicial ('J. R. R.'), e conta a última frase mesmo quando o texto não
    termina em pontuação — antes disso um texto sem ponto final zerava o eixo
    de ritmo inteiro."""
    partes, ini = [], 0
    for m in re.finditer(r"[.!?…]+(?=\s|$)", texto):
        anterior = re.search(r"(\w+)\W*$", texto[:m.start()])
        if anterior:
            tok = sem_acento(anterior.group(1).lower())
            # abreviação conhecida ou inicial de nome ('J.') não fecha frase
            if tok in ABREVIACOES or (len(tok) == 1 and tok.isalpha()):
                continue
        trecho = texto[ini:m.end()].strip()
        if trecho:
            partes.append(trecho)
        ini = m.end()
    resto = texto[ini:].strip()
    if resto:
        partes.append(resto)
    return partes


def sentencas(texto):
    """Frases do texto. Linha estrutural de markdown (bullet, item numerado,
    cabeçalho) vira frase própria mesmo sem pontuação final — antes a lista
    inteira colava numa "frase" gigante e inflava a variação de ritmo. O
    marcador (`- `, `1. `, `## `) sai antes da contagem: senão o "1." abria
    uma falsa frase de uma palavra."""
    partes, corrido = [], []
    for linha in texto.split("\n"):
        if _linha_estrutural(linha):
            if corrido:
                partes.extend(_frases_pontuadas("\n".join(corrido)))
                corrido = []
            conteudo = RE_CABECALHO.sub("", RE_LINHA_LISTA.sub("", linha)).strip()
            if conteudo:
                partes.extend(_frases_pontuadas(conteudo))
        else:
            corrido.append(linha)
    if corrido:
        partes.extend(_frases_pontuadas("\n".join(corrido)))
    return partes


# --- sinais extras, só usados pelo `avaliar` ------------------------------
# Estes rodam em `normalizar_leve` (minúsculo, sem acento, espaçamento colapsado)
# e NÃO no `normalizar` do checar: tríade e correlativo dependem da vírgula, que
# o outro apaga.

# tríade "rápido, simples e barato" e pares correlativos — o paralelismo certinho
# que o README prometia e o `checar` nunca mediu. Itens de 1-2 palavras: o padrão
# antigo (`{0,3}` palavras no meio) engolia o rabo de qualquer oração coordenada.
RE_TRIADE = re.compile(r"\b(\w+), (\w+(?: \w+)?) e (\w+)\b")
# item com cara de verbo conjugado ("fui na feira, comprei tomate e voltei") é
# coordenação de oração, não tríade retórica. Mínimo de 4 letras pra não pegar
# "meu"/"seu" no falso sufixo -eu.
_RE_ITEM_VERBAL = re.compile(r"(?:ei|ou|amos|aram|emos|eu|iu|iram)$")
RE_CORRELATIVO = re.compile(
    r"\bnao (?:apenas|so) .{1,60}? mas (?:tambem|sim)\b|"
    r"\btanto .{1,60}? quanto\b|\bnot only .{1,60}? but also\b")
# ser/estar + particípio: "é considerado", "foram utilizados". Roda em
# `normalizar_minima` (acento PRESERVADO): com o fold, "é" virava "e" e a
# conjunção casava — "limpo e organizado" contava como passiva.
RE_PASSIVA = re.compile(
    r"\b(?:é|foi|são|eram|era|foram|será|serão|sendo|ser|está|estão)"
    r" \w+(?:ad|id|íd)[oa]s?\b")
# marcas que modelo raramente produz sozinho: fala coloquial e 1ª pessoa, em PT
# e EN. O "to" (tô sem acento) saiu: casava com o "to" inglês e virava crédito
# aleatório em texto EN.
RE_COLOQUIAL = re.compile(
    r"\b(?:pra|pro|pras|pros|ta|ne|ce|vc|dai|putz|caramba|meio que|"
    r"sei la|tipo assim|no fim das contas|acho que|sinceramente|enfim|"
    r"honestly|whatever|anyway|yeah|kinda|gonna|i guess|i mean|no joke)\b")
RE_PRIMEIRA_PESSOA = re.compile(
    r"\b(?:eu|meu|minha|meus|minhas|comigo|mim|me|i|my|mine)\b")
PONTUACAO_EXPRESSIVA = "—–();:…!?\"'"

# --- estrutura markdown: a forma clássica de resposta de chat ---------------
# Cabeçalho, item de lista e rótulo em negrito ("**Foco**: …"). Humano também
# anota em bullet — por isso bullet sozinho pesa pouco e o rótulo em negrito
# (que quase só IA produz em prosa) pesa mais.
RE_CABECALHO = re.compile(r"^\s*#{1,6} ")
RE_LINHA_LISTA = re.compile(r"^\s*(?:[-*•] |\d{1,2}[.)] )")
RE_ROTULO_NEGRITO = re.compile(r"\*\*[^*\n]{1,60}\*\*\s*[:—–-]")


def _linha_estrutural(linha):
    return bool(RE_CABECALHO.match(linha) or RE_LINHA_LISTA.match(linha))


def normalizar_minima(texto):
    """Minúsculo com ACENTO PRESERVADO e espaçamento colapsado — pra regex que
    precisa distinguir 'é' (verbo) de 'e' (conjunção)."""
    return re.sub(r"\s+", " ", texto.lower())


def _triades_retoricas(leve):
    """Tríades curtas sem cara de oração ('rápido, simples e barato')."""
    achadas = []
    for m in RE_TRIADE.finditer(leve):
        itens = [m.group(1), m.group(2).split()[0], m.group(3)]
        if any(len(w) > 3 and _RE_ITEM_VERBAL.search(w) for w in itens):
            continue
        achadas.append(m.group(0))
    return achadas


# --- ancoragem concreta e repetitividade lexical (eixos não-lexicais) -------
# Humano ancora em específico (número, nome próprio, sigla, data); IA genérica
# evita. E texto de modelo tende a vocabulário mais repetitivo que humano no
# mesmo tamanho — root TTR numa janela fixa, senão a régua muda com o texto.
RE_NUMERO = re.compile(r"\b\d+(?:[.,]\d+)?%?\b")
RE_SIGLA = re.compile(r"\b[A-Z]{2,}\b")
RE_NOME_PROPRIO = re.compile(r"\b[A-ZÀ-Ý][a-zà-ÿçü]{2,}")
_ANTES_NAO_CONTA = ".!?…:*#>\"'"
RTTR_IA = 6.5           # root TTR abaixo disso: repetitivo como texto de modelo
RTTR_HUMANO = 8.5       # acima disso: variedade lexical de texto humano
RTTR_JANELA = 200       # tokens; janela fixa pra régua não crescer com o texto
RTTR_MINIMO = 40        # com menos tokens o rTTR não diz nada


def _ancoras_concretas(texto):
    """Números + siglas + nomes próprios FORA de início de frase/linha (ali a
    maiúscula não diz nada)."""
    total = len(RE_NUMERO.findall(texto)) + len(RE_SIGLA.findall(texto))
    for m in RE_NOME_PROPRIO.finditer(texto):
        antes = texto[:m.start()].rstrip(" \t")
        if not antes or antes.endswith("\n") or antes[-1] in _ANTES_NAO_CONTA:
            continue
        total += 1
    return total


def _root_ttr(texto):
    """Tipos / raiz(tokens) nos primeiros ``RTTR_JANELA`` tokens, ou ``None``
    quando a janela é curta demais pra régua valer."""
    toks = re.findall(r"\w+", sem_acento(texto.lower()))[:RTTR_JANELA]
    if len(toks) < RTTR_MINIMO:
        return None
    return len(set(toks)) / (len(toks) ** 0.5)


def _eixo_markdown(texto):
    """``(valor 0..1, listas, cabecalhos, rotulos)``. Valor ``None`` em prosa
    corrida — ausência de markdown não é evidência de nada."""
    linhas = [ln for ln in texto.split("\n") if ln.strip()]
    listas = sum(1 for ln in linhas if RE_LINHA_LISTA.match(ln))
    cabecalhos = sum(1 for ln in linhas if RE_CABECALHO.match(ln))
    rotulos = len(RE_ROTULO_NEGRITO.findall(texto))
    if not (listas or rotulos):
        return None, listas, cabecalhos, rotulos
    valor = 0.6 * min(1.0, rotulos / 3.0)
    if cabecalhos and listas:
        valor += 0.4          # cabeçalho + lista = o esqueleto de resposta de IA
    elif listas:
        valor += 0.15         # bullet sozinho: humano também anota assim
    return min(1.0, valor), listas, cabecalhos, rotulos


def _abre_oracao(texto, pos):
    """True se `pos` começa uma oração — início do texto ou logo depois de
    pontuação. Separa 'Com isso, o time cresceu' de 'trabalho com isso'."""
    anterior = texto[:pos].rstrip()
    return not anterior or anterior[-1] in ABRE_ORACAO


def _cv(valores):
    """Coeficiente de variação (desvio-padrão / média) dos tamanhos de frase.
    Substitui o antigo `maior - menor`, que uma única frase atípica destruía e
    que não dizia nada sem saber o tamanho do texto."""
    if len(valores) < 2:
        return None
    media = sum(valores) / len(valores)
    if media <= 0:
        return None
    dp = (sum((v - media) ** 2 for v in valores) / len(valores)) ** 0.5
    return dp / media


def checar_tells(texto):
    """Heurística offline de padrões comuns em texto de IA. Não é detecção da
    watermark (que precisa da chave secreta) — é um guia do que reescrever.

    Devolve um dict com as ocorrências e, principalmente, com densidades
    (por 100 palavras) e um ``score`` 0-100 — contagem crua não dizia nada sem
    o tamanho do texto: 5 fórmulas em 80 palavras e 5 em 2000 são coisas
    opostas.
    """
    norm, offsets = normalizar(texto)
    total_palavras = len(re.findall(r"\w+", texto))

    formulas, cobertos = [], []
    for rotulo, rx, exige_abertura in _FORMULAS_TODAS:
        for m in rx.finditer(norm):
            # família não conta em cima de trecho já coberto por um literal
            if any(m.start() < fim and ini < m.end() for ini, fim in cobertos):
                continue
            ini_orig = offsets[m.start()]         # 1º char da fórmula no original
            if exige_abertura and not _abre_oracao(texto, ini_orig):
                continue
            cobertos.append((m.start(), m.end()))
            corte = max(0, ini_orig - 20)
            ctx = re.sub(r"\s+", " ", texto[corte:corte + 60]).strip()
            formulas.append((rotulo or m.group(0).strip(), ctx))

    buzz = sorted({original for original, rx in _BUZZ_RE if rx.search(norm)})

    frases = sentencas(texto)
    comprimentos = [len(re.findall(r"\w+", f)) for f in frases]
    cv = _cv(comprimentos) if len(frases) >= MIN_FRASES_RITMO else None

    por100 = (100.0 / total_palavras) if total_palavras else 0.0
    dens_formulas = len(formulas) * por100
    dens_buzz = len(buzz) * por100

    eixo_f = min(1.0, dens_formulas / DENS_FORMULA_TETO)
    eixo_b = min(1.0, dens_buzz / DENS_BUZZ_TETO)
    if cv is None:                                 # sem frases suficientes
        eixo_r = None
        score = round(100 * (0.60 * eixo_f + 0.40 * eixo_b))
    else:
        eixo_r = min(1.0, max(0.0, (CV_HUMANO - cv) / (CV_HUMANO - CV_UNIFORME)))
        score = round(100 * (0.40 * eixo_f + 0.25 * eixo_b + 0.35 * eixo_r))

    return {
        "formulas": formulas,
        "buzz": buzz,
        "frases": len(frases),
        "palavras": total_palavras,
        "comprimentos": comprimentos,
        "cv": cv,
        "dens_formulas": dens_formulas,
        "dens_buzz": dens_buzz,
        "score": score,
        "veredito": "ALTO" if score >= 60 else ("MEDIO" if score >= 30 else "BAIXO"),
    }


def avaliar_texto(texto):
    """Avaliação de autoria: onze eixos, veredito e confiança.

    Reaproveita os três eixos do ``checar`` e soma paralelismo/tríade, voz
    passiva, marcas humanas (coloquialismo e 1ª pessoa, PT/EN), variedade de
    pontuação, uniformidade de parágrafo, estrutura markdown de resposta de
    chat, ancoragem concreta e repetitividade lexical. Cada eixo vira 0..1 de
    "cara de IA"; o peso de um eixo indisponível (texto curto, poucas frases,
    prosa sem markdown) é redistribuído entre os que sobraram, em vez de
    contar como zero. O selo "PROVAVELMENTE HUMANO" exige evidência positiva
    (marca humana ou ancoragem); score baixo sem ela sai "SEM TELLS DE IA".

    ATENÇÃO, e isso vale mais que o número: detector de texto de IA erra, e
    erra pro lado feio. Prosa formal, técnica ou traduzida é o caso clássico de
    falso positivo — ela usa as mesmas transições e a mesma voz passiva que o
    eixo pune. Serve pra você medir o próprio texto, nunca pra acusar alguém.
    """
    base = checar_tells(texto)
    leve = normalizar_leve(texto)
    palavras = base["palavras"]
    por100 = (100.0 / palavras) if palavras else 0.0

    triades = _triades_retoricas(leve)
    correlativos = len(RE_CORRELATIVO.findall(leve))
    paralelismos = len(triades) + correlativos
    # uma enumeração isolada é escrita normal ("pão, leite e ovos") — a primeira
    # tríade é de graça no eixo; só a repetição vira tell. Correlativo conta sempre.
    paral_efetivo = correlativos + max(0, len(triades) - 1)
    passivas = len(RE_PASSIVA.findall(normalizar_minima(texto)))
    humanas = len(RE_COLOQUIAL.findall(leve)) + len(RE_PRIMEIRA_PESSOA.findall(leve))
    tipos_pont = len({c for c in texto if c in PONTUACAO_EXPRESSIVA})
    eixo_md, md_listas, md_cabecalhos, md_rotulos = _eixo_markdown(texto)

    # marcadores de lista saem antes da ancoragem: o "1." de item numerado não
    # é um número do conteúdo
    sem_marc = "\n".join(RE_CABECALHO.sub("", RE_LINHA_LISTA.sub("", ln))
                         for ln in texto.split("\n"))
    ancoras = _ancoras_concretas(sem_marc)
    dens_ancoras = ancoras * por100
    rttr = _root_ttr(texto)

    paragrafos = [p for p in re.split(r"\n\s*\n", texto) if p.strip()]
    cv_par = _cv([len(re.findall(r"\w+", p)) for p in paragrafos]) if len(paragrafos) >= 3 else None

    def _clamp(v):
        return min(1.0, max(0.0, v))

    # (rótulo, valor 0..1 de "cara de IA" ou None se não dá pra medir, peso)
    eixos = [
        ("transições fórmula", min(1.0, base["dens_formulas"] / DENS_FORMULA_TETO), 0.22),
        ("palavras batidas", min(1.0, base["dens_buzz"] / DENS_BUZZ_TETO), 0.13),
        ("ritmo das frases",
         None if base["cv"] is None else _clamp((CV_HUMANO - base["cv"]) / (CV_HUMANO - CV_UNIFORME)),
         0.22),
        ("paralelismo/tríade", min(1.0, paral_efetivo * por100 / 1.5), 0.12),
        ("voz passiva", min(1.0, passivas * por100 / 2.5), 0.10),
        ("marcas humanas", 1.0 - min(1.0, humanas * por100 / 3.0), 0.13),
        ("variedade de pontuação", _clamp((4 - tipos_pont) / 3.0), 0.08),
        ("uniformidade dos parágrafos",
         None if cv_par is None else _clamp((CV_HUMANO - cv_par) / (CV_HUMANO - CV_UNIFORME)),
         0.10),
        ("estrutura markdown", eixo_md, 0.12),
        ("ancoragem concreta", 1.0 - min(1.0, dens_ancoras / 2.0), 0.08),
        ("repetitividade lexical",
         None if rttr is None else _clamp((RTTR_HUMANO - rttr) / (RTTR_HUMANO - RTTR_IA)),
         0.08),
    ]
    disponiveis = [(nome, val, peso) for nome, val, peso in eixos if val is not None]
    total_peso = sum(p for _n, _v, p in disponiveis) or 1.0
    score = round(100 * sum(v * p for _n, v, p in disponiveis) / total_peso)

    # confiança: cresce com o tamanho do texto e com a distância do meio-termo
    tamanho = min(1.0, palavras / 300.0)
    decisao = abs(score - 50) / 50.0
    confianca = round(100 * tamanho * (0.35 + 0.65 * decisao))

    if palavras < 60:
        veredito = "INCERTO"          # texto curto demais pra qualquer eixo valer
    elif score >= 65:
        veredito = "PROVAVELMENTE IA"
    elif score <= 35:
        # "humano" exige evidência POSITIVA (marca humana ou ancoragem
        # concreta). Só ausência de tells vira "SEM TELLS DE IA": IA moderna
        # instruída a soar casual zera os eixos lexicais e ganharia o selo
        # humano de graça — o pior erro possível aqui.
        if humanas * por100 >= 1.5 or dens_ancoras >= 1.5:
            veredito = "PROVAVELMENTE HUMANO"
        else:
            veredito = "SEM TELLS DE IA"
    else:
        veredito = "INCERTO"

    return {
        **base,
        "score_autoria": score,
        "veredito_autoria": veredito,
        "confianca": confianca,
        "eixos": [(nome, val, peso) for nome, val, peso in eixos],
        "paralelismos": paralelismos,
        "passivas": passivas,
        "marcas_humanas": humanas,
        "tipos_pontuacao": tipos_pont,
        "cv_paragrafos": cv_par,
        "paragrafos": len(paragrafos),
        "md_listas": md_listas,
        "md_cabecalhos": md_cabecalhos,
        "md_rotulos": md_rotulos,
        "ancoras": ancoras,
        "dens_ancoras": dens_ancoras,
        "rttr": rttr,
    }


