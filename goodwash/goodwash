def main():
    ap = argparse.ArgumentParser(
        prog="goodwash",
        description="Reescreve texto pra soar humano e destruir a assinatura "
                    "estatística da watermark de IA (lista verde/vermelha).",
        epilog="exemplos:  echo \"<texto>\" | goodwash   ·   goodwash arquivo.txt   ·   "
               "goodwash profunda \"seu texto\"   ·   goodwash checar \"texto\"",
        add_help=False,
    )
    ap.add_argument("comando", nargs="?", default="lavar",
                    help="lavar (padrão): reescreve · avaliar: IA ou humano? · "
                         "checar: tells de IA (offline) · temas: paletas · ou "
                         "texto/arquivo direto pra reescrever")
    ap.add_argument("resto", nargs="*", help="intensidade (leve|media|profunda) e/ou texto")
    ap.add_argument("-o", "--saida", default="", help="salva a reescrita em arquivo")
    ap.add_argument("--arquivo", default="", help="lê o texto de um arquivo")
    ap.add_argument("--ate", type=int, default=None, metavar="SCORE",
                    help="reescreve até a auto-avaliação cair até esse score (0-100)")
    ap.add_argument("--tentativas", type=int, default=1, metavar="N",
                    help="máximo de reescritas do loop --ate (escala a intensidade)")
    ap.add_argument("--llm", action="store_true",
                    help="em `avaliar`: pede segunda opinião ao modelo")
    ap.add_argument("-m", "--modelos", action="store_true",
                    help="lista modelos :free disponíveis")
    ap.add_argument("-h", "--help", action="store_true", help="mostra esta ajuda")
    args = ap.parse_args()

    if args.help or args.comando == "help":
        uso()
        return

    if args.modelos:
        listar_modelos_free()
        return

    if args.comando == "temas":
        ui.catalogo_temas()
        return

    # comando que não é verbo reservado já é parte do texto de lavar (ex.:
    # `goodwash "seu texto"`, `goodwash profunda "texto"`, `goodwash arquivo.txt`).
    if args.comando in VERBOS:
        comando, resto = args.comando, args.resto
    else:
        comando, resto = "lavar", [args.comando, *args.resto]

    if comando == "checar":
        _, texto = ler_entrada(args, resto)
        cmd_checar(texto)
        return

    if comando == "avaliar":
        _, texto = ler_entrada(args, resto)
        cmd_avaliar(texto, args.llm)
        return

    if args.ate is not None and not 0 <= args.ate <= 100:
        die("--ate espera um score entre 0 e 100.")
    tentativas = max(1, args.tentativas)
    if args.ate is not None and args.tentativas == 1:
        tentativas = 3        # --ate sozinho não teria como insistir
    intensidade, texto = ler_entrada(args, resto)
    cmd_lavar(intensidade, texto, args.saida, ate=args.ate, tentativas=tentativas)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        ui.aviso("interrompido")
        print()
        sys.exit(130)
