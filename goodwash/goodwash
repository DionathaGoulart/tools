_PREAMBULO = re.compile(
    r"^(aqui (está|vai)|segue|claro|certo|com certeza|entendi|perfeito|"
    r"here (is|'s)|sure|certainly|of course)\b[^\n]*:\s*$",
    re.IGNORECASE)


def limpar_saida(texto):
    """Tira cerca de markdown e a linha de preâmbulo do modelo."""
    t = texto.strip()
    cerca = re.match(r"^```[\w-]*\n(.*)\n```$", t, re.DOTALL)
    if cerca:
        t = cerca.group(1).strip()
    linhas = t.split("\n")
    if len(linhas) > 1 and len(linhas[0]) < 120 and _PREAMBULO.match(linhas[0].strip()):
        t = "\n".join(linhas[1:]).lstrip()
    return t.strip()


def _delta(rotulo, antes, depois, casas=0, menor_melhor=True):
    """Linha 'antes → depois' com o sinal de melhora/piora."""
    fmt = f"{{:.{casas}f}}"
    seta = "OK" if ((depois < antes) if menor_melhor else (depois > antes)) else (
        "==" if depois == antes else "!!")
    ui.kv(rotulo, f"{fmt.format(antes)} -> {fmt.format(depois)}  [{seta}]")


