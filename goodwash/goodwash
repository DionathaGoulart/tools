            print(f"  {ui.FG40}· +{len(formulas) - 12} outras{ui.RESET}")
        print()
    if buzz:
        ui.secao("palavras batidas (trocáveis)")
        ui.item("·", ", ".join(buzz))
        print()
    ui.aviso("lembrete", "isto é score de ESTILO, não a watermark — ela precisa "
                          "da chave secreta do detector e não dá pra medir "
                          "localmente. Aponta o que a reescrita deve atacar.")
    ui.proximo("goodwash \"seu texto\"", "pra lavar:")
    print()


