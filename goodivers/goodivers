    cfg = carregar_json(CONFIG_FILE, None)
    if cfg is None:
        cfg = {"canais": SEED_CANAIS}
        salvar_json(CONFIG_FILE, cfg)
    return cfg


def coletar_radar(force=False):
    cache = carregar_json(RADAR_FILE, None)
    if cache and not force:
        ts = parse_iso(cache.get("ts", ""))
        if ts and (agora_utc() - ts).total_seconds() < CACHE_RADAR_HORAS * 3600:
            return cache

    cfg = carregar_config()
    nota("coletando: guerra, patches, reddit e canais…")

    snapshot = {"ts": agora_utc().isoformat(), "falhas": []}
    with ThreadPoolExecutor(max_workers=8) as ex:
        jobs = {
            "ordem": ex.submit(fetch_ordem),
            "despachos": ex.submit(fetch_despachos),
            "patches": ex.submit(fetch_patches),
            "reddit": ex.submit(fetch_reddit),
            "meu_canal": ex.submit(fetch_canal, CANAL_PROPRIO),
        }
        jobs_canais = [ex.submit(fetch_canal, c) for c in cfg["canais"]]

        # fonte fora do ar → reaproveita a última coleta boa (melhor dado velho
        # que seção sumida; a nota de falha diz a idade)
        for chave, fut in jobs.items():
            try:
                snapshot[chave] = fut.result()
            except Exception as e:
                velho = (cache or {}).get(chave)
                snapshot[chave] = velho
                falha = f"{chave}: {type(e).__name__}"
                if velho:
                    falha += f", mostrando coleta de {idade_humana(cache['ts'])}"
                snapshot["falhas"].append(falha)
        canais = []
        for cfg_c, fut in zip(cfg["canais"], jobs_canais):
            try:
                canais.append(marcar_outliers(fut.result()))
            except Exception as e:
                velho = next((c for c in (cache or {}).get("canais", [])
                              if c.get("id") == cfg_c["id"]), None)
                if velho:
