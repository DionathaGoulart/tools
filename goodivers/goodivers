def fetch_ordem():
    """Ordem Maior ativa (api.helldivers2.dev — oscila, por isso timeout maior)."""
    dados = http_json(f"{HD2_API}/assignments", HD2_HEADERS, timeout=25)
    ordens = []
    for a in dados or []:
        exp = parse_iso(a.get("expiration") or "")
        restante = ""
        if exp:
            seg = (exp - agora_utc()).total_seconds()
            restante = f"{int(seg // 86400)}d {int(seg % 86400 // 3600)}h" if seg > 0 else "expirada"
        ordens.append({
            "titulo": limpar_marcacao(a.get("title") or "Ordem Maior"),
            "briefing": limpar_marcacao(a.get("briefing") or a.get("description") or ""),
            "restante": restante,
            "medalhas": (a.get("reward") or {}).get("amount"),
        })
    return ordens


def fetch_despachos():
    """Despachos in-game recentes (a 'TV' da Super Terra)."""
    dados = http_json(f"{HD2_API}/dispatches", HD2_HEADERS, timeout=25)
    out = []
    for d in (dados or [])[:4]:
        msg = limpar_marcacao(d.get("message") or "")
        if msg:
            out.append({"quando": d.get("published", ""), "texto": resumir(msg, 260)})
    return out


def fetch_patches():
    """Anúncios oficiais da Arrowhead no Steam (patch notes inclusos)."""
    dados = http_json(STEAM_NEWS_URL)
    out = []
    for n in dados.get("appnews", {}).get("newsitems", []):
        if n.get("feedname") != "steam_community_announcements":
            continue
        dt = datetime.fromtimestamp(n.get("date", 0), tz=timezone.utc)
        out.append({
            "titulo": limpar_marcacao(n.get("title") or ""),
            "quando": dt.isoformat(),
            "resumo": resumir(limpar_marcacao(n.get("contents") or ""), 240),
        })
    return out[:5]


def fetch_reddit():
    """Posts quentes do r/Helldivers. Reddit costuma bloquear IP de nuvem/VPN —
    quando bloquear, o radar segue sem essa fonte."""
    dados = http_json(REDDIT_URL, {"User-Agent": UA_BROWSER})
    out = []
    for filho in dados.get("data", {}).get("children", []):
        p = filho.get("data", {})
        if p.get("stickied"):
            continue
        out.append({
            "titulo": p.get("title", "").strip(),
            "score": p.get("score", 0),
            "comentarios": p.get("num_comments", 0),
            "flair": p.get("link_flair_text") or "",
        })
    return out[:8]


def fetch_canal(canal):
    """Últimos vídeos de um canal via RSS público do YouTube (título + views).
    Parse por regex de propósito: o feed tem formato fixo e o ElementTree
    depende do expat, que falta em alguns Python do Homebrew."""
    feed = http_get(RSS_URL.format(canal["id"])).decode("utf-8", errors="replace")

    def campo(tag, trecho):
        m = re.search(f"<{tag}>([^<]*)</{tag}>", trecho)
        return html.unescape(m.group(1)) if m else ""

    cabeca = feed.split("<entry>", 1)[0]
    nome = campo("title", cabeca) or canal.get("nome", "?")
    videos = []
    for bloco in re.findall(r"<entry>(.*?)</entry>", feed, re.S):
        views = re.search(r'views="(\d+)"', bloco)
        videos.append({
            "titulo": campo("title", bloco),
            "id": campo("yt:videoId", bloco),
            "publicado": campo("published", bloco),
            "views": int(views.group(1)) if views else 0,
        })
    return {"nome": nome, "id": canal["id"], "videos": videos}


def fetch_busca(termo, semana=False, br=False):
    """Busca do YouTube via ytInitialData embutido na página (sem key).
    br=True busca como o público BR vê (gl=BR, hl=pt)."""
    gl, hl = ("BR", "pt") if br else ("US", "en")
    url = ("https://www.youtube.com/results?search_query="
           + urllib.parse.quote(termo)
           + ("&sp=EgIIAw%3D%3D" if semana else "")   # filtro: esta semana
           + f"&gl={gl}&hl={hl}")
    pagina = http_get(url, {
        "User-Agent": UA_BROWSER,
        "Accept-Language": f"{hl}-{gl},{hl}",
        "Cookie": "CONSENT=YES+cb; SOCS=CAI",
    }).decode("utf-8", errors="replace")
    m = re.search(r"ytInitialData\s*=\s*(\{.*?\});\s*</script>", pagina, re.S)
    if not m:
        raise ValueError("página de busca sem ytInitialData (YouTube mudou o HTML?)")
    dados = json.loads(m.group(1))

    brutos = []

    def anda(o):
        if isinstance(o, dict):
            if "videoRenderer" in o:
                brutos.append(o["videoRenderer"])
            for v in o.values():
                anda(v)
        elif isinstance(o, list):
            for v in o:
                anda(v)

    anda(dados)
    out, vistos = [], set()
    for vr in brutos:
        vid = vr.get("videoId")
        if not vid or vid in vistos:
            continue
        vistos.add(vid)
        views_txt = (vr.get("viewCountText") or {}).get("simpleText") or ""
        out.append({
            "id": vid,
            "titulo": "".join(r.get("text", "") for r in (vr.get("title") or {}).get("runs", [])),
            "canal": ((vr.get("ownerText") or {}).get("runs") or [{}])[0].get("text", ""),
            "views": parse_views_txt(views_txt),
            "views_txt": views_txt,
            "quando": (vr.get("publishedTimeText") or {}).get("simpleText", ""),
            "duracao": (vr.get("lengthText") or {}).get("simpleText", ""),
        })
    return out[:20]


def marcar_outliers(canal):
    """views/dia de cada vídeo vs a mediana do próprio canal. Muito acima da
    mediana = o algoritmo está empurrando esse formato."""
    taxas = []
    for v in canal["videos"]:
        pub = parse_iso(v["publicado"])
        dias = max(0.25, (agora_utc() - pub).total_seconds() / 86400) if pub else 1
        v["vpd"] = v["views"] / dias
        taxas.append(v["vpd"])
    if len(taxas) >= 4:
        ordenadas = sorted(taxas)
        mediana = ordenadas[len(ordenadas) // 2] or 1
        for v in canal["videos"]:
            v["ratio"] = v["vpd"] / mediana
            v["outlier"] = v["ratio"] >= OUTLIER_RATIO
    else:
        for v in canal["videos"]:
            v["ratio"], v["outlier"] = 1.0, False
    return canal


