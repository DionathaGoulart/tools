def main():
    ap = argparse.ArgumentParser(
        prog="goodivers",
        description="Copiloto de conteúdo do canal Goodivers (Helldivers 2): "
                    "radar ao vivo do jogo + ideias, títulos, thumbnails e roteiro.",
        epilog='exemplos:  goodivers   ·   goodivers ideias   ·   goodivers inspirar   ·   '
               'goodivers pacote 3   ·   goodivers buscar "helldivers 2 leaks" -s   ·   '
               'goodivers canais add @canal   ·   goodivers temas',
        add_help=False,
    )
    ap.add_argument("comando", nargs="?", default="radar",
                    choices=["radar", "ideias", "inspirar", "pacote", "titulos",
                             "buscar", "canais", "temas"],
                    help="radar (padrão): estado do jogo e do nicho · ideias: 10 ideias "
                         "rankeadas · inspirar: vídeos gringos performando → plano de "
                         "adaptação PT-BR · pacote: títulos+thumb+descrição+roteiro · "
                         "titulos: variações A/B · buscar: busca no YouTube · canais: "
                         "gerencia canais monitorados · temas: paletas do tema retro "
                         "(GOODIVERS_TEMA / RETRO_TEMA)")
    ap.add_argument("resto", nargs="*", help="argumento do comando (ideia, tema, add/rm…)")
    ap.add_argument("-f", "--fresh", action="store_true",
                    help="ignora o cache e recoleta o radar agora")
    ap.add_argument("-s", "--semana", action="store_true",
                    help="(buscar) só vídeos desta semana")
    ap.add_argument("--br", action="store_true",
                    help="(buscar) busca como o público BR (gl=BR, hl=pt)")
    ap.add_argument("-m", "--modelos", action="store_true",
                    help="lista modelos :free disponíveis")
    ap.add_argument("--json", action="store_true", dest="como_json",
                    help="saída JSON crua (radar, buscar, canais) — pra scripts "
                         "e pro skill /goodivers do Claude Code")
    ap.add_argument("-h", "--help", action="store_true", help="mostra esta ajuda")
    args = ap.parse_args()

    if args.help:
        uso()
        return

    if args.como_json and args.comando not in ("radar", "buscar", "canais"):
        die("--json é só pra coleta (radar, buscar, canais). Geração com o Claude: "
            "skill /goodivers no Claude Code.")

    if args.modelos:
        listar_modelos_free()
    elif args.comando == "radar":
        cmd_radar(args.fresh, args.como_json)
    elif args.comando == "ideias":
        cmd_ideias(args.fresh)
    elif args.comando == "inspirar":
        cmd_inspirar(args.fresh)
    elif args.comando == "pacote":
        cmd_pacote(" ".join(args.resto).strip(), args.fresh)
    elif args.comando == "titulos":
        cmd_titulos(" ".join(args.resto).strip(), args.fresh)
    elif args.comando == "buscar":
        cmd_buscar(" ".join(args.resto).strip(), args.semana, args.br, args.como_json)
    elif args.comando == "canais":
        cmd_canais(args.resto, args.como_json)
    elif args.comando == "temas":
        ui.catalogo_temas()


if __name__ == "__main__":
    try:
        main()
