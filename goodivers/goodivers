def gravar_hist_ideias(quando, ideias):
    """Anexa a leva ao histórico (JSONL: 1 leva por linha, nunca sobrescreve)."""
    IDEIAS_HIST_FILE.parent.mkdir(parents=True, exist_ok=True)
    linha = json.dumps({"quando": quando, "ideias": ideias}, ensure_ascii=False)
    with IDEIAS_HIST_FILE.open("a", encoding="utf-8") as f:
        f.write(linha + "\n")


def ler_hist_ideias():
    """Levas do histórico, da mais recente pra mais antiga."""
    if not IDEIAS_HIST_FILE.exists():
        return []
    levas = []
    for linha in IDEIAS_HIST_FILE.read_text(encoding="utf-8").splitlines():
        linha = linha.strip()
        if linha:
            try:
                levas.append(json.loads(linha))
            except json.JSONDecodeError:
                pass
    levas.reverse()
    return levas


