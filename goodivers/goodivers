def corpo(texto, recuo=2):
    """Parágrafo em foreground, quebrado na largura do terminal."""
    larg = max(40, min(ui.cols - recuo - 2, 92))
    for linha in textwrap.wrap(texto, larg) or [""]:
        print(f"{' ' * recuo}{ui.FG70}{linha}{ui.RESET}")


def chips(itens, recuo=2):
    """Fileira de chips com quebra de linha na largura do terminal."""
    larg = max(40, min(ui.cols - recuo - 2, 92))
    atual, tam = [], 0
    for it in itens:
        t = len(str(it)) + 3
        if atual and tam + t > larg:
            print(" " * recuo + " ".join(atual))
            atual, tam = [], 0
        atual.append(ui.chip(str(it)))
        tam += t
    if atual:
        print(" " * recuo + " ".join(atual))


def carregar_json(caminho, padrao):
    if caminho.exists():
        try:
            return json.loads(caminho.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    return padrao


def salvar_json(caminho, obj):
    caminho.parent.mkdir(parents=True, exist_ok=True)
    caminho.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")


def agora_utc():
    return datetime.now(timezone.utc)


def parse_iso(s):
    """ISO 8601 tolerante: aceita Z e frações de 7 dígitos da API do jogo."""
    s = re.sub(r"\.\d+", "", s.strip()).replace("Z", "+00:00")
    try:
        dt = datetime.fromisoformat(s)
        return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def idade_humana(iso):
    dt = parse_iso(iso) if isinstance(iso, str) else iso
    if not dt:
        return "?"
    seg = (agora_utc() - dt).total_seconds()
    if seg < 120:
        return "agora"
    if seg < 3600:
        return f"há {max(1, int(seg // 60))}min"
    if seg < 86400:
        return f"há {int(seg // 3600)}h"
    return f"há {int(seg // 86400)}d"


def fmt_views(v):
    if v >= 1_000_000:
        return f"{v / 1_000_000:.1f}M".replace(".0M", "M")
    if v >= 1_000:
        return f"{v / 1_000:.1f}k".replace(".0k", "k")
    return str(v)


def limpar_marcacao(txt):
    """Tira tags do jogo (<i=3>…</i>), HTML e bbcode do Steam."""
    txt = re.sub(r"<[^>]+>", "", txt)
    txt = re.sub(r"\[/?[^\]]+\]", "", txt)
    return re.sub(r"[ \t]+", " ", txt).strip()


def resumir(txt, n):
    txt = " ".join(txt.split())
    return txt if len(txt) <= n else txt[: n - 1].rstrip() + "…"


def parse_views_txt(txt):
    """'1.2M views', '12 mil visualizações', '1,2 mi de visualizações' → int."""
    t = (txt or "").lower().replace("\xa0", " ").strip()
    m = re.search(r"([\d][\d.,]*)\s*(mil|mi|bi|k|m|b)?", t)
    if not m:
        return 0
    bruto, suf = m.group(1), (m.group(2) or "")
    try:
        if suf:   # decimal: "1,2 mi" / "1.2M"
            num = float(bruto.replace(",", "."))
        else:     # inteiro com separador de milhar: "1.234" / "12,345"
            num = float(re.sub(r"[.,]", "", bruto))
    except ValueError:
        return 0
    fator = {"k": 1e3, "mil": 1e3, "m": 1e6, "mi": 1e6, "b": 1e9, "bi": 1e9}.get(suf, 1)
    return int(num * fator)


