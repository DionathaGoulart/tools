def carregar_config():
    cfg = carregar_json(CONFIG_FILE, None)
    if cfg is None:
        cfg = {"canais": SEED_CANAIS}
        salvar_json(CONFIG_FILE, cfg)
    return cfg


def coletar_radar(force=False):
    cache = carregar_json(RADAR_FILE, None)
    if cache and not force:
        ts = parse_iso(cache.get("ts", ""))
        if ts and (agora_utc() - ts).total_seconds() < CACHE_RADAR_HORAS * 3600:
            return cache

    cfg = carregar_config()
    nota("coletando: guerra, patches, reddit e canais…")

    snapshot = {"ts": agora_utc().isoformat(), "falhas": []}
    with ThreadPoolExecutor(max_workers=8) as ex:
        jobs = {
            "ordem": ex.submit(fetch_ordem),
            "despachos": ex.submit(fetch_despachos),
            "patches": ex.submit(fetch_patches),
            "reddit": ex.submit(fetch_reddit),
            "meu_canal": ex.submit(fetch_canal, CANAL_PROPRIO),
        }
        jobs_canais = [ex.submit(fetch_canal, c) for c in cfg["canais"]]

        # fonte fora do ar → reaproveita a última coleta boa (melhor dado velho
        # que seção sumida; a nota de falha diz a idade)
        for chave, fut in jobs.items():
            try:
                snapshot[chave] = fut.result()
            except Exception as e:
                velho = (cache or {}).get(chave)
                snapshot[chave] = velho
                nota = f"{chave}: {type(e).__name__}"
                if velho:
                    nota += f", mostrando coleta de {idade_humana(cache['ts'])}"
                snapshot["falhas"].append(nota)
        canais = []
        for cfg_c, fut in zip(cfg["canais"], jobs_canais):
            try:
                canais.append(marcar_outliers(fut.result()))
            except Exception as e:
                velho = next((c for c in (cache or {}).get("canais", [])
                              if c.get("id") == cfg_c["id"]), None)
                if velho:
                    canais.append(velho)
                snapshot["falhas"].append(f"canal {cfg_c['nome']}: {type(e).__name__}")
        snapshot["canais"] = canais

    if not any(snapshot.get(k) for k in ("ordem", "despachos", "patches", "canais")):
        die("nenhuma fonte respondeu — sem internet? Tente de novo.")
    salvar_json(RADAR_FILE, snapshot)
    marcar_radar()
    return snapshot


def janela_guerra(s):
    """Cabeçalho do radar: a Ordem Maior ativa dentro de uma janela de terminal."""
    ordens = s.get("ordem") or []
    linhas = []
    if ordens:
        o = ordens[0]
        linhas.append(f"{ui.ACC}{ui.BOLD}"
                      f"{resumir(str(o['titulo']).upper(), ui.cf)}{ui.RESET}")
        detalhe = " · ".join(x for x in (
            f"EXPIRA EM {str(o['restante']).upper()}" if o.get("restante") else "",
            f"{o['medalhas']} MEDALHAS" if o.get("medalhas") else "") if x)
        if detalhe:
            linhas.append(f"{ui.ACC30}{detalhe}{ui.RESET}")
        briefing = resumir(o.get("briefing") or "", 300)
        if briefing:
            linhas.append("")
            for parte in textwrap.wrap(briefing, ui.cf):
                linhas.append(f"{ui.FG70}{parte}{ui.RESET}")
    else:
        linhas.append(f"{ui.FG40}SEM ORDEM MAIOR ATIVA{ui.RESET}")

    fontes = sum(1 for k in ("ordem", "despachos", "patches", "reddit", "canais")
                 if s.get(k))
    ui.janela(
        "root@goodivers: ~/radar",
        linhas,
        meta=f"SRC: {fontes}/5",
        rodape=f"● COLETA {idade_humana(s['ts']).upper()}",
    )


def render_radar(s):
    ui.modulo("radar", "src: hd2 · steam · reddit · youtube")
    janela_guerra(s)

    for o in (s.get("ordem") or [])[1:]:
        ui.secao(str(o["titulo"]))
        corpo(resumir(o.get("briefing") or "", 300), recuo=2)

    if s.get("despachos"):
        print()
        ui.secao("despachos da super terra")
        for d in s["despachos"][:3]:
            ui.item(f"{idade_humana(d['quando']):>8}", resumir(d["texto"], 180))

    if s.get("patches"):
        print()
        ui.secao("oficial · steam")
        for p in s["patches"]:
            ui.item(f"{idade_humana(p['quando']):>8}", p["titulo"])

    if s.get("reddit"):
        print()
        ui.secao("quente no r/helldivers")
        for p in s["reddit"]:
            texto = resumir(p["titulo"], 90)
            if p["flair"]:
                texto += " " + ui.chip(p["flair"]) + ui.FG70
            ui.item(f"↑{p['score']:>5}", texto)

    if s.get("canais"):
        print()
        ui.secao("canais do nicho")
        for c in s["canais"]:
            print(f"  {ui.forte(str(c['nome']).upper())}")
            for v in c["videos"][:3]:
                texto = resumir(v["titulo"], 72)
                if v.get("outlier"):
                    texto += " " + ui.chip("outlier") + ui.FG70
                ui.item(f"{fmt_views(v['views']):>7} · {idade_humana(v['publicado']):>8}",
                        texto)

    if s.get("meu_canal") and s["meu_canal"]["videos"]:
        print()
        ui.secao("seu canal · goodivers")
        for v in s["meu_canal"]["videos"][:5]:
            ui.item(f"{fmt_views(v['views']):>7} · {idade_humana(v['publicado']):>8}",
                    resumir(v["titulo"], 72))

    print()
    if s.get("falhas"):
        ui.aviso("offline", ", ".join(s["falhas"]))
    ui.aviso("legenda", "[OUTLIER] = VIEWS/DIA >= 2X A MEDIANA DO PROPRIO CANAL")
    ui.proximo("goodivers ideias")
    print()


