def modelos_configurados():
    env = os.environ.get("OPENROUTER_MODEL", "").strip()
    if env:
        return [m.strip() for m in env.split(",") if m.strip()]
    return DEFAULT_MODELS


def chamar_llm(messages, max_tokens=3000, temperature=0.9, json_tipo=None):
    """Chama a OpenRouter tentando cada modelo em ordem.

    Com json_tipo ("array"|"objeto"), valida o JSON antes de aceitar a resposta —
    modelo que devolve JSON quebrado conta como falha e cai pro próximo.
    Retorna (conteudo, modelo); conteudo já parseado quando json_tipo é dado.
    """
    key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if not key:
        die(
            "OPENROUTER_API_KEY não definida (o radar funciona sem; gerar ideias não).\n"
            "  1. Crie uma chave grátis em https://openrouter.ai/keys\n"
            '  2. Adicione ao seu rc:  export OPENROUTER_API_KEY="sk-or-..."'
        )
    erros = []
    for model in modelos_configurados():
        payload = json.dumps({
            "model": model,
            "messages": messages,
            "max_tokens": max_tokens,
            "temperature": temperature,
        }).encode("utf-8")
        req = urllib.request.Request(
            API_URL,
            data=payload,
            headers={
                "Authorization": f"Bearer {key}",
                "Content-Type": "application/json",
                "HTTP-Referer": "https://github.com/DionathaGoulart/tools",
                "X-Title": "goodivers",
            },
        )
        try:
            with urllib.request.urlopen(req, timeout=180) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            content = (data["choices"][0]["message"].get("content") or "").strip()
            if not content:
                erros.append(f"{model}: resposta vazia")
                continue
            if json_tipo is None:
                return content, model
            parsed = extrair_json(content, json_tipo)
            if parsed is not None:
                return parsed, model
            erros.append(f"{model}: não devolveu JSON parseável")
        except urllib.error.HTTPError as e:
            if e.code == 401:
                die("OPENROUTER_API_KEY inválida (HTTP 401).")
            erros.append(f"{model}: HTTP {e.code}")
        except Exception as e:
            erros.append(f"{model}: {type(e).__name__}: {e}")
    die("Todos os modelos falharam:\n  " + "\n  ".join(erros)
        + "\n\nDica: `goodivers -m` lista os modelos :free no ar; "
        "defina OPENROUTER_MODEL pra trocar.")


