def cmd_inspirar(fresh):
    s = coletar_radar(force=fresh)
    nota("varrendo o nicho gringo + o que já existe em PT-BR…")
    with ThreadPoolExecutor(max_workers=3) as ex:
        f_semana = ex.submit(busca_cacheada, "helldivers 2", True, False, fresh)
        f_leaks = ex.submit(busca_cacheada, "helldivers 2 leaks", True, False, fresh)
        f_br = ex.submit(busca_cacheada, "helldivers 2", True, True, fresh)
    gringos, br, falhas = [], [], []
    for nome, fut in (("busca EN", f_semana), ("busca leaks", f_leaks)):
        try:
            gringos += fut.result()
        except Exception as e:
            falhas.append(f"{nome}: {type(e).__name__}")
    try:
        br = f_br.result()
    except Exception as e:
        falhas.append(f"busca BR: {type(e).__name__}")

    # + outliers dos canais monitorados (radar)
    for c in s.get("canais") or []:
        for v in c["videos"]:
            if v.get("outlier"):
                gringos.append({"id": v["id"], "titulo": v["titulo"], "canal": c["nome"],
                                "views": v["views"], "views_txt": "", "duracao": "",
                                "quando": idade_humana(v["publicado"])})
    vistos, candidatos = set(), []
    for v in sorted(gringos, key=lambda x: -x["views"]):
        if v["id"] not in vistos:
            vistos.add(v["id"])
            candidatos.append(v)
    if not candidatos:
        die("nenhum candidato coletado — sem internet? " + "; ".join(falhas))

    linhas_en = "\n".join(
        f"- [id={v['id']}] \"{v['titulo']}\", canal {v['canal']}, "
        f"{fmt_views(v['views'])} views, {v['quando']}" for v in candidatos[:18])
    linhas_br = "\n".join(
        f"- \"{v['titulo']}\" — {v['canal']}, {fmt_views(v['views'])} views, {v['quando']}"
        for v in br[:8]) or "(quase nada — o nicho PT-BR está vazio)"
    prompt = (
        "MISSÃO: escolher o que o canal deve ADAPTAR pra PT-BR agora.\n\n"
        f"VÍDEOS GRINGOS PERFORMANDO (semana):\n{linhas_en}\n\n"
        f"O QUE JÁ EXISTE EM PT-BR (concorrência local, semana):\n{linhas_br}\n\n"
        "Escolha os 6 melhores candidatos pra reproduzir em PT-BR, considerando: encaixe "
        "na linha do canal (updates, novidades, leaks, dicas), demanda comprovada lá fora, "
        "buraco na cobertura BR, e esforço de produção. Adaptar = re-roteirizar com "
        "gameplay própria e contexto BR, NUNCA traduzir/copiar (reused content mata canal).\n"
        "Devolva SOMENTE um array JSON onde cada item tem:\n"
        '  "original" (título do vídeo gringo), "canal" (de quem é), '
        '"origem_id" (o id EXATO do vídeo gringo da lista que você está adaptando), '
        '"por_que_performa" (1 frase: o gatilho que fez esse vídeo andar), '
        '"titulo_ptbr" (título pronto ≤60 chars pro seu vídeo), '
        '"adaptacao" (1-2 frases: o que mudar/cortar/adicionar pro público BR), '
        '"checar" (o que validar no jogo/patch antes de gravar, pra não sair desatualizado).'
    )
    planos, model = chamar_llm(
        [{"role": "system", "content": system_estrategista(s)},
         {"role": "user", "content": prompt}], max_tokens=6000, json_tipo="array")
    by_id = {v["id"]: v for v in candidatos}
    for p in planos:
        oid = str(p.get("origem_id") or "").strip()
        p["link"] = link_youtube(oid) if oid in by_id else ""

    ui.modulo("inspirar", f"model: {model}")
    ui.kv("ADAPTACOES PT-BR", str(len(planos)))
    for i, p in enumerate(planos, 1):
        print()
        ui.item(f"{i:>2}.", str(p.get("titulo_ptbr", "?")), ui.chip("pt-br"))
        print(f"      {ui.apagado('ORIGINAL: ' + str(p.get('original', '?')))}"
              f" {ui.chip(resumir(str(p.get('canal', '?')), 20))}")
        if p.get("link"):
            print(f"      {ui.apagado('LINK: ' + str(p['link']))}")
        if p.get("por_que_performa"):
            print(f"      {ui.apagado('POR QUE PERFORMA: ' + str(p['por_que_performa']))}")
        corpo(f"ADAPTACAO: {p.get('adaptacao', '')}", recuo=6)
        if p.get("checar"):
            print(f"      {ui.ALERTA}[ CHECAR ]{ui.RESET} {ui.FG70}{p['checar']}{ui.RESET}")
    print()
    if falhas:
        ui.aviso("offline", "; ".join(falhas))
    ui.proximo('goodivers pacote "<titulo escolhido>"')
    print()


def resolver_canal(entrada):
    """Aceita @handle, URL de canal/vídeo ou ID UC… e devolve {nome, id}."""
    e = entrada.strip()
    m = re.fullmatch(r"UC[0-9A-Za-z_-]{22}", e)
    canal_id = m.group(0) if m else None
    if not canal_id:
        if e.startswith("http"):
            url = e
        else:
            url = f"https://www.youtube.com/@{e.lstrip('@')}"
        html = http_get(url, {"User-Agent": UA_BROWSER, "Accept-Language": "en"}).decode(
            "utf-8", errors="replace")
        for padrao in (r'"externalId":"(UC[0-9A-Za-z_-]{22})"',
                       r'"channelId":"(UC[0-9A-Za-z_-]{22})"',
                       r'channel_id=(UC[0-9A-Za-z_-]{22})'):
            m = re.search(padrao, html)
            if m:
                canal_id = m.group(1)
                break
        if not canal_id:
            die(f"não achei o ID do canal em {url} — tente colar a URL completa do canal.")
    info = fetch_canal({"nome": "?", "id": canal_id})
    return {"nome": info["nome"], "id": canal_id}


def cmd_canais(resto, como_json=False):
    cfg = carregar_config()
    acao = resto[0] if resto else "list"
    if como_json and acao == "list":
        imprimir_json(cfg["canais"])
        return
    if acao == "add" and len(resto) >= 2:
        canal = resolver_canal(resto[1])
        if any(c["id"] == canal["id"] for c in cfg["canais"]):
            die(f"{canal['nome']} já está na lista.")
        cfg["canais"].append(canal)
        salvar_json(CONFIG_FILE, cfg)
        RADAR_FILE.unlink(missing_ok=True)
        ui.modulo("canais", "add")
        ui.ok(f"monitorando {canal['nome']}")
        ui.kv("CHANNEL_ID", canal["id"])
        ui.kv("CANAIS NA LISTA", str(len(cfg["canais"])))
        print()
    elif acao == "rm" and len(resto) >= 2:
        alvo = resto[1].lower()
        antes = len(cfg["canais"])
        cfg["canais"] = [c for c in cfg["canais"]
                         if alvo not in c["nome"].lower() and alvo != c["id"].lower()]
        if len(cfg["canais"]) == antes:
            die(f"nenhum canal casa com \"{resto[1]}\".")
        salvar_json(CONFIG_FILE, cfg)
        RADAR_FILE.unlink(missing_ok=True)
        ui.modulo("canais", "rm")
        ui.ok("canal removido")
        ui.kv("CANAIS NA LISTA", str(len(cfg["canais"])))
        print()
    else:
        ui.modulo("canais", "src: config.json")
        ui.kv("MONITORADOS", str(len(cfg["canais"])))
        print()
        for c in cfg["canais"]:
            ui.item("·", str(c["nome"]), str(c["id"]))
        print()
        ui.proximo("goodivers canais add @canal", "adicionar (handle, url ou id):")
        ui.proximo("goodivers canais rm nome", "remover:                      ")
        print()


