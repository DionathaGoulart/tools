    print()


# ---------------------------------------------------------------- tradução do radar

def _slots_traduziveis(s):
    """(dict, campo_origem, campo_destino) de tudo que aparece no radar em inglês.
    Grava em *_pt (nunca destrói o original). Títulos de vídeo dos canais ganham
    o par pra render mostrar original + PT."""
    slots = []
    for o in s.get("ordem") or []:
        slots.append((o, "titulo", "titulo_pt"))
        slots.append((o, "briefing", "briefing_pt"))
    for d in (s.get("despachos") or [])[:3]:
        slots.append((d, "texto", "texto_pt"))
    for p in s.get("patches") or []:
        slots.append((p, "titulo", "titulo_pt"))
    for p in s.get("reddit") or []:
        slots.append((p, "titulo", "titulo_pt"))
    for c in s.get("canais") or []:
        for v in c.get("videos", [])[:3]:
            slots.append((v, "titulo", "titulo_pt"))
    return slots


def _traduzir_lista(textos):
    """Traduz uma lista de strings EN->PT-BR numa única chamada. Devolve
    {origem: traducao}, ou None se falhar (já imprimiu o aviso)."""
    nota(f"traduzindo {len(textos)} trechos pra PT-BR…")
    prompt = (
        "Traduza para português do Brasil cada item da LISTA. Mantenha em inglês os "
        "nomes próprios de Helldivers 2 (facções Automaton/Terminid/Illuminate, "
        "planetas, armas, stratagems, warbonds, siglas como DSS/SEAF/AMA, 'Major "
        "Order'). Tradução natural, sem explicar, sem numerar.\n"
        f"Devolva SOMENTE um array JSON com EXATAMENTE {len(textos)} objetos, na MESMA "
        'ORDEM da LISTA, cada objeto no formato {"pt": "<tradução>"}.\n\n'
        "LISTA:\n" + json.dumps(textos, ensure_ascii=False)
    )
    try:
        parsed, _ = _llm.chat(
            [{"role": "system",
              "content": "Você traduz conteúdo de Helldivers 2 de inglês pra PT-BR."},
             {"role": "user", "content": prompt}],
            max_tokens=3500, temperature=0.3, json_tipo="array")
    except LLMError as e:
        motivo = {"no_key": "sem OPENROUTER_API_KEY",
                  "auth": "OPENROUTER_API_KEY inválida"}.get(e.kind, "LLM falhou")
        ui.aviso("traducao", f"{motivo}; radar em inglês")
        return None
    if not isinstance(parsed, list) or len(parsed) != len(textos):
        ui.aviso("traducao", "resposta inesperada; radar em inglês")
        return None
    out = {}
    for src, item in zip(textos, parsed):
        pt = str((item or {}).get("pt") or "").strip()
        if pt:
            out[src] = pt
    return out


def traduzir_radar(s):
    """Preenche campos *_pt no snapshot pra render em PT-BR. Cacheia a tradução
    por `ts` do snapshot em radar_pt.json: 1 chamada LLM por coleta, reusada nas
    6h seguintes. Sem key ou erro de rede: avisa e mantém o inglês (nunca quebra)."""
    pares = [(obj, dst, txt) for obj, src, dst in _slots_traduziveis(s)
             if (txt := str(obj.get(src) or "").strip())]
    if not pares:
        return

    cache = carregar_json(RADAR_PT_FILE, {})
    mapa = dict(cache.get("mapa", {})) if cache.get("ts") == s.get("ts") else {}

    faltando = sorted({txt for _, _, txt in pares if txt not in mapa})
    if faltando:
        novos = _traduzir_lista(faltando)
        if novos is None:
            return                                  # falhou; mantém inglês
        mapa.update(novos)
        salvar_json(RADAR_PT_FILE, {"ts": s.get("ts"), "mapa": mapa})

    for obj, dst, txt in pares:
        if mapa.get(txt):
            obj[dst] = mapa[txt]


