#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
goodpet — um tamagotchi no terminal.

Você adota um ovo. Ele choca, vira bebê, criança e adulto — se você cuidar.
Fome, felicidade, energia e higiene caem com o tempo (inclusive com o terminal
fechado): descuido dá doença, doença sem cura dá lápide. Comandos rápidos pra
cuidar no dia a dia e um modo vivo (goodpet watch) com o bicho animado na tela.

Privacidade: tudo fica em ~/.goodpet na sua máquina. Nenhum request de rede,
nenhuma telemetria — só você e o bicho.

Requer: Python 3, nada mais.
"""

import argparse
import json
import os
import random
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "lib"))
from retro import Retro, largura  # noqa: E402

ui = Retro(env_prefix="GOODPET")

BASE_DIR = Path(os.environ.get("GOODPET_DIR", Path.home() / ".goodpet"))
PET_FILE = BASE_DIR / "pet.json"

ANIM = ui.cor and not os.environ.get("GOODPET_SEM_ANIM")

try:
    import select
    import termios
    import tty
    TEM_TERMIOS = True
except ImportError:  # Windows: sem termios — watch degrada pros subcomandos
    TEM_TERMIOS = False

# ---------------------------------------------------------------- balanceamento

HORA = 3600.0

# taxas por hora; aplicadas proporcionalmente a cada passo da simulação
TAXAS_ACORDADO = {"fome": -2.5, "energia": -5.0, "higiene": -1.5, "felicidade": -1.5}
TAXAS_DORMINDO = {"fome": -1.25, "energia": 12.5, "higiene": -0.75, "felicidade": 0.0}
ENERGIA_DOENTE = -2.0          # extra por hora enquanto doente
FEL_FOME_BAIXA = -3.0          # extra por hora com fome < 25
FEL_HIGIENE_BAIXA = -3.0       # extra por hora com higiene < 25
FEL_DOENTE = -4.0              # extra por hora doente

HIGIENE_LIMIAR = 20.0
DOENCA_HIGIENE_S = 6 * HORA    # higiene baixa contínua até adoecer
DOENCA_FOME_S = 12 * HORA      # fome zerada contínua até adoecer
MORTE_FOME_S = 24 * HORA       # fome zerada contínua até morrer
MORTE_DOENCA_S = 48 * HORA     # doente sem cura até morrer

FASES = ["ovo", "bebe", "crianca", "adulto"]
IDADE_MIN = {"bebe": 1 * HORA, "crianca": 24 * HORA, "adulto": 72 * HORA}
FASE_LABEL = {"ovo": "OVO", "bebe": "BEBÊ", "crianca": "CRIANÇA", "adulto": "ADULTO"}

NOMES_PADRAO = ["Bilu", "Pixel", "Trufa", "Nhac", "Byte", "Paçoca", "Gigi", "Bug"]

# ---------------------------------------------------------------- arte

ARTE_OVO = [
    [
        "  .-\"\"-.",
        " /      \\",
        "|  .  .  |",
        " \\      /",
        "  `-..-'",
    ],
    [
        "  .-\"\"-.",
        " /      \\",
        "|  o  o  |",
        " \\      /",
        "  `-..-'",
    ],
]

ARTE_MORTO = [
    "   _______",
    "  /       \\",
    " |  R I P  |",
    " |         |",
    "_|_________|_",
]


def _f_bebe(oe, od, boca, dec=""):
    return [
        f"        {dec}",
        "   .---.",
        f"  ( {oe} {od} )",
        f"   \\_{boca}_/",
        "",
    ]


def _f_crianca(oe, od, boca, dec=""):
    return [
        f"   .---.  {dec}",
        f"  ( {oe} {od} )",
        f"  _\\_{boca}_/_",
        "  / |   | \\",
        "    d   b",
    ]


def _f_adulto(oe, od, boca, dec=""):
    return [
        f"    .---.  {dec}",
        f"   ( {oe} {od} )",
        f"  /(  {boca}  )\\",
        "   (_____)",
        "    J   L",
    ]


def _poses(f):
    return {
        "normal": [f("o", "o", "-"), f("-", "o", "-")],
        "feliz": [f("^", "^", "u", "*"), f("^", "^", "u", " *")],
        "triste": [f(";", ";", "n"), f(";", ";", "n", ".")],
        "doente": [f("x", "x", "~", "~"), f("x", "x", "~", " ~")],
        "dormindo": [f("-", "-", "o", "z"), f("-", "-", "-", "z Z")],
    }


ARTE = {
    "ovo": {"normal": ARTE_OVO},
    "bebe": _poses(_f_bebe),
    "crianca": _poses(_f_crianca),
    "adulto": _poses(_f_adulto),
}


def pose_do(estado):
    if estado["morto"]:
        return "morto"
    if estado["fase"] == "ovo":
        return "normal"
    if estado["dormindo"]:
        return "dormindo"
    if estado["doente"]:
        return "doente"
    menor = min(estado["stats"].values())
    if menor < 30:
        return "triste"
    if menor > 70:
        return "feliz"
    return "normal"


def quadro(estado, tick=0):
    """Frame da arte, bloco inteiro centrado na largura útil da janela."""
    if estado["morto"]:
        fr = ARTE_MORTO
    else:
        poses = ARTE[estado["fase"]]
        frames = poses.get(pose_do(estado), poses["normal"])
        fr = frames[tick % 2 if ANIM else 0]
    bloco = max(largura(ln) for ln in fr)
    esq = max(0, (ui.cf - bloco) // 2)
    return [" " * esq + ln for ln in fr]


# ---------------------------------------------------------------- estado

def carregar_json(caminho, padrao):
    if caminho.exists():
        try:
            return json.loads(caminho.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    return padrao


def salvar_json(caminho, obj):
    caminho.parent.mkdir(parents=True, exist_ok=True)
    caminho.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")


def novo_pet(nome, agora):
    return {
        "schema": 1,
        "nome": nome,
        "nascido_em": agora,
        "last_tick": agora,
        "fase": "ovo",
        "stats": {"fome": 100.0, "felicidade": 100.0, "energia": 100.0, "higiene": 100.0},
        "dormindo": False,
        "doente": False,
        "morto": False,
        "morte": None,
        "doente_desde": None,
        "fome_zero_desde": None,
        "higiene_baixa_desde": None,
        "totais": {"refeicoes": 0, "brincadeiras": 0, "banhos": 0, "curas": 0},
        "historico": [{"t": agora, "ev": "adotado"}],
    }


def migrar(estado):
    """Completa chaves ausentes com defaults — à prova de pet.json antigo."""
    base = novo_pet(estado.get("nome") or "Bilu", float(estado.get("nascido_em") or time.time()))
    for chave, valor in base.items():
        estado.setdefault(chave, valor)
    for chave, valor in base["stats"].items():
        estado["stats"].setdefault(chave, valor)
    for chave, valor in base["totais"].items():
        estado["totais"].setdefault(chave, valor)
    estado["schema"] = 1
    return estado


def registrar(estado, ev, agora):
    estado["historico"].append({"t": agora, "ev": ev})
    del estado["historico"][:-50]


def idade_s(estado, agora):
    fim = estado["morte"]["t"] if estado["morto"] and estado["morte"] else agora
    return max(0.0, fim - estado["nascido_em"])


def fmt_idade(seg):
    d = int(seg // 86400)
    h = int(seg % 86400 // 3600)
    m = int(seg % 3600 // 60)
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}min"
    return f"{m}min"


# ---------------------------------------------------------------- motor

def _clamp(v):
    return max(0.0, min(100.0, v))


def _morrer(estado, causa, agora):
    estado["morto"] = True
    estado["morte"] = {"t": agora, "causa": causa}
    estado["dormindo"] = False
    registrar(estado, f"morreu:{causa}", agora)


def _evoluir(estado, agora):
    eventos = []
    idade = agora - estado["nascido_em"]
    while estado["fase"] != "adulto":
        prox = FASES[FASES.index(estado["fase"]) + 1]
        if idade < IDADE_MIN[prox]:
            break
        if estado["fase"] != "ovo" and estado["doente"]:
            break
        estado["fase"] = prox
        ev = "chocou" if prox == "bebe" else f"evoluiu:{prox}"
        registrar(estado, ev, agora)
        eventos.append(ev)
    return eventos


def passo(estado, dt, agora):
    """Avança dt segundos terminando em `agora`. Devolve eventos disparados."""
    if estado["morto"] or dt <= 0:
        return []
    if estado["fase"] == "ovo":
        return _evoluir(estado, agora)  # ovo é inerte: só choca

    eventos = []
    s = estado["stats"]
    h = dt / HORA
    taxas = TAXAS_DORMINDO if estado["dormindo"] else TAXAS_ACORDADO

    s["fome"] = _clamp(s["fome"] + taxas["fome"] * h)
    energia = taxas["energia"] + (ENERGIA_DOENTE if estado["doente"] else 0.0)
    s["energia"] = _clamp(s["energia"] + energia * h)
    s["higiene"] = _clamp(s["higiene"] + taxas["higiene"] * h)
    fel = taxas["felicidade"]
    if not estado["dormindo"]:
        if s["fome"] < 25:
            fel += FEL_FOME_BAIXA
        if s["higiene"] < 25:
            fel += FEL_HIGIENE_BAIXA
        if estado["doente"]:
            fel += FEL_DOENTE
    s["felicidade"] = _clamp(s["felicidade"] + fel * h)

    if not estado["dormindo"] and s["energia"] <= 0:
        estado["dormindo"] = True
        s["felicidade"] = _clamp(s["felicidade"] - 10)
        registrar(estado, "desmaiou", agora)
        eventos.append("desmaiou")
    elif estado["dormindo"] and s["energia"] >= 100:
        estado["dormindo"] = False
        registrar(estado, "acordou", agora)
        eventos.append("acordou")

    if s["higiene"] < HIGIENE_LIMIAR:
        if estado["higiene_baixa_desde"] is None:
            estado["higiene_baixa_desde"] = agora
    else:
        estado["higiene_baixa_desde"] = None
    if s["fome"] <= 0:
        if estado["fome_zero_desde"] is None:
            estado["fome_zero_desde"] = agora
    else:
        estado["fome_zero_desde"] = None

    if not estado["doente"]:
        suja = estado["higiene_baixa_desde"]
        vazia = estado["fome_zero_desde"]
        if (suja is not None and agora - suja >= DOENCA_HIGIENE_S) or (
            vazia is not None and agora - vazia >= DOENCA_FOME_S
        ):
            estado["doente"] = True
            estado["doente_desde"] = agora
            registrar(estado, "adoeceu", agora)
            eventos.append("adoeceu")

    vazia = estado["fome_zero_desde"]
    if vazia is not None and agora - vazia >= MORTE_FOME_S:
        _morrer(estado, "fome", agora)
        return eventos + ["morreu:fome"]
    if estado["doente"] and agora - estado["doente_desde"] >= MORTE_DOENCA_S:
        _morrer(estado, "doenca", agora)
        return eventos + ["morreu:doenca"]

    return eventos + _evoluir(estado, agora)


def simular(estado, agora):
    """Catch-up offline: replay em passos fixos de 60 s desde last_tick."""
    eventos = []
    t = float(estado.get("last_tick", agora))
    if agora < t:  # relógio voltou — só re-estampa
        estado["last_tick"] = agora
        return estado, eventos
    passos = 0
    while t < agora and passos < 200000:
        dt = min(60.0, agora - t)
        t += dt
        eventos += passo(estado, dt, t)
        passos += 1
    estado["last_tick"] = agora
    return estado, eventos


# ---------------------------------------------------------------- ações

def _indisponivel(estado):
    if estado["morto"]:
        return "seu pet morreu — adote outro com goodpet new"
    if estado["fase"] == "ovo":
        return "ainda é um ovo — espere chocar"
    return None


def acao_feed(estado, agora):
    recusa = _indisponivel(estado)
    if recusa:
        return estado, recusa
    if estado["dormindo"]:
        return estado, f"{estado['nome']} está dormindo — goodpet wake primeiro"
    if estado["stats"]["fome"] >= 95:
        return estado, "de barriga cheia — tenta de novo mais tarde"
    estado["stats"]["fome"] = _clamp(estado["stats"]["fome"] + 30)
    estado["stats"]["felicidade"] = _clamp(estado["stats"]["felicidade"] + 2)
    estado["fome_zero_desde"] = None
    estado["totais"]["refeicoes"] += 1
    return estado, None


def acao_play(estado, agora):
    recusa = _indisponivel(estado)
    if recusa:
        return estado, recusa
    if estado["dormindo"]:
        return estado, f"{estado['nome']} está dormindo — goodpet wake primeiro"
    if estado["doente"]:
        return estado, "doente não brinca — goodpet heal primeiro"
    if estado["stats"]["energia"] < 15:
        return estado, "exausto demais — deixa dormir um pouco"
    s = estado["stats"]
    s["felicidade"] = _clamp(s["felicidade"] + 25)
    s["energia"] = _clamp(s["energia"] - 10)
    s["fome"] = _clamp(s["fome"] - 5)
    s["higiene"] = _clamp(s["higiene"] - 5)
    estado["totais"]["brincadeiras"] += 1
    return estado, None


def acao_clean(estado, agora):
    recusa = _indisponivel(estado)
    if recusa:
        return estado, recusa
    if estado["dormindo"]:
        return estado, f"{estado['nome']} está dormindo — goodpet wake primeiro"
    estado["stats"]["higiene"] = 100.0
    estado["stats"]["felicidade"] = _clamp(estado["stats"]["felicidade"] + 5)
    estado["higiene_baixa_desde"] = None
    estado["totais"]["banhos"] += 1
    return estado, None


def acao_sleep(estado, agora):
    recusa = _indisponivel(estado)
    if recusa:
        return estado, recusa
    if estado["dormindo"]:
        return estado, "já está dormindo"
    estado["dormindo"] = True
    registrar(estado, "dormiu", agora)
    return estado, None


def acao_wake(estado, agora):
    recusa = _indisponivel(estado)
    if recusa:
        return estado, recusa
    if not estado["dormindo"]:
        return estado, "já está acordado"
    estado["dormindo"] = False
    if estado["stats"]["energia"] < 30:
        estado["stats"]["felicidade"] = _clamp(estado["stats"]["felicidade"] - 5)
    registrar(estado, "acordou", agora)
    return estado, None


def acao_heal(estado, agora):
    recusa = _indisponivel(estado)
    if recusa:
        return estado, recusa
    if not estado["doente"]:
        return estado, "não está doente"
    estado["doente"] = False
    estado["doente_desde"] = None
    estado["stats"]["felicidade"] = _clamp(estado["stats"]["felicidade"] + 5)
    estado["totais"]["curas"] += 1
    registrar(estado, "curado", agora)
    return estado, None


ACOES = {
    "feed": (acao_feed, "nhac! fome +30"),
    "play": (acao_play, "boa! felicidade +25"),
    "clean": (acao_clean, "banho tomado! higiene no talo"),
    "sleep": (acao_sleep, "boa noite"),
    "wake": (acao_wake, "bom dia"),
    "heal": (acao_heal, "curado! felicidade +5"),
}


def executar_acao(estado, chave, agora, alternar_sono=False):
    """Aplica uma ação; devolve (estado, mensagem, sucesso)."""
    if alternar_sono and chave == "sleep" and estado["dormindo"]:
        chave = "wake"
    fn, sucesso = ACOES[chave]
    estado, recusa = fn(estado, agora)
    return estado, (recusa or sucesso), recusa is None


# ---------------------------------------------------------------- render

ROTULOS_EV = {
    "adotado": "chegou em casa",
    "chocou": "o ovo chocou!",
    "adoeceu": "ficou doente",
    "curado": "foi curado",
    "dormiu": "foi dormir",
    "acordou": "acordou",
    "desmaiou": "desmaiou de cansaço",
}
CAUSA_LABEL = {"fome": "fome", "doenca": "doença"}


def rotulo_ev(ev):
    if ev.startswith("evoluiu:"):
        return f"evoluiu pra {FASE_LABEL[ev.split(':', 1)[1]]}"
    if ev.startswith("morreu:"):
        return f"morreu de {CAUSA_LABEL.get(ev.split(':', 1)[1], '?')}"
    return ROTULOS_EV.get(ev, ev)


def _linha_estado(estado, msg=""):
    if msg:
        return f"{ui.ACC}{ui.BOLD}{msg}{ui.RESET}"
    if estado["morto"]:
        causa = CAUSA_LABEL.get((estado["morte"] or {}).get("causa", ""), "?")
        return f"{ui.ALERTA}morreu de {causa} — goodpet new pra recomeçar{ui.RESET}"
    if estado["fase"] == "ovo":
        return f"{ui.FG40}chocando... o ovo abre com 1h de vida{ui.RESET}"
    partes = []
    if estado["dormindo"]:
        partes.append(ui.chip("dormindo"))
    if estado["doente"]:
        partes.append(ui.chip("doente") + f" {ui.ALERTA}goodpet heal!{ui.RESET}")
    if not partes:
        return f"{ui.FG40}tudo em ordem{ui.RESET}"
    return "  ".join(partes)


def linhas_card(estado, agora, tick=0, msg=""):
    linhas = [f"{ui.ACC}{ln}{ui.RESET}" for ln in quadro(estado, tick)]
    linhas.append("")
    nome = estado["nome"]
    if estado["morto"]:
        vida = fmt_idade(idade_s(estado, agora))
        cab = f"{ui.ACC}{ui.BOLD}{nome.upper()}{ui.RESET}  {ui.FG40}viveu {vida}{ui.RESET}"
    else:
        idade = fmt_idade(idade_s(estado, agora))
        cab = (
            f"{ui.ACC}{ui.BOLD}{nome.upper()}{ui.RESET}  "
            f"{ui.chip(FASE_LABEL[estado['fase']])}  {ui.FG40}idade {idade}{ui.RESET}"
        )
    linhas.append(cab)
    linhas.append("")
    for chave, rotulo in (
        ("fome", "FOME"),
        ("felicidade", "FELICIDADE"),
        ("energia", "ENERGIA"),
        ("higiene", "HIGIENE"),
    ):
        v = int(round(estado["stats"][chave]))
        linhas.append(f"{ui.FG40}{rotulo:<11}{ui.RESET}{ui.barra(v, 100, 18)}")
    linhas.append("")
    linhas.append(_linha_estado(estado, msg))
    return linhas


def _rodape_estado(estado):
    if estado["morto"]:
        return "● MORTO"
    if estado["doente"]:
        return "● DOENTE"
    if estado["dormindo"]:
        return "● DORMINDO"
    if estado["fase"] == "ovo":
        return "● CHOCANDO"
    return "● SAUDAVEL"


def frame_card(estado, agora, tick=0, msg="", rodape="", meta=""):
    """Janela completa como lista de linhas prontas (pra print ou repaint)."""
    import io
    from contextlib import redirect_stdout

    buf = io.StringIO()
    with redirect_stdout(buf):
        ui.janela(
            f"root@goodpet: ~/{estado['nome'].lower()}",
            linhas_card(estado, agora, tick, msg),
            meta=meta or f"PID: {os.getpid() % 1000}",
            rodape=rodape or _rodape_estado(estado),
        )
    return buf.getvalue().splitlines()


def render_card(estado, agora, revelar=False):
    print()
    for ln in frame_card(estado, agora):
        print(ln)
        if revelar and ANIM:
            time.sleep(0.012)


def mostrar_offline(eventos):
    if not eventos:
        return
    print()
    ui.aviso("enquanto você esteve fora")
    for ev in eventos[-8:]:
        ui.item("·", rotulo_ev(ev))


# ---------------------------------------------------------------- comandos

def die(msg):
    linhas = str(msg).split("\n")
    print(f"  {ui.ALERTA}[ ERRO ]{ui.RESET} {linhas[0]}", file=sys.stderr)
    for extra in linhas[1:]:
        print(f"          {ui.FG40}{extra.strip()}{ui.RESET}", file=sys.stderr)
    sys.exit(1)


def exigir_pet(agora):
    """Carrega, migra, simula o tempo offline e persiste. (estado, eventos)."""
    estado = carregar_json(PET_FILE, None)
    if not isinstance(estado, dict):
        die("nenhum pet por aqui ainda.\nAdote um: goodpet new <nome>")
    estado = migrar(estado)
    estado, eventos = simular(estado, agora)
    salvar_json(PET_FILE, estado)
    return estado, eventos


def cmd_status():
    agora = time.time()
    estado, eventos = exigir_pet(agora)
    render_card(estado, agora, revelar=True)
    mostrar_offline(eventos)
    print()
    if estado["morto"]:
        ui.proximo("goodpet new <nome>")
    elif estado["doente"]:
        ui.proximo("goodpet heal")
    print()


def cmd_new(nome, forcar):
    agora = time.time()
    atual = carregar_json(PET_FILE, None)
    if isinstance(atual, dict) and not migrar(atual)["morto"] and not forcar:
        die(
            f"{atual.get('nome', 'seu pet')} ainda está vivo!\n"
            "Pra abandonar e recomeçar: goodpet new <nome> --forcar"
        )
    nome = (nome or random.choice(NOMES_PADRAO)).strip()[:20]
    estado = novo_pet(nome, agora)
    salvar_json(PET_FILE, estado)
    render_card(estado, agora, revelar=True)
    print()
    ui.ok(f"{nome} adotado")
    ui.proximo("goodpet watch")
    print()


def cmd_acao(chave):
    agora = time.time()
    estado, eventos = exigir_pet(agora)
    estado, msg, sucesso = executar_acao(estado, chave, agora)
    salvar_json(PET_FILE, estado)
    render_card(estado, agora)
    mostrar_offline(eventos)
    print()
    if sucesso:
        ui.ok(msg)
    else:
        ui.aviso("recusado", msg)
        if estado["morto"]:
            ui.proximo("goodpet new <nome>")
    print()


def cmd_log():
    agora = time.time()
    estado, _ = exigir_pet(agora)
    ui.modulo("pet_log", f"~/{estado['nome'].lower()}")
    for item in estado["historico"][-20:]:
        quando = datetime.fromtimestamp(item["t"]).strftime("%d/%m %H:%M")
        ui.kv(quando, rotulo_ev(item["ev"]).upper())
    print()
    t = estado["totais"]
    ui.regra()
    ui.kv("REFEICOES", str(t["refeicoes"]))
    ui.kv("BRINCADEIRAS", str(t["brincadeiras"]))
    ui.kv("BANHOS", str(t["banhos"]))
    ui.kv("CURAS", str(t["curas"]))
    print()


# ---------------------------------------------------------------- watch

TECLAS = {"f": "feed", "p": "play", "l": "clean", "s": "sleep", "h": "heal"}
LEGENDA = "[F]EED [P]LAY [L]IMPAR [S]ONO [H]EAL [Q] SAIR"


def ler_tecla(timeout):
    pronto, _, _ = select.select([sys.stdin], [], [], timeout)
    if pronto:
        return sys.stdin.read(1).lower()
    return ""


def cmd_watch():
    agora = time.time()
    estado, eventos = exigir_pet(agora)
    if not (ui.tty and ui.caixa and TEM_TERMIOS and sys.stdin.isatty()):
        render_card(estado, agora)
        print()
        ui.aviso("modo vivo", "precisa de terminal interativo — use os subcomandos")
        return

    fd = sys.stdin.fileno()
    velho = termios.tcgetattr(fd)
    tick = 0
    msg = ""
    msg_ticks = 0
    if eventos:
        msg, msg_ticks = rotulo_ev(eventos[-1]), 4
    sys.stdout.write("\033[?25l")
    sys.stdout.flush()
    try:
        tty.setcbreak(fd)
        relogio = time.strftime("%H:%M:%S")
        linhas = frame_card(estado, agora, tick, msg, LEGENDA, relogio)
        print()
        for ln in linhas:
            print(ln)
            if ANIM:
                time.sleep(0.012)
        altura = len(linhas)
        proximo_t = time.monotonic() + 1.0
        while True:
            espera = max(0.0, proximo_t - time.monotonic())
            tecla = ler_tecla(espera)
            agora = time.time()
            mudou = False
            if tecla == "q":
                break
            if tecla in TECLAS and not estado["morto"]:
                estado, msg, _ = executar_acao(estado, TECLAS[tecla], agora, alternar_sono=True)
                msg_ticks = 4
                salvar_json(PET_FILE, estado)
                mudou = True
            elif tecla and tecla not in ("\n", "\r", " "):
                pass
            if time.monotonic() >= proximo_t:
                proximo_t += 1.0
                tick += 1
                evs = passo(estado, agora - float(estado["last_tick"]), agora)
                estado["last_tick"] = agora
                if evs:
                    msg, msg_ticks = rotulo_ev(evs[-1]), 4
                    salvar_json(PET_FILE, estado)
                elif tick % 30 == 0:
                    salvar_json(PET_FILE, estado)
                if msg_ticks > 0:
                    msg_ticks -= 1
                    if msg_ticks == 0:
                        msg = ""
                mudou = True
            if mudou:
                relogio = time.strftime("%H:%M:%S")
                linhas = frame_card(estado, agora, tick, msg, LEGENDA, relogio)
                sys.stdout.write(f"\033[{altura}A")
                for ln in linhas:
                    sys.stdout.write(f"\r{ln}\033[K\n")
                sys.stdout.flush()
    except KeyboardInterrupt:
        pass
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, velho)
        salvar_json(PET_FILE, estado)
        sys.stdout.write("\033[?25h\n")
        sys.stdout.flush()


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(
        prog="goodpet",
        description="tamagotchi no terminal: adote, alimente, cuide — ou lápide.",
    )
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("status", help="card do pet (padrão sem argumentos)")
    novo = sub.add_parser("new", help="adota um pet novo")
    novo.add_argument("nome", nargs="?", default="", help="nome do bicho (opcional)")
    novo.add_argument("--forcar", action="store_true", help="abandona o pet vivo atual")
    sub.add_parser("feed", help="alimenta (fome +30)")
    sub.add_parser("play", help="brinca (felicidade +25, cansa)")
    sub.add_parser("clean", help="dá banho (higiene 100)")
    sub.add_parser("sleep", help="põe pra dormir (energia sobe)")
    sub.add_parser("wake", help="acorda")
    sub.add_parser("heal", help="dá remédio quando doente")
    sub.add_parser("watch", help="modo vivo: tela animada com teclas de ação")
    sub.add_parser("log", help="últimos eventos e totais")
    sub.add_parser("temas", help="catálogo de paletas do terminal")
    sub.add_parser("help", help="esta ajuda")
    args = p.parse_args()

    cmd = args.cmd or "status"
    if cmd == "help":
        p.print_help()
    elif cmd == "status":
        cmd_status()
    elif cmd == "new":
        cmd_new(args.nome, args.forcar)
    elif cmd in ACOES:
        cmd_acao(cmd)
    elif cmd == "watch":
        cmd_watch()
    elif cmd == "log":
        cmd_log()
    elif cmd == "temas":
        ui.catalogo_temas()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        sys.exit(130)
