            linha_grafico("►" if i == 0 else " ", w, 16, barra(n, maxw, 20), str(n))
        print()

    ui.secao("tempo medio de resposta")
    for p in st["pessoas"]:
        tempos = st["resp_tempos"][p]
        if tempos:
            med = sorted(tempos)[len(tempos) // 2]
            ui.kv(p[:16].upper(), fmt_dur(timedelta(seconds=med)).upper())
            ui.item(" ", f"mediana de {len(tempos)} respostas")
    print()

    ui.secao("quem puxa assunto")
    tot_ini = sum(st["iniciou"].values()) or 1
    maxi = st["iniciou"].most_common(1)[0][1] if st["iniciou"] else 1
    for i, (p, n) in enumerate(st["iniciou"].most_common()):
        linha_grafico("►" if i == 0 else " ", p, 16,
                      barra(n, maxi), str(n), f"({100*n/tot_ini:.0f}%)")
    print()

    dur, quando = st["vacuo"]
    seq, per = st["streak"]
