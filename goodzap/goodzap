# ---------------------------------------------------------------- openrouter

_llm = LLM("goodzap", DEFAULT_MODELS)


def chamar_llm(messages, max_tokens=1600, temperature=0.85):
    try:
        return _llm.chat(messages, max_tokens=max_tokens, temperature=temperature)
    except LLMError as e:
        if e.kind == "no_key":
            die("OPENROUTER_API_KEY não definida — necessária só pra --roast.\n"
                "  Crie grátis em https://openrouter.ai/keys e:  export OPENROUTER_API_KEY=\"sk-or-...\"\n"
                "  (sem --roast o goodzap roda 100% offline.)")
        if e.kind == "auth":
            die("OPENROUTER_API_KEY inválida (HTTP 401).")
        die("todos os modelos falharam:\n  " + "\n  ".join(e.errors) + "\n  (`goodzap -m` lista os no ar)")


def listar_modelos_free():
    try:
        livres = _llm.free_models()
    except LLMError as e:
        die(e.message)
    ui.modulo("free_models", "src: openrouter")
    ui.kv("DISPONIVEIS", f"{len(livres)} MODELO(S)")
    print()
    ui.secao("modelos")
    for m in livres:
        ui.item("·", m)
    print()
    ui.proximo('export OPENROUTER_MODEL="modelo1,modelo2"', "pra trocar:")
    print()


# ---------------------------------------------------------------- util / main

def die(msg):
    linhas = str(msg).split("\n")
    print(f"  {ui.ALERTA}[ ERRO ]{ui.RESET} {linhas[0]}", file=sys.stderr)
    for extra in linhas[1:]:
        print(f"          {ui.FG40}{extra.strip()}{ui.RESET}", file=sys.stderr)
    sys.exit(1)


def main():
    ap = argparse.ArgumentParser(
        prog="goodzap",
        description="Retrospectiva de uma conversa exportada do WhatsApp (.txt).",
        epilog="exemplos:  goodzap conversa.txt --roast --html retro.html   ·   goodzap temas",
    )
    ap.add_argument("arquivo", nargs="?",
                    help="o .txt exportado do WhatsApp · use \"temas\" pra listar as "
                         "paletas do terminal (GOODZAP_TEMA / RETRO_TEMA)")
    ap.add_argument("--roast", action="store_true",
                    help="camada com LLM: resumo, frases icônicas, apelidos e roast")
    ap.add_argument("--reais", action="store_true",
                    help="com --roast, envia nomes reais em vez de anonimizar (menos privado)")
    ap.add_argument("--html", metavar="ARQ", help="também salva um retrô visual em HTML")
    ap.add_argument("-m", "--modelos", action="store_true", help="lista modelos :free disponíveis")
    args = ap.parse_args()

    if args.arquivo == "temas" and not os.path.isfile("temas"):
        ui.catalogo_temas()
        return
    if args.modelos:
        listar_modelos_free()
        return
    if not args.arquivo:
        ap.print_help()
        return
    if not os.path.isfile(args.arquivo):
        die(f"arquivo não encontrado: {args.arquivo}")

    msgs = parse_arquivo(args.arquivo)
    if len(msgs) < 2:
        die("não achei mensagens reconhecíveis. Exporte pelo WhatsApp em "
            "\"Exportar conversa\" (sem mídia) e passe o .txt.")
    st = calcular(msgs)
    relatorio(st, os.path.basename(args.arquivo))

    texto_llm = None
    if args.roast:
        ui.modulo("llm_wrapped", "src: openrouter")
        if not args.reais:
            ui.aviso("privado", "anonimizando nomes antes de enviar (--reais desliga).")
        ui.aviso("gerando", "resumo e roast…")
        print()
        texto_llm, model = camada_llm(st, msgs, args.reais)
        ui.secao("retro")
        print(f"{ui.FG70}{texto_llm}{ui.RESET}")
        print()
        ui.kv("MODEL", model)
        print()

    if args.html:
        gerar_html(st, texto_llm, args.html)
        ui.ok("html gerado")
        ui.kv("ARQUIVO", args.html)
        print()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        ui.aviso("abortado", "análise interrompida.")
        sys.exit(130)
