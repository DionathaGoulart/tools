    "]+",
    flags=re.UNICODE,
)

# Prefixo de data/hora. Cobre iOS ( [16/07/26, 21:34:12] ) e Android ( 16/07/2026 21:34 - ).
LINHA_RE = re.compile(
    r"^\[?"
    r"(\d{1,2})[/.](\d{1,2})[/.](\d{2,4})"          # data
    r"[,]?\s+"
    r"(\d{1,2}):(\d{2})(?::(\d{2}))?"               # hora
    r"\s*([AaPp][Mm])?"                             # am/pm opcional
    r"\]?"
    r"(?:\s+-\s+|\s+)"                              # separador android " - " ou espaço (iOS)
    r"(.*)$"
)


# ---------------------------------------------------------------- parsing

def detectar_dia_primeiro(texto):
    """Decide UMA vez, olhando o arquivo inteiro, se as datas são dd/mm (BR)
    ou mm/dd (export en-US). Evita interpretar cada linha de um jeito."""
    primeiro_alto = segundo_alto = False
    for linha in texto.splitlines():
        m = LINHA_RE.match(linha)
        if not m:
            continue
        if int(m.group(1)) > 12:
            primeiro_alto = True
        if int(m.group(2)) > 12:
            segundo_alto = True
    if primeiro_alto and not segundo_alto:
        return True
    if segundo_alto and not primeiro_alto:
        return False
    return True  # ambíguo (nenhum dia >12 no período): assume dd/mm


def parse_arquivo(caminho):
    try:
        texto = open(caminho, encoding="utf-8-sig").read()
    except OSError as e:
        die(f"não consegui ler {caminho}: {e}")
    dia_primeiro = detectar_dia_primeiro(texto)
    msgs = []            # (datetime, autor, texto)
    atual = None
    for linha in texto.splitlines():
        m = LINHA_RE.match(linha)
        if m:
            dt = montar_data(m, dia_primeiro)
            resto = m.group(8)
            corpo = re.match(r"([^:]{1,60}?):\s(.*)$", resto, re.DOTALL)
            if not corpo or dt is None:
                atual = None            # linha de sistema (sem "Nome:") — ignora
                continue
            autor = corpo.group(1).strip()
            conteudo = corpo.group(2)
            if any(s in conteudo.lower() for s in LINHAS_SISTEMA):
                atual = None
                continue
            atual = [dt, autor, conteudo]
            msgs.append(atual)
        elif atual is not None:
            atual[2] += "\n" + linha     # continuação de mensagem multi-linha
    return [(dt, a, t) for dt, a, t in msgs]


def montar_data(m, dia_primeiro=True):
    a, b, y, hh, mm, ss, ap = (m.group(i) for i in range(1, 8))
    a, b, y, hh, mm = int(a), int(b), int(y), int(hh), int(mm)
    ss = int(ss) if ss else 0
    if y < 100:
        y += 2000
    if ap:
        ap = ap.lower()
        if ap == "pm" and hh != 12:
            hh += 12
        elif ap == "am" and hh == 12:
            hh = 0
    d, mth = (a, b) if dia_primeiro else (b, a)
    # ordem detectada primeiro; troca só como último recurso (linha fora do padrão)
    for dia, mes in ((d, mth), (mth, d)):
        try:
            return datetime(y, mes, dia, hh, mm, ss)
        except ValueError:
            continue
    return None


def eh_midia(txt):
    t = txt.strip().lower()
    return any(mark in t for mark in MARCADORES_MIDIA) or t == ""


# ---------------------------------------------------------------- estatísticas

def calcular(msgs):
    autores = [a for _, a, _ in msgs]
    pessoas = list(dict.fromkeys(autores))   # ordem de aparição, sem repetir
    st = {
        "pessoas": pessoas,
        "total": len(msgs),
        "inicio": msgs[0][0],
        "fim": msgs[-1][0],
        "por_pessoa": {p: Counter() for p in pessoas},
        "hora": Counter(),
        "dia_semana": Counter(),
        "mes": Counter(),
        "emojis": Counter(),
        "emojis_por_pessoa": {p: Counter() for p in pessoas},
        "palavras": Counter(),
        "iniciou": Counter(),
        "resp_tempos": defaultdict(list),
        "risadas": Counter(),
        "perguntas": Counter(),
        "madrugada": Counter(),
        "dias_ativos": set(),
    }
    GAP_INICIO = timedelta(hours=6)
    anterior = None
    for dt, autor, txt in msgs:
        pp = st["por_pessoa"][autor]
        pp["msgs"] += 1
        st["hora"][dt.hour] += 1
        st["dia_semana"][dt.weekday()] += 1
        st["mes"][f"{dt:%Y-%m}"] += 1
        st["dias_ativos"].add(dt.date())
        if dt.hour < 6:
            st["madrugada"][autor] += 1

        if eh_midia(txt):
            pp["midia"] += 1
        else:
            palavras = re.findall(r"\w+", txt.lower(), re.UNICODE)
            pp["palavras"] += len(palavras)
            pp["chars"] += len(txt)
            for w in palavras:
                if len(w) >= 3 and w not in STOPWORDS and not w.isdigit():
                    st["palavras"][w] += 1
            if re.search(r"(k{3,}|(ha){2,}|(he){2,}|rs{2,}|kkk|😂|🤣)", txt.lower()):
                st["risadas"][autor] += 1
            if txt.rstrip().endswith("?"):
                st["perguntas"][autor] += 1
            for e in EMOJI_RE.findall(txt):
                for ch in e:
                    if ch != "️":
                        st["emojis"][ch] += 1
                        st["emojis_por_pessoa"][autor][ch] += 1

        if anterior is not None:
            pdt, pautor = anterior
            gap = dt - pdt
            if gap >= GAP_INICIO:
                st["iniciou"][autor] += 1
            elif pautor != autor and gap.total_seconds() > 0:
                st["resp_tempos"][autor].append(gap.total_seconds())
        else:
            st["iniciou"][autor] += 1
        anterior = (dt, autor)

    st["vacuo"] = maior_vacuo(msgs)
    st["streak"] = maior_sequencia(st["dias_ativos"])
    return st


def maior_vacuo(msgs):
    maior = timedelta(0)
    quando = None
    for (d1, _, _), (d2, _, _) in zip(msgs, msgs[1:]):
        if d2 - d1 > maior:
            maior, quando = d2 - d1, (d1, d2)
    return maior, quando


def maior_sequencia(dias):
    if not dias:
        return 0, None
    ds = sorted(dias)
    melhor = atual = 1
    ini = fim = ds[0]
    a_ini = ds[0]
    for i in range(1, len(ds)):
        if ds[i] - ds[i - 1] == timedelta(days=1):
            atual += 1
            if atual > melhor:
                melhor, ini, fim = atual, a_ini, ds[i]
        else:
            atual = 1
            a_ini = ds[i]
    return melhor, (ini, fim)


def fmt_dur(td):
    s = int(td.total_seconds())
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    mi = s // 60
    partes = []
    if d:
        partes.append(f"{d}d")
    if h:
        partes.append(f"{h}h")
    if mi and not d:
        partes.append(f"{mi}min")
    return " ".join(partes) or "menos de 1min"


def barra(valor, maximo, larg=24):
    """Barra do style guide: preenchido `█` em ACC, trilho `▒` em ACC15."""
    n = round(larg * valor / maximo) if maximo else 0
    n = max(0, min(larg, n))
    return f"{ui.ACC}{'█' * n}{ui.ACC15}{'▒' * (larg - n)}{ui.RESET}"


def linha_kv(chave, valor):
    """Linha `CHAVE ··· VALOR` já dimensionada pra caber dentro da janela."""
    n = max(2, ui.cf - largura(chave) - largura(valor) - 2)
    return (f"{ui.FG40}{chave}{ui.RESET} {ui.ACC15}{'·' * n}{ui.RESET} "
            f"{ui.ACC}{ui.BOLD}{valor}{ui.RESET}")


