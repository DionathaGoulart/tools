def linha_grafico(marca, rotulo, larg_rotulo, bar, valor, meta=""):
    """Linha de gráfico: marcador, rótulo, barra, valor em destaque, meta apagada."""
    linha = (f"  {ui.ACC}{marca}{ui.RESET} {ui.FG70}{rotulo[:larg_rotulo]:<{larg_rotulo}}{ui.RESET} "
             f"{bar} {ui.ACC}{ui.BOLD}{valor:>6}{ui.RESET}")
    if meta:
        linha += f" {ui.FG40}{meta}{ui.RESET}"
    print(linha)


