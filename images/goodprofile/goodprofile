TAMANHO_RE = re.compile(r"([1-9]\d{0,4})x([1-9]\d{0,4})")

CORES = {
    "branco": (255, 255, 255, 255),
    "preto": (0, 0, 0, 255),
    "transparente": (0, 0, 0, 0),
}

# gravity name -> (horizontal, vertical) thirds: 0 = start, 1 = centre, 2 = end
GRAVIDADES = {
    "noroeste": (0, 0), "norte": (1, 0), "nordeste": (2, 0),
    "oeste": (0, 1), "centro": (1, 1), "leste": (2, 1),
    "sudoeste": (0, 2), "sul": (1, 2), "sudeste": (2, 2),
}

# sRGB <-> linear light lookup, so blending colours is physically correct
_S2L = [((c / 255) ** 2.2) for c in range(256)]


def _l2s(v: float) -> int:
    return min(255, max(0, round((v ** (1 / 2.2)) * 255)))


def parse_cor(s: str):
    """'RRGGBB', '#RGB', 'RRGGBBAA', branco/preto/transparente -> RGBA tuple."""
    txt = s.strip().lower().lstrip("#")
    if txt in CORES:
        return CORES[txt]
    if re.fullmatch(r"[0-9a-f]{3}", txt):
        txt = "".join(c * 2 for c in txt)
    if re.fullmatch(r"[0-9a-f]{6}", txt):
        txt += "ff"
    if re.fullmatch(r"[0-9a-f]{8}", txt):
        return tuple(int(txt[i:i + 2], 16) for i in (0, 2, 4, 6))
    raise ValueError(
        f"cor inválida: '{s}' (use RRGGBB, RRGGBBAA, branco, preto ou transparente)"
    )


# ------------------------------------------------------------- resize
def _resize_pillow(w, h, buf, nw, nh):
    try:
        from PIL import Image  # type: ignore
    except ImportError:
        return None
    im = Image.frombytes("RGBA", (w, h), bytes(buf))
    return bytearray(im.resize((nw, nh), Image.LANCZOS).tobytes())


def _box_down(w, h, buf, nw, nh):
    """Box-average in linear light, colours weighted by alpha (no dark halos)."""
    s2l = _S2L
    out = bytearray(nw * nh * 4)
    o = 0
    for gy in range(nh):
        y0 = gy * h // nh
        y1 = max(y0 + 1, (gy + 1) * h // nh)
        for gx in range(nw):
            x0 = gx * w // nw
            x1 = max(x0 + 1, (gx + 1) * w // nw)
            rl = gl = bl = 0.0
            al = 0
            cnt = 0
            for y in range(y0, y1):
                base = (y * w + x0) * 4
                for _ in range(x0, x1):
                    a = buf[base + 3]
                    if a:
                        peso = a / 255
                        rl += s2l[buf[base]] * peso
                        gl += s2l[buf[base + 1]] * peso
                        bl += s2l[buf[base + 2]] * peso
                        al += a
                    cnt += 1
                    base += 4
            if al:
                inv = 255 / al
                out[o] = _l2s(rl * inv)
                out[o + 1] = _l2s(gl * inv)
                out[o + 2] = _l2s(bl * inv)
            out[o + 3] = round(al / cnt)
            o += 4
    return out


def _bilinear(w, h, buf, nw, nh):
    out = bytearray(nw * nh * 4)
    xr = (w - 1) / (nw - 1) if nw > 1 else 0.0
    yr = (h - 1) / (nh - 1) if nh > 1 else 0.0
    o = 0
    for j in range(nh):
        sy = j * yr
        y0 = int(sy)
        y1 = min(y0 + 1, h - 1)
        fy = sy - y0
        for i in range(nw):
            sx = i * xr
            x0 = int(sx)
            x1 = min(x0 + 1, w - 1)
            fx = sx - x0
            p00 = (y0 * w + x0) * 4
            p01 = (y0 * w + x1) * 4
            p10 = (y1 * w + x0) * 4
            p11 = (y1 * w + x1) * 4
            for c in range(4):
                topo = buf[p00 + c] * (1 - fx) + buf[p01 + c] * fx
                base = buf[p10 + c] * (1 - fx) + buf[p11 + c] * fx
                out[o] = round(topo * (1 - fy) + base * fy)
                o += 1
    return out


def resize(w, h, buf, nw, nh):
    if (nw, nh) == (w, h):
        return bytearray(buf)
    res = _resize_pillow(w, h, buf, nw, nh)
    if res is not None:
        return res
    if nw <= w and nh <= h:
        return _box_down(w, h, buf, nw, nh)
    return _bilinear(w, h, buf, nw, nh)


# ------------------------------------------------------------- geometry
def crop(w, h, buf, x0, y0, cw, ch):
    out = bytearray(cw * ch * 4)
    for y in range(ch):
        src = ((y0 + y) * w + x0) * 4
        dst = y * cw * 4
        out[dst:dst + cw * 4] = buf[src:src + cw * 4]
    return out


def fit_cover(w, h, buf, tw, th, gravidade="centro", foco=None):
    """Scale to fill tw x th, then crop anchored by gravity or a focal point."""
    esc = max(tw / w, th / h)
    sw = max(tw, round(w * esc))
    sh = max(th, round(h * esc))
    buf = resize(w, h, buf, sw, sh)
    if foco is not None:
        x0 = round(foco[0] / 100 * sw - tw / 2)
        y0 = round(foco[1] / 100 * sh - th / 2)
        x0 = min(max(x0, 0), sw - tw)
        y0 = min(max(y0, 0), sh - th)
    else:
        gx, gy = GRAVIDADES[gravidade]
        x0 = (sw - tw) * gx // 2
        y0 = (sh - th) * gy // 2
    return crop(sw, sh, buf, x0, y0, tw, th)


def _compor(dw, dst, sw, sh, src, x0, y0):
    """Alpha-composite src over dst (both RGBA) at x0,y0."""
    for y in range(sh):
        d = ((y0 + y) * dw + x0) * 4
        s = y * sw * 4
        for _ in range(sw):
            a = src[s + 3]
            if a == 255:
                dst[d:d + 4] = src[s:s + 4]
            elif a:
                na = 255 - a
                dst[d] = (src[s] * a + dst[d] * na) // 255
                dst[d + 1] = (src[s + 1] * a + dst[d + 1] * na) // 255
                dst[d + 2] = (src[s + 2] * a + dst[d + 2] * na) // 255
                dst[d + 3] = a + dst[d + 3] * na // 255
            d += 4
            s += 4


def fit_contain(w, h, buf, tw, th, fundo=(0, 0, 0, 0), margem=0.0):
    """Scale to fit inside tw x th and centre over a solid background."""
    mx = round(tw * margem / 100)
    my = round(th * margem / 100)
    iw = max(1, tw - 2 * mx)
    ih = max(1, th - 2 * my)
    esc = min(iw / w, ih / h)
    sw = max(1, round(w * esc))
    sh = max(1, round(h * esc))
    conteudo = resize(w, h, buf, sw, sh)
    out = bytearray(bytes(fundo) * (tw * th))
    _compor(tw, out, sw, sh, conteudo, (tw - sw) // 2, (th - sh) // 2)
    return out


def _parecido(buf, i, cor, tol):
    """Pixel at byte offset i ~ border colour? transparent matches transparent."""
    if cor[3] <= tol and buf[i + 3] <= tol:
        return True
    return (
        abs(buf[i] - cor[0]) <= tol
        and abs(buf[i + 1] - cor[1]) <= tol
        and abs(buf[i + 2] - cor[2]) <= tol
        and abs(buf[i + 3] - cor[3]) <= tol
    )


def trim(w, h, buf, tol=12):
    """Crop away the uniform border (colour sampled from the corners)."""
    cantos = [0, (w - 1) * 4, (h - 1) * w * 4, ((h - 1) * w + w - 1) * 4]
    cores = [tuple(buf[i:i + 4]) for i in cantos]
    cor = max(cores, key=cores.count)

    def linha_uniforme(y):
        base = y * w * 4
        return all(_parecido(buf, base + x * 4, cor, tol) for x in range(w))

    topo = 0
    while topo < h - 1 and linha_uniforme(topo):
        topo += 1
    base = h
    while base > topo + 1 and linha_uniforme(base - 1):
        base -= 1

    def coluna_uniforme(x):
        return all(
            _parecido(buf, (y * w + x) * 4, cor, tol) for y in range(topo, base)
        )

    esq = 0
    while esq < w - 1 and coluna_uniforme(esq):
        esq += 1
    dire = w
    while dire > esq + 1 and coluna_uniforme(dire - 1):
        dire -= 1

    if (esq, topo, dire, base) == (0, 0, w, h):
        return w, h, bytearray(buf)
    return dire - esq, base - topo, crop(w, h, buf, esq, topo, dire - esq, base - topo)


# ------------------------------------------------------------- colour ops
def trocar_cor(buf, de, para, tol=10.0):
    """Replace colour ``de`` by ``para`` in place; tol 0-100 of the RGB diagonal.

    Pixels past the cutoff get a feathered blend so anti-aliased edges don't
    turn into a hard serrated fringe.
    """
    lim = tol / 100 * 441.673
    pena = max(1.0, lim * 0.5)
    lim2 = lim * lim
    fora2 = (lim + pena) ** 2
    for i in range(0, len(buf), 4):
        dr = buf[i] - de[0]
        dg = buf[i + 1] - de[1]
        db = buf[i + 2] - de[2]
        d2 = dr * dr + dg * dg + db * db
        if d2 > fora2:
            continue
        t = 1.0 if d2 <= lim2 else 1.0 - (math.sqrt(d2) - lim) / pena
        buf[i] = round(buf[i] + (para[0] - buf[i]) * t)
        buf[i + 1] = round(buf[i + 1] + (para[1] - buf[i + 1]) * t)
        buf[i + 2] = round(buf[i + 2] + (para[2] - buf[i + 2]) * t)
        buf[i + 3] = round(buf[i + 3] + (para[3] - buf[i + 3]) * t)


def _mix_linear(a, b, t):
    return tuple(_l2s(_S2L[a[c]] * (1 - t) + _S2L[b[c]] * t) for c in range(3))


def tingir(buf, cor):
    """Duotone recolour: black -> cor -> white mapped by luminance, keeps alpha."""
    rgb = cor[:3]
    lut = [
        _mix_linear((0, 0, 0), rgb, lum / 127) if lum < 128
        else _mix_linear(rgb, (255, 255, 255), (lum - 128) / 127)
        for lum in range(256)
    ]
    for i in range(0, len(buf), 4):
        lum = (buf[i] * 299 + buf[i + 1] * 587 + buf[i + 2] * 114) // 1000
        buf[i], buf[i + 1], buf[i + 2] = lut[lum]


def pb(buf):
    for i in range(0, len(buf), 4):
        lum = (buf[i] * 299 + buf[i + 1] * 587 + buf[i + 2] * 114) // 1000
        buf[i] = buf[i + 1] = buf[i + 2] = lum


# ------------------------------------------------------------- masks
def mascara_circulo(w, h, buf):
    """Multiply alpha by circle coverage (1px anti-aliased edge)."""
    r = min(w, h) / 2
    cx, cy = w / 2, h / 2
    for y in range(h):
        dy = y + 0.5 - cy
        base = y * w * 4
        for x in range(w):
            cob = r - math.hypot(x + 0.5 - cx, dy) + 0.5
            if cob >= 1:
                continue
            i = base + x * 4 + 3
            buf[i] = 0 if cob <= 0 else round(buf[i] * cob)


def mascara_cantos(w, h, buf, raio):
    """Rounded corners: multiply alpha by corner-circle coverage."""
    raio = min(raio, w // 2, h // 2)
    if raio <= 0:
        return
    centros = [
        (raio, raio, range(raio), range(raio)),
        (w - raio, raio, range(w - raio, w), range(raio)),
        (raio, h - raio, range(raio), range(h - raio, h)),
        (w - raio, h - raio, range(w - raio, w), range(h - raio, h)),
    ]
    for cx, cy, xs, ys in centros:
        for y in ys:
            dy = y + 0.5 - cy
            base = y * w * 4
            for x in xs:
                cob = raio - math.hypot(x + 0.5 - cx, dy) + 0.5
                if cob >= 1:
                    continue
                i = base + x * 4 + 3
                buf[i] = 0 if cob <= 0 else round(buf[i] * cob)


# ------------------------------------------------------------- output
def achatar(w, h, buf, fundo):
    """Composite over a solid colour (JPG has no alpha)."""
    out = bytearray(bytes((fundo[0], fundo[1], fundo[2], 255)) * (w * h))
    _compor(w, out, w, h, buf, 0, 0)
    return out


def salvar(dst: Path, w, h, buf, formato="png", qualidade=90, fundo=(255, 255, 255)):
    if formato == "png":
        imgcore.write_png(dst, w, h, buf, alpha=True)
        return
    if formato == "jpg":
        buf = achatar(w, h, buf, fundo)
    try:
        from PIL import Image  # type: ignore

        im = Image.frombytes("RGBA", (w, h), bytes(buf))
        if formato == "jpg":
            im.convert("RGB").save(dst, "JPEG", quality=qualidade)
        else:
            im.save(dst, "WEBP", quality=qualidade)
        return
    except ImportError:
        pass
    from shutil import which

    magick = which("magick") or which("convert")
    if not magick:
        raise RuntimeError("saída jpg/webp precisa de Pillow ou ImageMagick (use png).")
    fd, tmp = tempfile.mkstemp(suffix=".png")
    os.close(fd)
    tmp_path = Path(tmp)
    try:
        imgcore.write_png(tmp_path, w, h, buf, alpha=True)
        run = subprocess.run(
            [magick, str(tmp_path), "-quality", str(qualidade), str(dst)],
            capture_output=True,
        )
        if run.returncode != 0 or not dst.exists():
            raise RuntimeError(f"ImageMagick não conseguiu gravar {dst.name}")
    finally:
        if tmp_path.exists():
            tmp_path.unlink()


# ------------------------------------------------------------- targets
def resolver_alvos(nomes):
    """Preset/kit/'LxA' names -> list of (nome, w, h, nota, kit)."""
    alvos = []
    for nome in nomes:
        if nome in KITS:
            for p in KITS[nome]:
                _, w, h, nota = PRESETS[p]
                alvos.append((p, w, h, nota, nome))
        elif nome in PRESETS:
            _, w, h, nota = PRESETS[nome]
            alvos.append((nome, w, h, nota, None))
        else:
            m = TAMANHO_RE.fullmatch(nome)
            alvos.append((nome, int(m.group(1)), int(m.group(2)), "", None))
    return alvos


def destino(src: Path, nome, kit, args) -> Path:
    ext = args.formato
    if kit:
        pasta = Path(args.out) if args.out else src.with_name(f"{src.stem}-{kit}")
        pasta.mkdir(parents=True, exist_ok=True)
        return pasta / f"{nome}.{ext}"
    if args.out:
        return Path(args.out)
    return src.with_name(f"{src.stem}-{nome or 'edit'}.{ext}")


# ------------------------------------------------------------- one file
def processar(ui: Retro, src: Path, alvos, args, foco):
    if alvos:
        maxdim = max(1024, min(4096, 2 * max(max(a[1], a[2]) for a in alvos)))
    else:
        maxdim = 4096
    w, h, buf = imgcore.decode(src, maxdim, alpha=True)
    buf = bytearray(buf)

    ui.modulo("goodprofile", f"src: {src.name}")
    ui.kv("ENTRADA", f"{w}x{h}")

    if args.centralizar:
        w, h, buf = trim(w, h, buf)
        ui.kv("RECORTE", f"{w}x{h}")
    if args.cor_de:
        trocar_cor(buf, parse_cor(args.cor_de), parse_cor(args.cor_para),
                   args.tolerancia)
        ui.kv("COR", f"{args.cor_de.upper()} -> {args.cor_para.upper()}")
    if args.tint:
        tingir(buf, parse_cor(args.tint))
        ui.kv("TINT", args.tint.upper())
    if args.pb:
        pb(buf)
        ui.kv("COR", "PRETO E BRANCO")

    fundo = parse_cor(args.fundo) if args.fundo else (0, 0, 0, 0)
    fundo_jpg = fundo[:3] if args.fundo else (255, 255, 255)
    modo = args.modo or ("conter" if args.centralizar else "cobrir")
    margem = args.margem if args.margem is not None else (8.0 if args.centralizar else 0.0)
    if alvos:
        ui.kv("MODO", modo.upper())

    saidas = []
    notas = []
    ultimo = None
    for nome, tw, th, nota, kit in (alvos or [(None, w, h, "", None)]):
        if nome is None:
            res = bytearray(buf)
        elif modo == "conter":
            res = fit_contain(w, h, buf, tw, th, fundo, margem)
        elif modo == "esticar":
            res = resize(w, h, buf, tw, th)
        else:
            res = fit_cover(w, h, buf, tw, th, args.gravidade, foco)
        if args.circulo:
            mascara_circulo(tw, th, res)
        elif args.raio:
            mascara_cantos(tw, th, res, args.raio)
        dst = destino(src, nome, kit, args)
        salvar(dst, tw, th, res, args.formato, args.qualidade, fundo_jpg)
        peso = dst.stat().st_size / 1024
        rotulo = f"{dst.parent.name}/{dst.name}" if kit else dst.name
        ui.item("→", rotulo, f"{tw}x{th} · {peso:.1f} KB")
        if nota:
            notas.append((nome, nota))
        saidas.append(dst)
        ultimo = (tw, th, res)

    for nome, nota in notas:
        ui.aviso("nota", f"{nome}: {nota}")
    if not args.no_preview and ultimo:
        imgcore.preview(ui, ultimo[0], ultimo[1], ultimo[2], alpha=True)
    ui.ok(f"{len(saidas)} arquivo(s)")
    ui.proximo(str(saidas[0].parent if len(saidas) > 1 else saidas[0]), "abrir:")
    return saidas


# ------------------------------------------------------------- catalog
def catalogo(ui: Retro):
    ui.modulo("goodprofile", "catálogo de presets")
    atual = None
    for nome, (grupo, w, h, nota) in PRESETS.items():
        if grupo != atual:
            if atual is not None:
                print()
            ui.secao(grupo)
            atual = grupo
        valor = f"{w}x{h}"
        ui.kv(nome, valor)
        if nota:
            print(f"      {ui.FG40}{nota}{ui.RESET}")
    print()
    ui.secao("kits (vários tamanhos de uma vez)")
    for kit, lista in KITS.items():
        ui.kv(kit, f"{len(lista)} TAMANHOS")
        print(f"      {ui.FG40}{' · '.join(lista)}{ui.RESET}")
    print()
    ui.secao("custom")
    ui.kv("LARGURAxALTURA", "EX: 800x600")
    print()


# ------------------------------------------------------------- cli
def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="goodprofile",
        description="encaixa imagens nos tamanhos prontos de perfil/rede social.",
        add_help=False,
    )
    p.add_argument("files", nargs="*", metavar="IMAGEM|PRESET")
    p.add_argument("--modo", choices=["cobrir", "conter", "esticar"], default=None,
                   help="cobrir corta, conter põe padding, esticar deforma")
    p.add_argument("--gravidade", choices=sorted(GRAVIDADES), default="centro",
                   help="âncora do corte no modo cobrir")
    p.add_argument("--foco", metavar="X,Y",
                   help="ponto focal em %% que deve sobreviver ao corte")
    p.add_argument("--fundo", metavar="COR",
                   help="cor do padding/fundo (RRGGBB, branco, transparente)")
    p.add_argument("--centralizar", action="store_true",
                   help="apara a borda uniforme e centra o conteúdo")
    p.add_argument("--margem", type=float, default=None, metavar="N",
                   help="respiro do conteúdo em %% (padrão 8 com --centralizar)")
    p.add_argument("--cor-de", dest="cor_de", metavar="COR",
                   help="cor a substituir")
    p.add_argument("--cor-para", dest="cor_para", metavar="COR",
                   help="cor substituta (aceita 'transparente')")
    p.add_argument("--tolerancia", type=float, default=10, metavar="N",
                   help="tolerância da troca de cor, 0-100 (padrão 10)")
    p.add_argument("--tint", metavar="COR",
                   help="recolore a imagem toda pelo tom (duotone)")
    p.add_argument("--pb", action="store_true", help="preto e branco")
    p.add_argument("--circulo", action="store_true",
                   help="máscara circular (avatar redondo)")
    p.add_argument("--raio", type=int, default=0, metavar="N",
                   help="cantos arredondados em px")
    p.add_argument("-o", "--out", metavar="ARQUIVO",
                   help="arquivo de saída (pasta, no caso de kits)")
    p.add_argument("--formato", choices=["png", "jpg", "webp"], default="png")
    p.add_argument("--qualidade", type=int, default=90, metavar="N",
                   help="qualidade jpg/webp (padrão 90)")
    p.add_argument("--no-preview", action="store_true")
    p.add_argument("--temas", action="store_true", help="lista os temas e sai")
    p.add_argument("-h", "--help", action="store_true")
    return p


HELP = """
{titulo}

  {u}goodprofile{r} [imagens...] [preset|kit|LxA] [opções]

  {a}presets{r}          catálogo completo: {u}goodprofile presets{r}
                   avatar/capa por rede (ig-avatar, yt-banner, x-header, …),
                   kits (kit-perfil, kit-favicon, kit-ig, kit-canal)
                   ou tamanho custom tipo 800x600

  {d}encaixe{r}
  {a}    --modo M{r}         cobrir corta · conter padding   {d}(padrão cobrir){r}
  {a}    --gravidade G{r}    âncora do corte                 {d}(centro, norte, …){r}
  {a}    --foco X,Y{r}       ponto que sobrevive ao corte, em %
  {a}    --fundo COR{r}      cor do padding                  {d}(RRGGBB/transparente){r}
  {a}    --centralizar{r}    apara borda uniforme e centra (logos)
  {a}    --margem N{r}       respiro em %                    {d}(8 com centralizar){r}

  {d}cor{r}
  {a}    --cor-de C --cor-para C{r}   troca uma cor          {d}(--tolerancia 0-100){r}
  {a}    --tint COR{r}       recolore pelo tom (duotone)
  {a}    --pb{r}             preto e branco

  {d}forma e saída{r}
  {a}    --circulo{r}        máscara redonda (avatar)
  {a}    --raio N{r}         cantos arredondados em px
  {a}-o, --out ARQ{r}        arquivo de saída (pasta, pra kits)
  {a}    --formato F{r}      png · jpg · webp                {d}(padrão png){r}
  {a}    --qualidade N{r}    qualidade jpg/webp              {d}(padrão 90){r}
  {a}    --temas{r}          catálogo de temas retrô

  {d}decoder: Pillow se houver, senão ImageMagick (svg/pdf via magick){r}

  {d}exemplos{r}
    goodprofile foto.jpg ig-avatar --circulo
    goodprofile logo.png kit-perfil --centralizar --fundo 111111
    goodprofile arte.png x-header --foco 30,40
    goodprofile print.png --cor-de ffffff --cor-para transparente
"""


def main() -> int:
    args = build_parser().parse_args()
    ui = Retro(env_prefix="GOODPROFILE")

    if args.temas:
        ui.catalogo_temas()
        return 0

    arquivos: list[str] = []
    alvos_nomes: list[str] = []
    mostrar_presets = False
    for f in args.files:
        if os.path.isfile(f):
            arquivos.append(f)
            continue
        nome = f.lower()
        if nome == "help":
            args.help = True
        elif nome == "presets":
            mostrar_presets = True
        elif nome in PRESETS or nome in KITS or TAMANHO_RE.fullmatch(nome):
            alvos_nomes.append(nome)
        else:
            ui.erro(f"não sei o que é '{f}' — nem arquivo, nem preset.")
            ui.proximo("goodprofile presets", "catálogo:")
            return 2

    if args.help:
        print(HELP.format(
            titulo=ui.forte("[ MODULE: GOODPROFILE ]"),
            u=ui.ACC + ui.BOLD, a=ui.ACC, d=ui.FG40, r=ui.RESET,
        ))
        return 0
    if mostrar_presets:
        catalogo(ui)
        return 0
    if not arquivos:
        print(HELP.format(
            titulo=ui.forte("[ MODULE: GOODPROFILE ]"),
            u=ui.ACC + ui.BOLD, a=ui.ACC, d=ui.FG40, r=ui.RESET,
        ))
        return 1

    if bool(args.cor_de) != bool(args.cor_para):
        ui.erro("--cor-de e --cor-para andam juntos.")
        return 2
    foco = None
    if args.foco:
        m = re.fullmatch(r"(\d+(?:\.\d+)?),(\d+(?:\.\d+)?)", args.foco)
        if not m or not (0 <= float(m.group(1)) <= 100 and 0 <= float(m.group(2)) <= 100):
            ui.erro("--foco espera X,Y em porcentagem (ex: 30,40).")
            return 2
        foco = (float(m.group(1)), float(m.group(2)))
    for flag in ("cor_de", "cor_para", "tint", "fundo"):
        valor = getattr(args, flag)
        if valor:
            try:
                parse_cor(valor)
            except ValueError as e:
                ui.erro(str(e))
                return 2

    alvos = resolver_alvos(alvos_nomes)
    tem_edicao = (args.centralizar or args.cor_de or args.tint or args.pb
                  or args.circulo or args.raio)
    if not alvos and not tem_edicao:
        ui.erro("nada pra fazer: dê um preset/kit/tamanho ou uma opção de edição.")
        ui.proximo("goodprofile presets", "catálogo:")
        return 2

    tem_kit = any(a[4] for a in alvos)
    if args.out and len(arquivos) > 1:
        ui.erro("-o/--out só funciona com uma imagem por vez.")
        return 1
    if args.out and not tem_kit and len(alvos) > 1:
        ui.erro("-o/--out com vários presets só faz sentido em kits (vira pasta).")
        return 1

    rc = 0
    for f in arquivos:
        src = Path(f)
        try:
            processar(ui, src, alvos, args, foco)
        except KeyboardInterrupt:
            print()
            ui.aviso("abortado")
            return 130
        except Exception as e:  # noqa: BLE001
            ui.erro(f"{src.name}: {e}")
            rc = 1
    return rc


if __name__ == "__main__":
    sys.exit(main())
