#!/usr/bin/env python3
"""goodprofile — fit any image into ready-made profile/social-media sizes.

Decodes via the shared imgcore backend (Pillow first, then the ImageMagick
CLI), then does every edit in pure python on the raw RGBA buffer, so the
result is identical no matter which backend decoded the file:

    decode -> optional trim + centre (logos) -> optional recolor
    (replace / tint / grayscale) -> fit to preset (cover crop, contain pad
    or stretch) -> optional circle / rounded-corner mask -> PNG (pure
    python), or JPG/WebP when Pillow or magick can encode it.

    goodprofile foto.jpg ig-avatar --circulo
    goodprofile logo.png kit-perfil --centralizar --fundo 111111
    goodprofile arte.png x-header --foco 30,40
    goodprofile print.png --cor-de ffffff --cor-para transparente
    goodprofile presets
"""

