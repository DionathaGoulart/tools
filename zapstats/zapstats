DIAS_SEMANA = ["segunda", "terça", "quarta", "quinta", "sexta", "sábado", "domingo"]

# frases de sistema / mídia que não contam como texto
MARCADORES_MIDIA = (
    "<mídia oculta>", "<media omitted>", "imagem ocultada", "image omitted",
    "vídeo omitido", "video omitted", "áudio ocultado", "audio omitted",
    "figurinha omitida", "sticker omitted", "gif omitido", "documento omitido",
    "document omitted", "contato omitido", "‎", "arquivo de mídia oculto",
)
LINHAS_SISTEMA = (
    "as mensagens e as ligações são protegidas", "messages and calls are end-to-end",
    "você criou o grupo", "criou o grupo", "created group", "adicionou você",
    "mudou o assunto", "mudou a descrição", "changed the subject",
    "código de segurança", "security code", "esta mensagem foi apagada",
    "this message was deleted", "você apagou esta mensagem",
)

STOPWORDS = set("""a o e é de da do das dos que não nao pra para com uma um umas uns
no na nos nas em por se te me eu voce você vc tu ele ela nós nos eles elas isso
isto aqui ali mas ou como quando onde qual quais quem já ja tá ta to tô então
entao só so bem tem ter foi ser sou está esta estou muito mais menos ao aos à às as os
lá la cá ca coisa gente vai vou pode ser sim tao tão vc's the to of and you i is it
in that this for on my me we he she they não sei tudo todo toda meu minha seu sua""".split())

EMOJI_RE = re.compile(
    "["
    "\U0001F300-\U0001FAFF"  # símbolos & pictogramas, emoji suplementares
    "\U00002600-\U000027BF"  # misc símbolos & dingbats
    "\U0001F000-\U0001F0FF"
    "\U00002190-\U000021FF"  # setas
    "\U00002B00-\U00002BFF"
    "\U0000FE00-\U0000FE0F"  # seletores de variação
    "\U0001F1E6-\U0001F1FF"  # bandeiras
    "]+",
    flags=re.UNICODE,
)

# Prefixo de data/hora. Cobre iOS ( [16/07/26, 21:34:12] ) e Android ( 16/07/2026 21:34 - ).
LINHA_RE = re.compile(
    r"^\[?"
    r"(\d{1,2})[/.](\d{1,2})[/.](\d{2,4})"          # data
    r"[,]?\s+"
    r"(\d{1,2}):(\d{2})(?::(\d{2}))?"               # hora
    r"\s*([AaPp][Mm])?"                             # am/pm opcional
    r"\]?"
    r"(?:\s+-\s+|\s+)"                              # separador android " - " ou espaço (iOS)
    r"(.*)$"
)


# ---------------------------------------------------------------- parsing

def parse_arquivo(caminho):
    try:
        texto = open(caminho, encoding="utf-8-sig").read()
    except OSError as e:
        die(f"não consegui ler {caminho}: {e}")
    msgs = []            # (datetime, autor, texto)
    atual = None
    for linha in texto.splitlines():
        m = LINHA_RE.match(linha)
        if m:
            dt = montar_data(m)
            resto = m.group(8)
            corpo = re.match(r"([^:]{1,60}?):\s(.*)$", resto, re.DOTALL)
            if not corpo or dt is None:
                atual = None            # linha de sistema (sem "Nome:") — ignora
                continue
            autor = corpo.group(1).strip()
            conteudo = corpo.group(2)
            if any(s in conteudo.lower() for s in LINHAS_SISTEMA):
                atual = None
                continue
            atual = [dt, autor, conteudo]
            msgs.append(atual)
        elif atual is not None:
            atual[2] += "\n" + linha     # continuação de mensagem multi-linha
    return [(dt, a, t) for dt, a, t in msgs]


def montar_data(m):
    d, mth, y, hh, mm, ss, ap = (m.group(i) for i in range(1, 8))
    d, mth, y, hh, mm = int(d), int(mth), int(y), int(hh), int(mm)
    ss = int(ss) if ss else 0
    if y < 100:
        y += 2000
    if ap:
        ap = ap.lower()
        if ap == "pm" and hh != 12:
            hh += 12
        elif ap == "am" and hh == 12:
            hh = 0
    # tenta dd/mm; se dia inválido, tenta mm/dd (export en-US)
    for dia, mes in ((d, mth), (mth, d)):
        try:
            return datetime(y, mes, dia, hh, mm, ss)
        except ValueError:
            continue
    return None


def eh_midia(txt):
    t = txt.strip().lower()
    return any(mark in t for mark in MARCADORES_MIDIA) or t == ""


# ---------------------------------------------------------------- estatísticas

def calcular(msgs):
    autores = [a for _, a, _ in msgs]
    pessoas = list(dict.fromkeys(autores))   # ordem de aparição, sem repetir
    st = {
        "pessoas": pessoas,
        "total": len(msgs),
        "inicio": msgs[0][0],
        "fim": msgs[-1][0],
        "por_pessoa": {p: Counter() for p in pessoas},
        "hora": Counter(),
        "dia_semana": Counter(),
        "mes": Counter(),
        "emojis": Counter(),
        "emojis_por_pessoa": {p: Counter() for p in pessoas},
        "palavras": Counter(),
        "iniciou": Counter(),
        "resp_tempos": defaultdict(list),
        "risadas": Counter(),
        "perguntas": Counter(),
        "madrugada": Counter(),
        "dias_ativos": set(),
    }
    GAP_INICIO = timedelta(hours=6)
    anterior = None
    for dt, autor, txt in msgs:
        pp = st["por_pessoa"][autor]
        pp["msgs"] += 1
        st["hora"][dt.hour] += 1
        st["dia_semana"][dt.weekday()] += 1
        st["mes"][f"{dt:%Y-%m}"] += 1
        st["dias_ativos"].add(dt.date())
        if dt.hour < 6:
            st["madrugada"][autor] += 1

        if eh_midia(txt):
            pp["midia"] += 1
        else:
            palavras = re.findall(r"\w+", txt.lower(), re.UNICODE)
            pp["palavras"] += len(palavras)
            pp["chars"] += len(txt)
            for w in palavras:
                if len(w) >= 3 and w not in STOPWORDS and not w.isdigit():
                    st["palavras"][w] += 1
            if re.search(r"(k{3,}|(ha){2,}|(he){2,}|rs{2,}|kkk|😂|🤣)", txt.lower()):
                st["risadas"][autor] += 1
            if txt.rstrip().endswith("?"):
                st["perguntas"][autor] += 1
            for e in EMOJI_RE.findall(txt):
                for ch in e:
                    if ch != "️":
                        st["emojis"][ch] += 1
                        st["emojis_por_pessoa"][autor][ch] += 1

        if anterior is not None:
            pdt, pautor = anterior
            gap = dt - pdt
            if gap >= GAP_INICIO:
                st["iniciou"][autor] += 1
            elif pautor != autor and gap.total_seconds() > 0:
                st["resp_tempos"][autor].append(gap.total_seconds())
        else:
            st["iniciou"][autor] += 1
        anterior = (dt, autor)

    st["vacuo"] = maior_vacuo(msgs)
    st["streak"] = maior_sequencia(st["dias_ativos"])
    return st


def maior_vacuo(msgs):
    maior = timedelta(0)
    quando = None
    for (d1, _, _), (d2, _, _) in zip(msgs, msgs[1:]):
        if d2 - d1 > maior:
            maior, quando = d2 - d1, (d1, d2)
    return maior, quando


def maior_sequencia(dias):
    if not dias:
        return 0, None
    ds = sorted(dias)
    melhor = atual = 1
    ini = fim = ds[0]
    a_ini = ds[0]
    for i in range(1, len(ds)):
        if ds[i] - ds[i - 1] == timedelta(days=1):
            atual += 1
            if atual > melhor:
                melhor, ini, fim = atual, a_ini, ds[i]
        else:
            atual = 1
            a_ini = ds[i]
    return melhor, (ini, fim)


def fmt_dur(td):
    s = int(td.total_seconds())
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    mi = s // 60
    partes = []
    if d:
        partes.append(f"{d}d")
    if h:
        partes.append(f"{h}h")
    if mi and not d:
        partes.append(f"{mi}min")
    return " ".join(partes) or "menos de 1min"


def barra(valor, maximo, largura=24):
    n = round(largura * valor / maximo) if maximo else 0
    return "█" * n + "·" * (largura - n)


# ---------------------------------------------------------------- relatório terminal

def relatorio(st):
    L = []
    add = L.append
    span = (st["fim"] - st["inicio"]).days + 1
    add("\n\033[1;32m📊 zapstats\033[0m")
    add(f"período: {st['inicio']:%d/%m/%Y} → {st['fim']:%d/%m/%Y}  ({span} dias)")
    add(f"total: {st['total']} mensagens · {len(st['pessoas'])} pessoas\n")

    add("\033[1mquem mais fala\033[0m")
    maxm = max(st["por_pessoa"][p]["msgs"] for p in st["pessoas"])
    for p in sorted(st["pessoas"], key=lambda x: -st["por_pessoa"][x]["msgs"]):
        c = st["por_pessoa"][p]
        pct = 100 * c["msgs"] / st["total"]
        add(f"  {p[:16]:<16} {barra(c['msgs'], maxm)} {c['msgs']:>5} ({pct:.0f}%)")
    add("")

    add("\033[1mhorário (quando vocês falam)\033[0m")
    maxh = max(st["hora"].values())
    for h in range(0, 24, 2):
        v = st["hora"][h] + st["hora"][h + 1]
        add(f"  {h:02d}h {barra(v, maxh * 2, 30)} {v}")
    add("")

    add("\033[1mdia da semana\033[0m")
    maxd = max(st["dia_semana"].values())
    for i, nome in enumerate(DIAS_SEMANA):
        v = st["dia_semana"][i]
        add(f"  {nome:<8} {barra(v, maxd)} {v}")
    add("")

    if st["emojis"]:
        top = " ".join(f"{e} {n}" for e, n in st["emojis"].most_common(8))
        add(f"\033[1memojis\033[0m\n  {top}\n")

    if st["palavras"]:
        top = ", ".join(f"{w} ({n})" for w, n in st["palavras"].most_common(12))
        add(f"\033[1mpalavras mais usadas\033[0m\n  {top}\n")

    add("\033[1mtempo médio de resposta\033[0m")
    for p in st["pessoas"]:
        tempos = st["resp_tempos"][p]
        if tempos:
            med = sorted(tempos)[len(tempos) // 2]
            add(f"  {p[:16]:<16} {fmt_dur(timedelta(seconds=med))}  (mediana de {len(tempos)} respostas)")
    add("")

    add("\033[1mquem puxa assunto\033[0m")
    tot_ini = sum(st["iniciou"].values()) or 1
    for p, n in st["iniciou"].most_common():
        add(f"  {p[:16]:<16} {n} vezes ({100*n/tot_ini:.0f}%)")
    add("")

    dur, quando = st["vacuo"]
    if quando:
        add(f"\033[1mmaior vácuo\033[0m\n  {fmt_dur(dur)} — de {quando[0]:%d/%m/%y %Hh} a {quando[1]:%d/%m/%y %Hh}\n")
    seq, per = st["streak"]
    if per:
        add(f"\033[1mmaior sequência sem falhar\033[0m\n  {seq} dias seguidos ({per[0]:%d/%m/%y} → {per[1]:%d/%m/%y})\n")

    if sum(st["madrugada"].values()):
        mad = ", ".join(f"{p}: {n}" for p, n in st["madrugada"].most_common() if n)
        add(f"\033[1mmensagens de madrugada (0-6h)\033[0m\n  {mad}\n")

    curiosidades = []
    for p in st["pessoas"]:
        if st["risadas"][p]:
            curiosidades.append(f"{p} riu (kkk/haha) {st['risadas'][p]}x")
        if st["perguntas"][p]:
            curiosidades.append(f"{p} fez {st['perguntas'][p]} perguntas")
    if curiosidades:
        add("\033[1mcuriosidades\033[0m")
        for c in curiosidades:
            add(f"  · {c}")
        add("")
    return "\n".join(L)


# ---------------------------------------------------------------- camada LLM

def anonimizar(st, msgs, usar_reais):
    """Retorna (mapa placeholder->real, lista_amostra_anonimizada)."""
    if usar_reais:
        mapa = {p: p for p in st["pessoas"]}
    else:
        mapa = {p: f"Pessoa {chr(65+i)}" for i, p in enumerate(st["pessoas"])}
    # amostra: mensagens de texto mais longas + espalhadas no tempo
    textos = [(dt, a, t) for dt, a, t in msgs if not eh_midia(t) and len(t) > 15]
    textos.sort(key=lambda x: -len(x[2]))
    amostra = textos[:120]
    amostra.sort(key=lambda x: x[0])
    linhas = [f"{mapa[a]}: {t.strip()[:200]}" for _, a, t in amostra]
    return mapa, linhas


def resumo_stats_texto(st, mapa):
    partes = [f"Período: {st['inicio']:%d/%m/%Y} a {st['fim']:%d/%m/%Y}, {st['total']} mensagens."]
    for p in st["pessoas"]:
        c = st["por_pessoa"][p]
        partes.append(f"{mapa[p]}: {c['msgs']} msgs, {c['palavras']} palavras, "
                      f"{st['risadas'][p]} risadas, puxou assunto {st['iniciou'][p]}x.")
    if st["emojis"]:
        partes.append("Top emojis: " + " ".join(e for e, _ in st["emojis"].most_common(6)))
    if st["palavras"]:
        partes.append("Palavras comuns: " + ", ".join(w for w, _ in st["palavras"].most_common(10)))
    return "\n".join(partes)


def camada_llm(st, msgs, usar_reais):
    mapa, amostra = anonimizar(st, msgs, usar_reais)
    system = (
        "Você recebe estatísticas e uma amostra de mensagens de uma conversa de WhatsApp "
        "entre amigos. Escreva em português do Brasil, em tom leve e divertido, uma "
        "retrospectiva com estas seções, usando exatamente estes títulos em maiúsculas:\n"
        "RESUMO: um parágrafo caracterizando a dinâmica da conversa.\n"
        "FRASES ICÔNICAS: 3 a 5 frases reais marcantes da amostra, entre aspas, com quem disse.\n"
        "APELIDOS: apelidos ou formas de tratamento que aparecem (se houver).\n"
        "ROAST: um roast bem-humorado e afiado de cada pessoa, baseado nos dados (sem ofensa pesada).\n"
        "Use os nomes exatamente como aparecem nos dados."
    )
    user = "ESTATÍSTICAS:\n" + resumo_stats_texto(st, mapa) + "\n\nAMOSTRA DE MENSAGENS:\n" + "\n".join(amostra)
    texto, model = chamar_llm(
        [{"role": "system", "content": system}, {"role": "user", "content": user}],
        max_tokens=1600, temperature=0.85,
    )
    # recoloca nomes reais se anonimizou
    if not usar_reais:
        for real, ph in mapa.items():
            texto = texto.replace(ph, real)
    return texto, model


