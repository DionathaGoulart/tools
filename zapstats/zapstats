# ---------------------------------------------------------------- openrouter

def modelos_configurados():
    env = os.environ.get("OPENROUTER_MODEL", "").strip()
    return [m.strip() for m in env.split(",") if m.strip()] if env else DEFAULT_MODELS


def chamar_llm(messages, max_tokens=1600, temperature=0.85):
    key = os.environ.get("OPENROUTER_API_KEY", "").strip()
    if not key:
        die("OPENROUTER_API_KEY não definida — necessária só pra --roast.\n"
            "  Crie grátis em https://openrouter.ai/keys e:  export OPENROUTER_API_KEY=\"sk-or-...\"\n"
            "  (sem --roast o zapstats roda 100% offline.)")
    erros = []
    for model in modelos_configurados():
        payload = json.dumps({"model": model, "messages": messages,
                              "max_tokens": max_tokens, "temperature": temperature}).encode()
        req = urllib.request.Request(API_URL, data=payload, headers={
            "Authorization": f"Bearer {key}", "Content-Type": "application/json",
            "HTTP-Referer": "https://github.com/DionathaGoulart/tools", "X-Title": "zapstats"})
        try:
            with urllib.request.urlopen(req, timeout=180) as resp:
                data = json.loads(resp.read().decode())
            content = (data["choices"][0]["message"].get("content") or "").strip()
            if content:
                return content, model
            erros.append(f"{model}: vazio")
        except urllib.error.HTTPError as e:
            if e.code == 401:
                die("OPENROUTER_API_KEY inválida (HTTP 401).")
            erros.append(f"{model}: HTTP {e.code}")
        except Exception as e:
            erros.append(f"{model}: {type(e).__name__}")
    die("todos os modelos falharam:\n  " + "\n  ".join(erros) + "\n  (`zapstats -m` lista os no ar)")


def listar_modelos_free():
    try:
        with urllib.request.urlopen(MODELS_URL, timeout=30) as resp:
            data = json.loads(resp.read().decode())
    except Exception as e:
        die(f"não consegui consultar {MODELS_URL}: {e}")
    livres = sorted(m["id"] for m in data.get("data", []) if m["id"].endswith(":free"))
    print(f"{len(livres)} modelos :free agora:\n")
    for m in livres:
        print(f"  {m}")


# ---------------------------------------------------------------- util / main

def die(msg):
    print(f"zapstats: {msg}", file=sys.stderr)
    sys.exit(1)


def main():
    ap = argparse.ArgumentParser(
        prog="zapstats",
        description="Retrospectiva de uma conversa exportada do WhatsApp (.txt).",
        epilog="exemplo:  zapstats conversa.txt --roast --html retro.html",
    )
    ap.add_argument("arquivo", nargs="?", help="o .txt exportado do WhatsApp")
    ap.add_argument("--roast", action="store_true",
                    help="camada com LLM: resumo, frases icônicas, apelidos e roast")
    ap.add_argument("--reais", action="store_true",
                    help="com --roast, envia nomes reais em vez de anonimizar (menos privado)")
    ap.add_argument("--html", metavar="ARQ", help="também salva um retrô visual em HTML")
    ap.add_argument("-m", "--modelos", action="store_true", help="lista modelos :free disponíveis")
    args = ap.parse_args()

    if args.modelos:
        listar_modelos_free()
        return
    if not args.arquivo:
        ap.print_help()
        return
    if not os.path.isfile(args.arquivo):
        die(f"arquivo não encontrado: {args.arquivo}")

    msgs = parse_arquivo(args.arquivo)
    if len(msgs) < 2:
        die("não achei mensagens reconhecíveis. Exporte pelo WhatsApp em "
            "\"Exportar conversa\" (sem mídia) e passe o .txt.")
    st = calcular(msgs)
    print(relatorio(st))

    texto_llm = None
    if args.roast:
        if not args.reais:
            print("🔒 anonimizando nomes antes de enviar ao modelo (use --reais pra desligar).")
        print("⏳ gerando resumo e roast…\n")
        texto_llm, model = camada_llm(st, msgs, args.reais)
        print("\033[1;35m🔥 retrô\033[0m")
        print(texto_llm)
        print(f"\n\033[2m(modelo: {model})\033[0m")

    if args.html:
        gerar_html(st, texto_llm, args.html)
        print(f"\n💾 HTML salvo em {args.html}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\ninterrompido.")
        sys.exit(130)
