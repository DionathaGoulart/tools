#!/usr/bin/env bash
# pomo — pomodoro no terminal, com notificação nativa (macOS / Linux)
#
# usage: pomo [minutos] [rótulo…]   inicia um foco (padrão 25 min)
#        pomo pausa [minutos]       pausa (padrão 5 min; a cada 4 focos, 15)
#        pomo -l | --log            estatísticas (hoje + últimos 14 dias)
#        pomo -h | --help
#
# durante a contagem:  [p] pausa/retoma   [q] aborta

set -u

POMO_DIR="${POMO_DIR:-$HOME/.pomo}"
LOG_FILE="$POMO_DIR/log.csv"

FOCO_PADRAO="${POMO_FOCO:-25}"
PAUSA_PADRAO="${POMO_PAUSA:-5}"
PAUSA_LONGA="${POMO_PAUSA_LONGA:-15}"

# ---------- cores ----------
USE_COLOR=1
[ -n "${NO_COLOR:-}" ] && USE_COLOR=0
[ -t 1 ] || USE_COLOR=0

RESET="" BOLD="" DIM="" VERMELHO="" VERDE=""
if [ "$USE_COLOR" -eq 1 ]; then
  RESET=$'\033[0m'
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  VERMELHO=$'\033[1;31m'
  VERDE=$'\033[1;32m'
fi

DESENHA=0
[ -t 1 ] && DESENHA=1

# ---------- helpers ----------
uso() {
  echo "usage: pomo [minutos] [rótulo…]   foco (padrão $FOCO_PADRAO min)"
  echo "       pomo pausa [minutos]       pausa (padrão $PAUSA_PADRAO min; longa: $PAUSA_LONGA)"
  echo "       pomo -l                    estatísticas"
  echo
  echo "durante a contagem:  [p] pausa/retoma · [q] aborta"
  echo "config (env): POMO_FOCO, POMO_PAUSA, POMO_PAUSA_LONGA, POMO_DIR"
}

die() { echo "pomo: $*" >&2; exit 2; }

eh_numero() { case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }

notificar() { # $1 = título, $2 = corpo
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"${2//\"/}\" with title \"${1//\"/}\"" >/dev/null 2>&1
    if [ -f /System/Library/Sounds/Glass.aiff ] && command -v afplay >/dev/null 2>&1; then
      afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &
    fi
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send "$1" "$2" >/dev/null 2>&1
  fi
  printf '\a'
}

registrar() { # $1 tipo  $2 minutos  $3 status  $4 rótulo
  mkdir -p "$POMO_DIR"
  [ -f "$LOG_FILE" ] || echo "data,hora,tipo,minutos,status,rotulo" > "$LOG_FILE"
  printf '%s,%s,%s,%s,%s,%s\n' \
    "$(date +%Y-%m-%d)" "$(date +%H:%M)" "$1" "$2" "$3" "${4//,/;}" >> "$LOG_FILE"
}

focos_hoje() {
  [ -f "$LOG_FILE" ] || { echo 0; return; }
  awk -F, -v d="$(date +%Y-%m-%d)" '$1==d && $3=="foco" && $5=="ok"' "$LOG_FILE" | wc -l | tr -d ' '
}

# sessão atual (pro trap de Ctrl-C conseguir registrar o aborto)
TIPO="" MIN=0 ROTULO=""

limpar() { [ "$DESENHA" -eq 1 ] && printf '\033[?25h'; }

ao_interromper() {
  limpar
  [ -n "$TIPO" ] && registrar "$TIPO" "$MIN" abortado "$ROTULO"
  printf '\n\n  interrompido.\n'
  exit 130
}
trap ao_interromper INT

# ---------- contagem ----------
desenhar() { # $1 restante  $2 total  $3 cor  $4 título  $5 sufixo
  [ "$DESENHA" -eq 1 ] || return 0
  local rest=$1 total=$2 cor=$3 titulo=$4 sufixo=$5
  local largura=25 feito barra="" i
  feito=$(( (total - rest) * largura / total ))
  i=0
  while [ "$i" -lt "$largura" ]; do
    if [ "$i" -lt "$feito" ]; then barra="${barra}█"; else barra="${barra}░"; fi
    i=$((i + 1))
  done
  printf '\r  %s%s%s  %s%02d:%02d%s  %s%s%s  %s   ' \
    "$cor" "$titulo" "$RESET" "$BOLD" $((rest / 60)) $((rest % 60)) "$RESET" \
    "$cor" "$barra" "$RESET" "$sufixo"
}

contagem() { # $1 = segundos, $2 = cor, $3 = título; retorna 0 completo / 1 abortado
  local total=$1 cor=$2 titulo=$3
  local inicio=$SECONDS rest key pstart
  local dica="${DIM}[p] pausar · [q] sair${RESET}"
  [ "$DESENHA" -eq 1 ] && printf '\033[?25l'
  while :; do
    rest=$((total - (SECONDS - inicio)))
    [ "$rest" -le 0 ] && break
    desenhar "$rest" "$total" "$cor" "$titulo" "$dica"
    if [ -t 0 ]; then
      key=""
      read -rs -t 1 -n 1 key 2>/dev/null || true
      case "$key" in
        p|P)
          pstart=$SECONDS
          desenhar "$rest" "$total" "$cor" "$titulo" "${DIM}⏸ pausado · [p] retoma · [q] sai${RESET}"
          while read -rs -n 1 key 2>/dev/null; do
            case "$key" in
              p|P) inicio=$((inicio + SECONDS - pstart)); break ;;
              q|Q) limpar; return 1 ;;
            esac
          done
          ;;
        q|Q) limpar; return 1 ;;
      esac
    else
      sleep 1
    fi
  done
  desenhar 0 "$total" "$cor" "$titulo" " "
  limpar
  return 0
}

# ---------- comandos ----------
cmd_foco() { # $1 = minutos, resto = rótulo
  local min=$1; shift
  local rotulo="${*:-}"
  TIPO=foco MIN=$min ROTULO=$rotulo
  echo
  printf '  🍅 %sfoco%s: %d min%s\n\n' "$VERMELHO" "$RESET" "$min" "${rotulo:+ — $rotulo}"
  if contagem $((min * 60)) "$VERMELHO" "🍅 foco"; then
    registrar foco "$min" ok "$rotulo"
    TIPO=""
    local n; n=$(focos_hoje)
    printf '\n\n  %s✔ foco concluído!%s  %s pomodoro(s) hoje.\n' "$VERDE" "$RESET" "$n"
    if [ $((n % 4)) -eq 0 ]; then
      notificar "pomo" "Foco concluído! 4º seguido — pausa longa de $PAUSA_LONGA min."
      printf '  4º pomodoro — pausa longa:  %spomo pausa %s%s\n\n' "$BOLD" "$PAUSA_LONGA" "$RESET"
    else
      notificar "pomo" "Foco concluído! Hora da pausa ($PAUSA_PADRAO min)."
      printf '  agora a pausa:  %spomo pausa%s\n\n' "$BOLD" "$RESET"
    fi
  else
    registrar foco "$min" abortado "$rotulo"
    TIPO=""
    printf '\n\n  ✖ foco abortado (não conta na estatística).\n\n'
  fi
}

cmd_pausa() { # $1 = minutos
  local min=$1
  TIPO=pausa MIN=$min ROTULO=""
  echo
  printf '  ☕ %spausa%s: %d min — levanta, alonga, água.\n\n' "$VERDE" "$RESET" "$min"
  if contagem $((min * 60)) "$VERDE" "☕ pausa"; then
    registrar pausa "$min" ok ""
    TIPO=""
    notificar "pomo" "Pausa acabou — de volta ao foco."
    printf '\n\n  %s✔ pausa concluída.%s  Próximo:  %spomo%s\n\n' "$VERDE" "$RESET" "$BOLD" "$RESET"
  else
    registrar pausa "$min" abortado ""
    TIPO=""
    printf '\n\n  pausa encerrada antes da hora. Próximo:  %spomo%s\n\n' "$BOLD" "$RESET"
  fi
}

cmd_log() {
  if [ ! -f "$LOG_FILE" ]; then
    echo "nenhuma sessão ainda. Comece com:  pomo"
    return
  fi
  local hoje; hoje=$(date +%Y-%m-%d)
  echo
  awk -F, -v d="$hoje" '
    $1==d && $3=="foco" && $5=="ok" {n++; m+=$4}
    END {printf "  🍅 hoje: %d pomodoro(s) · %d min de foco\n", n, m}' "$LOG_FILE"
  echo
  awk -F, 'NR>1 && $3=="foco" && $5=="ok" {n[$1]++; m[$1]+=$4}
           END {for (d in n) printf "%s %d %d\n", d, n[d], m[d]}' "$LOG_FILE" \
    | sort | tail -14 | while read -r dia qtd mins; do
        barra_n=$qtd
        [ "$barra_n" -gt 25 ] && barra_n=25
        barra=$(printf '%*s' "$barra_n" '' | tr ' ' '█')
        printf '  %s  %s%s%s %d (%d min)\n' "$dia" "$VERMELHO" "$barra" "$RESET" "$qtd" "$mins"
      done
  echo
  echo "  log completo em: $LOG_FILE"
}

# ---------- main ----------
MODO=foco
case "${1:-}" in
  -h|--help) uso; exit 0 ;;
  -l|--log)  cmd_log; exit 0 ;;
  pausa|p)   MODO=pausa; shift ;;
  -*)        die "opção desconhecida '$1' (veja pomo -h)" ;;
esac

MINUTOS=""
if [ "$#" -gt 0 ] && eh_numero "$1"; then
  MINUTOS=$1
  shift
fi

if [ "$MODO" = "pausa" ]; then
  MINUTOS="${MINUTOS:-$PAUSA_PADRAO}"
else
  MINUTOS="${MINUTOS:-$FOCO_PADRAO}"
fi
eh_numero "$MINUTOS" || die "minutos inválidos ('$MINUTOS')"
[ "$MINUTOS" -ge 1 ] && [ "$MINUTOS" -le 600 ] || die "minutos fora da faixa (1–600)"

if [ "$MODO" = "pausa" ]; then
  [ "$#" -eq 0 ] || die "pausa não leva rótulo (veja pomo -h)"
  cmd_pausa "$MINUTOS"
else
  cmd_foco "$MINUTOS" "$@"
fi
