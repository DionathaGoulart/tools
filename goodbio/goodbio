#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
goodbio — sua autobiografia, uma pergunta por dia.

Todo dia ele te faz UMA pergunta sobre sua vida. Você responde no terminal; a
resposta fica salva localmente. Depois de algumas dezenas de respostas,
`goodbio capitulo` costura tudo em capítulos de biografia escritos em texto
corrido.

Privacidade: suas respostas NUNCA saem da máquina no uso diário. Elas só são
enviadas ao modelo em dois momentos, e você escolhe quando: no modo follow-up
(`-f`) e ao gerar capítulos (`goodbio capitulo`).

Requer: Python 3 e a variável de ambiente OPENROUTER_API_KEY (só pra gerar
perguntas novas, follow-up e capítulos — responder o dia a dia é offline).
"""

import argparse
import json
import os
import sys
import textwrap
from datetime import datetime
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
from retro import Retro
from llm import LLM, LLMError


def carregar_dotenv():
    """Carrega KEY=VALOR de um .env ao lado do script. Não sobrescreve o que já
    está exportado no shell (env real tem prioridade)."""
    env_path = Path(__file__).resolve().parent / ".env"
    if not env_path.exists():
        return
    try:
        linhas = env_path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return
    for linha in linhas:
        linha = linha.strip()
        if not linha or linha.startswith("#") or "=" not in linha:
            continue
        chave, _, valor = linha.partition("=")
        os.environ.setdefault(chave.strip(), valor.strip().strip('"').strip("'"))


carregar_dotenv()

ui = Retro(env_prefix="GOODBIO")

BASE_DIR = Path(os.environ.get("GOODBIO_DIR", Path.home() / ".biografo"))
RESP_DIR = BASE_DIR / "respostas"
CAP_DIR = BASE_DIR / "capitulos"
FILA_FILE = BASE_DIR / "fila.json"       # perguntas pendentes
FEITAS_FILE = BASE_DIR / "feitas.json"   # perguntas já usadas (evita repetição)

DEFAULT_MODELS = [
    "nvidia/nemotron-3-ultra-550b-a55b:free",
    "nousresearch/hermes-3-llama-3.1-405b:free",
    "meta-llama/llama-3.3-70b-instruct:free",
    "qwen/qwen3-next-80b-a3b-instruct:free",
]

LOTE = 30  # perguntas geradas por vez

# Sementes de tema pra garantir cobertura ampla quando gera o primeiro lote.
TEMAS = [
    "infância e primeiras memórias", "família e parentes", "escola e adolescência",
    "amizades marcantes", "amores e relacionamentos", "trabalho e carreira",
    "momentos de virada e decisões difíceis", "medos, perdas e superações",
    "valores, crenças e o que te formou", "lugares, viagens e casas onde morou",
    "sonhos, arrependimentos e o que ainda quer fazer", "manias, gostos e pequenas alegrias",
]

SYSTEM_PERGUNTAS = f"""Você gera perguntas para uma pessoa escrever a própria autobiografia, \
uma por dia. As perguntas devem ser evocativas, específicas e abrir memória — do tipo que \
faz a pessoa parar e lembrar de uma cena concreta, não responder com um "sim" ou uma frase seca.

Boas: "Qual foi o primeiro momento em que você se sentiu adulto?", "Que cheiro te leva \
direto pra casa da sua infância?".
Ruins (evite): "Como foi sua infância?" (vago demais), "Você é feliz?" (fechada).

Cubra temas variados ao longo do lote: {", ".join(TEMAS)}.
Responda SEMPRE em português do Brasil. Devolva SOMENTE um array JSON de strings, \
sem numeração, sem comentário, sem markdown. Exemplo: ["pergunta 1", "pergunta 2"]"""

SYSTEM_FOLLOWUP = """Você entrevista uma pessoa para a autobiografia dela. Recebe as \
últimas respostas que ela escreveu. Faça UMA única pergunta de follow-up que aprofunde \
algo concreto que ela mencionou — puxe um detalhe, uma emoção ou uma consequência que \
ficou de fora. Português do Brasil. Devolva SÓ a pergunta, uma linha, sem aspas."""

SYSTEM_CAPITULO = """Você é um ghost-writer escrevendo a autobiografia de alguém a partir \
das respostas que a pessoa deu a perguntas sobre a vida dela. Escreva em PRIMEIRA PESSOA, \
na voz dela, em português do Brasil.

- Agrupe o material por fases/temas e escreva em capítulos com título (use ## para cada um).
- Texto corrido, tom de memória — costure as respostas numa narrativa fluida, não as \
liste nem invente fatos que não estão nas respostas.
- Pode reordenar cronologicamente e conectar ideias, mas seja fiel ao que a pessoa contou.
- Comece direto no primeiro capítulo, sem introdução meta ("aqui está sua biografia")."""


# ---------------------------------------------------------------- openrouter

_llm = LLM("goodbio", DEFAULT_MODELS)


def chamar_llm(messages, max_tokens=2000, temperature=0.8):
    try:
        return _llm.chat(messages, max_tokens=max_tokens, temperature=temperature)
    except LLMError as e:
        if e.kind == "no_key":
            die(
                "OPENROUTER_API_KEY nao definida (necessaria pra gerar perguntas, follow-up e capitulos).",
                [
                    "crie uma chave gratis em https://openrouter.ai/keys",
                    'exporte no seu rc:  export OPENROUTER_API_KEY="sk-or-..."',
                ],
            )
        if e.kind == "auth":
            die("OPENROUTER_API_KEY inválida (HTTP 401).")
        die("todos os modelos falharam.",
            e.errors + ["`goodbio -m` lista os modelos :free no ar",
                        "defina OPENROUTER_MODEL pra trocar"])


def listar_modelos_free():
    try:
        livres = _llm.free_models()
    except LLMError as e:
        die(e.message)
    ui.modulo("free_models", "src: openrouter")
    if not livres:
        ui.aviso("vazio", "nenhum modelo :free no ar agora.")
        print()
        return
    ui.kv("DISPONIVEIS", f"{len(livres)} MODELO(S)")
    print()
    ui.secao("catalogo")
    for m in livres:
        ui.item("►", m)
    print()
    ui.proximo('export OPENROUTER_MODEL="modelo1,modelo2"', "pra usar outros:")
    print()


# ---------------------------------------------------------------- util

def die(msg, dicas=()):
    print(f"\n  {ui.ALERTA}[ ERRO ]{ui.RESET} {msg}", file=sys.stderr)
    for dica in dicas:
        print(f"  {ui.ACC30}>{ui.RESET} {dica}", file=sys.stderr)
    print(file=sys.stderr)
    sys.exit(1)


def envolver(texto, largura=None):
    """Quebra prosa na largura util da janela."""
    return textwrap.wrap(texto, width=largura or max(20, ui.cf)) or [""]


def carregar_json(caminho, padrao):
    if caminho.exists():
        try:
            return json.loads(caminho.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            pass
    return padrao


def salvar_json(caminho, obj):
    caminho.parent.mkdir(parents=True, exist_ok=True)
    caminho.write_text(json.dumps(obj, ensure_ascii=False, indent=2), encoding="utf-8")


def ler_multilinha():
    """Lê várias linhas. Termina com linha só '.' ou Ctrl-D."""
    linhas = []
    try:
        while True:
            linhas.append(input())
            if linhas[-1].strip() == ".":
                linhas.pop()
                break
    except EOFError:
        pass
    return "\n".join(linhas).strip()


def parse_array_json(texto):
    """Extrai array JSON de strings de uma resposta de LLM (tolera cerca de markdown)."""
    ini, fim = texto.find("["), texto.rfind("]")
    if ini != -1 and fim > ini:
        try:
            arr = json.loads(texto[ini:fim + 1])
            return [str(x).strip() for x in arr if str(x).strip()]
        except json.JSONDecodeError:
            pass
    # fallback: uma pergunta por linha
    linhas = [l.strip(" -0123456789.\t\"") for l in texto.splitlines()]
    return [l for l in linhas if l.endswith("?")]


def respostas_existentes():
    """[(data, pergunta, resposta)] ordenado por data."""
    out = []
    if RESP_DIR.is_dir():
        for f in sorted(RESP_DIR.glob("*.md")):
            texto = f.read_text(encoding="utf-8")
            pergunta = resposta = ""
            if texto.startswith("# "):
                pergunta = texto.splitlines()[0][2:].strip()
                resposta = texto.split("\n", 2)[2].strip() if texto.count("\n") >= 2 else ""
            out.append((f.stem, pergunta, resposta))
    return out


# ---------------------------------------------------------------- banco de perguntas

def gerar_lote(evitar):
    prompt = f"Gere {LOTE} perguntas novas."
    if evitar:
        amostra = evitar[-40:]
        prompt += " NÃO repita nem reformule estas já usadas:\n- " + "\n- ".join(amostra)
    texto, model = chamar_llm(
        [{"role": "system", "content": SYSTEM_PERGUNTAS},
         {"role": "user", "content": prompt}],
        max_tokens=2000, temperature=0.9,
    )
    perguntas = parse_array_json(texto)
    if not perguntas:
        die(f"o modelo {model} não devolveu perguntas parseáveis. Tente de novo.")
    return perguntas


def proxima_pergunta():
    """Tira a próxima pergunta da fila; reabastece via LLM se acabar."""
    fila = carregar_json(FILA_FILE, [])
    feitas = carregar_json(FEITAS_FILE, [])
    if not fila:
        ui.aviso("fila vazia", "gerando perguntas novas (1 request)…")
        novas = gerar_lote(feitas)
        vistas = set(feitas)
        fila = [p for p in novas if p not in vistas] or novas
        salvar_json(FILA_FILE, fila)
    return fila[0]


def consumir_pergunta(pergunta):
    fila = carregar_json(FILA_FILE, [])
    if pergunta in fila:
        fila.remove(pergunta)
        salvar_json(FILA_FILE, fila)
    feitas = carregar_json(FEITAS_FILE, [])
    if pergunta not in feitas:
        feitas.append(pergunta)
        salvar_json(FEITAS_FILE, feitas)


# ---------------------------------------------------------------- comandos

def cmd_diario(followup=False, extra=False):
    hoje = f"{datetime.now():%Y-%m-%d}"
    arquivo_hoje = RESP_DIR / f"{hoje}.md"
    eh_extra = False
    if arquivo_hoje.exists():
        if not extra:
            ui.modulo("daily_question", f"date: {hoje}")
            ui.aviso("respondido", f"voce ja respondeu hoje ({hoje}).")
            print()
            ui.proximo("goodbio -x", "responder outra:")
            ui.proximo("goodbio -l", "ver o historico:")
            print()
            return
        eh_extra = True
        arquivo_hoje = RESP_DIR / f"{hoje}-{datetime.now():%H%M}.md"

    ui.modulo("daily_question", f"date: {hoje}")

    if followup:
        respostas = respostas_existentes()
        if not respostas:
            ui.aviso("sem historico", "nenhuma resposta anterior — usando pergunta normal.")
            followup = False
        else:
            ui.aviso("follow-up", "lendo suas ultimas respostas (envia dados ao modelo)…")
            ultimas = respostas[-4:]
            ctx = "\n\n".join(f"P: {p}\nR: {r}" for _, p, r in ultimas)
            pergunta, _ = chamar_llm(
                [{"role": "system", "content": SYSTEM_FOLLOWUP},
                 {"role": "user", "content": ctx}],
                max_tokens=200, temperature=0.8,
            )
            pergunta = pergunta.strip().strip('"').splitlines()[0]

    if not followup:
        pergunta = proxima_pergunta()

    ui.janela(
        "root@goodbio: ~/memoir",
        envolver(pergunta),
        meta=("EXTRA" if eh_extra else "FOLLOW-UP" if followup else "DO DIA"),
        rodape='[.] OU [CTRL-D] ENCERRA',
    )
    print()
    ui.item(">", "responde abaixo com tuas palavras. linha vazia pula.")
    print()
    resposta = ler_multilinha()
    if not resposta:
        print()
        if eh_extra:
            ui.aviso("vazio", "nada salvo.")
        else:
            ui.aviso("pulado", "a mesma pergunta volta amanha.")
        print()
        return

    RESP_DIR.mkdir(parents=True, exist_ok=True)
    arquivo_hoje.write_text(f"# {pergunta}\n\n{resposta}\n", encoding="utf-8")
    if not followup:
        consumir_pergunta(pergunta)
    total = len(respostas_existentes())
    print()
    ui.ok("resposta salva")
    ui.kv("ARQUIVO", str(arquivo_hoje))
    ui.kv("TOTAL", f"{total} RESPOSTA(S)")
    print()
    ui.secao("proximo capitulo")
    feito = total % LOTE or LOTE
    print(f"  {ui.barra(feito, LOTE)}  {ui.FG40}{feito}/{LOTE}{ui.RESET}")
    print()
    if total and total % LOTE == 0:
        ui.proximo("goodbio capitulo", "ja da pra montar capitulos:")
    else:
        ui.proximo("goodbio", "volte amanha:")
    print()


def cmd_capitulo():
    respostas = respostas_existentes()
    respostas = [(d, p, r) for d, p, r in respostas if r]
    if len(respostas) < 5:
        die(f"so {len(respostas)} resposta(s) — responda pelo menos 5 dias antes de gerar capitulos.")
    ui.modulo("chapter_writer", "src: openrouter")
    ui.kv("RESPOSTAS", f"{len(respostas)}")
    print()
    ui.aviso("privacidade", "isto envia suas respostas ao modelo. ctrl-c pra cancelar.")
    material = "\n\n".join(f"Pergunta: {p}\nResposta: {r}" for _, p, r in respostas)
    if len(material) > 24000:
        material = material[:24000]
        ui.aviso("truncado", "muitas respostas — usando as primeiras; gere de novo depois.")
    ui.aviso("escrevendo", "aguarde…")
    texto, model = chamar_llm(
        [{"role": "system", "content": SYSTEM_CAPITULO},
         {"role": "user", "content": material}],
        max_tokens=4000, temperature=0.7,
    )
    CAP_DIR.mkdir(parents=True, exist_ok=True)
    destino = CAP_DIR / f"biografia-{datetime.now():%Y-%m-%d}.md"
    destino.write_text(f"<!-- gerado por goodbio · modelo {model} -->\n\n{texto}\n", encoding="utf-8")
    print()
    ui.ok("biografia salva")
    ui.kv("ARQUIVO", str(destino))
    ui.kv("MODELO", model)
    print()


def cmd_listar():
    respostas = respostas_existentes()
    ui.modulo("archive", "src: respostas/")
    if not respostas:
        ui.aviso("vazio", "nenhuma resposta ainda.")
        print()
        ui.proximo("goodbio")
        print()
        return
    fila = carregar_json(FILA_FILE, [])
    ui.kv("RESPOSTAS", f"{len(respostas)}")
    ui.kv("FILA", f"{len(fila)} PERGUNTA(S)")
    ui.kv("DIR", str(BASE_DIR))
    print()
    ui.secao("historico")
    largura_p = max(24, ui.cols - 22)
    for data, pergunta, _ in respostas:
        if len(pergunta) > largura_p:
            pergunta = pergunta[:largura_p - 1] + "…"
        ui.item("►", pergunta, data)
    print()


def cmd_perguntas():
    """Reabastece o banco de perguntas manualmente (1 request)."""
    feitas = carregar_json(FEITAS_FILE, [])
    novas = gerar_lote(feitas)
    fila = carregar_json(FILA_FILE, [])
    vistas = set(fila) | set(feitas)
    add = [p for p in novas if p not in vistas]
    fila += add
    salvar_json(FILA_FILE, fila)
    ui.modulo("question_bank", "src: openrouter")
    if add:
        ui.ok(f"{len(add)} pergunta(s) nova(s)")
    else:
        ui.aviso("vazio", "nenhuma pergunta inedita neste lote.")
    ui.kv("FILA", f"{len(fila)} PERGUNTA(S)")
    print()


def cmd_temas():
    ui.catalogo_temas()


# ---------------------------------------------------------------- main

def uso():
    ui.modulo("goodbio_help")
    ui.kv("goodbio", "PERGUNTA DO DIA")
    ui.kv("goodbio -f", "FOLLOW-UP DAS ULTIMAS RESPOSTAS")
    ui.kv("goodbio -x", "PERGUNTA EXTRA NO MESMO DIA")
    ui.kv("goodbio -l", "RESPOSTAS E STATUS")
    ui.kv("goodbio -m", "MODELOS :FREE NO AR")
    ui.kv("goodbio capitulo", "GERA A BIOGRAFIA")
    ui.kv("goodbio perguntas", "REABASTECE A FILA")
    ui.kv("goodbio temas", "PALETAS")
    print()
    ui.secao("env")
    ui.kv("OPENROUTER_API_KEY", "OBRIGATORIA (LLM)")
    ui.kv("OPENROUTER_MODEL", "IDS SEPARADOS POR VIRGULA")
    ui.kv("GOODBIO_DIR", str(BASE_DIR))
    ui.kv("GOODBIO_TEMA / RETRO_TEMA", ui.tema.upper())
    ui.kv("NO_COLOR", "DESLIGA AS CORES")
    print()


def main():
    ap = argparse.ArgumentParser(
        prog="goodbio",
        description="Sua autobiografia, uma pergunta por dia.",
        epilog="exemplos:  goodbio   ·   goodbio -f   ·   goodbio capitulo   ·   goodbio temas",
        add_help=False,
    )
    ap.add_argument("comando", nargs="?", default="dia",
                    choices=["dia", "capitulo", "perguntas", "temas"],
                    help="dia (padrão): pergunta do dia · capitulo: gera biografia · "
                         "perguntas: reabastece a fila · temas: lista as paletas")
    ap.add_argument("-f", "--followup", action="store_true",
                    help="pergunta personalizada baseada nas últimas respostas (envia dados ao modelo)")
    ap.add_argument("-x", "--extra", action="store_true",
                    help="responder outra pergunta mesmo já tendo respondido hoje (combina com -f)")
    ap.add_argument("-l", "--listar", action="store_true", help="lista respostas e status")
    ap.add_argument("-m", "--modelos", action="store_true", help="lista modelos :free disponíveis")
    ap.add_argument("-h", "--help", action="store_true", help="mostra esta ajuda")
    args = ap.parse_args()

    if args.help:
        uso()
    elif args.modelos:
        listar_modelos_free()
    elif args.listar:
        cmd_listar()
    elif args.comando == "temas":
        cmd_temas()
    elif args.comando == "capitulo":
        cmd_capitulo()
    elif args.comando == "perguntas":
        cmd_perguntas()
    else:
        cmd_diario(followup=args.followup, extra=args.extra)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print()
        ui.aviso("interrompido")
        sys.exit(130)
